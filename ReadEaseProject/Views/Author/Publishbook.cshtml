@model ReadEase.ViewModels.Author.PublishBookViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Book" : "Publish New Book";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var formAction = isEdit ? "Edit" : "Create";
    var freeOptClass = (Model.IsFree || !isEdit) ? "sel" : "";
    var premiumOptClass = (!Model.IsFree && isEdit) ? "sel" : "";
    var isFreeBool = Model.IsFree || !isEdit;
    var isPremiumBool = !Model.IsFree && isEdit;
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .pb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.75rem;
        gap: 1rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
    }

    .pb-title {
        font-family: 'Nunito',sans-serif;
        font-size: 1.75rem;
        font-weight: 900;
        color: #1a1a2e;
        margin: 0;
    }

    .pb-sub {
        font-size: .875rem;
        color: #6b6878;
        font-weight: 600;
        margin-top: .2rem;
    }

    .re-btn-back {
        background: #f5f3ff;
        border: 1.5px solid #ddd6fe;
        border-radius: 10px;
        color: #6d28d9;
        font-weight: 800;
        font-size: .82rem;
        padding: .45rem 1rem;
        text-decoration: none;
        transition: background .18s;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .re-btn-back:hover {
            background: #ede9fe;
            color: #5b21b6;
        }

    .re-panel {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        margin-bottom: 1.25rem;
        position: relative;
        z-index: 2;
    }

    .re-panel-header {
        padding: .85rem 1.3rem;
        border-bottom: 1px solid #f0eeea;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .88rem;
        color: #1a1a2e;
        background: #fafaf8;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .re-panel-body {
        padding: 1.3rem;
    }

    .re-label {
        font-size: .73rem;
        font-weight: 800;
        color: #4a4660;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .35rem;
        display: block;
    }

    .re-input {
        border: 1.5px solid #e8e3dc;
        border-radius: 10px;
        padding: .6rem 1rem;
        font-size: .875rem;
        width: 100%;
        transition: border-color .18s;
        font-family: 'Nunito',sans-serif;
    }

        .re-input:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.12);
            outline: none;
        }

    .re-textarea {
        border: 1.5px solid #e8e3dc;
        border-radius: 10px;
        padding: .6rem 1rem;
        font-size: .875rem;
        width: 100%;
        transition: border-color .18s;
        font-family: 'Nunito',sans-serif;
        resize: vertical;
        min-height: 120px;
    }

        .re-textarea:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.12);
            outline: none;
        }

    .re-hint {
        font-size: .72rem;
        color: #9994a8;
        font-weight: 600;
        margin-top: .3rem;
    }

    .cover-area {
        border: 2px dashed #e0dbd3;
        border-radius: 14px;
        padding: 1.75rem;
        text-align: center;
        transition: border-color .2s,background .2s;
        cursor: pointer;
    }

        .cover-area:hover {
            border-color: #f26522;
            background: #fff9f6;
        }

    .cover-area-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: .5rem;
    }

    .cover-area-label {
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .88rem;
        color: #1a1a2e;
    }

    .cover-area-hint {
        font-size: .72rem;
        color: #9994a8;
        font-weight: 600;
        margin-top: .25rem;
    }

    #coverPreview {
        max-width: 100%;
        max-height: 220px;
        border-radius: 10px;
        object-fit: cover;
        display: none;
        margin: 0 auto;
    }

    .type-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
    }

    .type-opt {
        border: 2px solid #e8e3dc;
        border-radius: 14px;
        padding: 1rem 1.15rem;
        cursor: pointer;
        transition: all .18s;
        position: relative;
    }

        .type-opt:hover, .type-opt.sel {
            border-color: #f26522;
            background: #fff9f6;
        }

        .type-opt.sel {
            box-shadow: 0 0 0 3px rgba(242,101,34,.15);
        }

        .type-opt input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .type-opt-icon {
        font-size: 1.5rem;
        display: block;
        margin-bottom: .4rem;
    }

    .type-opt-label {
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .9rem;
        color: #1a1a2e;
    }

    .type-opt-desc {
        font-size: .72rem;
        color: #9994a8;
        font-weight: 600;
    }

    .re-btn-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        width: 100%;
        padding: .78rem;
        border-radius: 10px;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .95rem;
        background: #f26522;
        color: #fff;
        border: none;
        cursor: pointer;
        transition: all .18s;
        box-shadow: 0 4px 18px rgba(242,101,34,.3);
    }

        .re-btn-primary:hover {
            background: #d9541a;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 26px rgba(242,101,34,.42);
        }

    /* ── PDF Drop Zone ── */
    .pdf-drop-zone {
        border: 2px dashed #e0dbd3;
        border-radius: 12px;
        padding: 1.25rem;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        margin-bottom: .75rem;
        background: #fafaf8;
    }

        .pdf-drop-zone:hover,
        .pdf-drop-zone.drag-over {
            border-color: #f26522;
            background: #fff9f6;
        }

        .pdf-drop-zone.drag-over {
            box-shadow: 0 0 0 3px rgba(242,101,34,.15);
        }

    .pdf-drop-icon {
        font-size: 2rem;
        display: block;
        margin-bottom: .4rem;
    }

    .pdf-drop-label {
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .88rem;
        color: #1a1a2e;
    }

    .pdf-drop-hint {
        font-size: .72rem;
        color: #9994a8;
        font-weight: 600;
        margin-top: .2rem;
    }

    .pdf-status {
        display: none;
        align-items: center;
        gap: .6rem;
        border-radius: 10px;
        padding: .6rem 1rem;
        font-size: .82rem;
        font-weight: 700;
        font-family: 'Nunito',sans-serif;
        margin-bottom: .75rem;
    }

        .pdf-status.success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #15803d;
        }

        .pdf-status.error {
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: #991b1b;
        }

        .pdf-status.loading {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #c2410c;
        }

    .pdf-spin {
        width: 16px;
        height: 16px;
        border: 2px solid rgba(194,65,12,.2);
        border-top-color: #f26522;
        border-radius: 50%;
        animation: pdfSpin .6s linear infinite;
        flex-shrink: 0;
    }

    @@keyframes pdfSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* ── Genre Chips ── */
    .genre-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 0.5rem;
        max-height: 200px;
        overflow-y: auto;
        padding: 0.5rem;
        border: 1.5px solid #e8e3dc;
        border-radius: 10px;
        background: #fafaf8;
    }

    .genre-chip {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.6rem;
        background: #fff;
        border: 1.5px solid #e8e3dc;
        border-radius: 8px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 700;
        color: #4a4660;
        transition: all 0.18s;
        user-select: none;
    }

        .genre-chip:hover {
            border-color: #f26522;
            background: #fff9f6;
        }

        .genre-chip input[type="checkbox"] {
            width: 14px;
            height: 14px;
            accent-color: #f26522;
            cursor: pointer;
        }

        .genre-chip.selected {
            background: #f26522;
            border-color: #f26522;
            color: #fff;
        }

            .genre-chip.selected input[type="checkbox"] {
                accent-color: #fff;
            }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="pb-header fade-up">
    <div>
        <div class="pb-title" style="display:flex;align-items:center;gap:.55rem;">
            @if (isEdit)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit Book</span>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                <span>Publish New Book</span>
            }
        </div>
        <div class="pb-sub">@(isEdit ? "Update your book details below" : "Share your story with the world")</div>
    </div>
    <a asp-controller="Author" asp-action="MyBooks" class="re-btn-back">← My Books</a>
</div>

<form asp-controller="Author" asp-action="@formAction" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" name="Id" value="@Model.Id" />
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="re-panel fade-up">
                <div class="re-panel-header" style="display:flex;align-items:center;gap:.45rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    Book Details
                </div>
                <div class="re-panel-body">
                    <div class="mb-3">
                        <label class="re-label">Book Title *</label>
                        <input type="text" name="Title" value="@Model.Title" class="re-input" required maxlength="200" placeholder="Enter your book title…" />
                    </div>
                    <div class="mb-3">
                        <label class="re-label">Description</label>
                        <textarea name="Description" class="re-textarea" maxlength="2000" placeholder="Tell readers what your book is about…">@Model.Description</textarea>
                        <div class="re-hint">Max 2000 characters</div>
                    </div>
                    <div class="mb-3">
                        <label class="re-label">Genres <span class="text-danger">*</span> <span style="font-weight:normal;font-size:.7rem;color:#999;">(Select multiple)</span></label>
                        <input type="hidden" asp-for="Category" id="selectedGenres" />
                        <div class="genre-grid">
                            @{
                                var allGenres = new[] { "Action", "Adventure", "Anime", "Arts", "Comedy", "Drama", "Eastern", "Ecchi", "Fan-Fiction", "Fantasy", "Game", "Gender-Bender", "Harem", "Historical", "Horror", "Isekai", "Josei", "Lgbt+", "Magic", "Magical-Realism", "Manhua", "Martial-Arts", "Mature", "Mecha", "Military", "Modern-Life", "Movies", "Mystery", "Psychological", "Realistic-Fiction", "Reincarnation", "Romance", "School-Life", "Sci-Fi", "Seinen", "Shoujo", "Shoujo-Ai", "Shounen", "Shounen-Ai", "Slice-Of-Life", "Smut", "Sports", "Supernatural", "System", "Tragedy", "Urban", "Urban-Life", "Video-Games", "War", "Wuxia", "Xianxia", "Xuanhuan", "Yaoi", "Yuri" };
                                var selectedGenres = Model.Category?.Split(',').Select(g => g.Trim()).ToList() ?? new List<string>();
                            }
                            @foreach (var genre in allGenres)
                            {
                                <label class="genre-chip" data-genre="@genre">
                                    <input type="checkbox" value="@genre" @(selectedGenres.Contains(genre) ? "checked" : "") onchange="updateGenres()" />
                                    <span>@genre</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="re-panel fade-up">
                <div class="re-panel-header" style="display:flex;align-items:center;gap:.45rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    Cover Image
                </div>
                <div class="re-panel-body">
                    <label class="cover-area" for="coverInput">
                        <span class="cover-area-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#d1ccc5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </span>
                        <div class="cover-area-label">Click to upload cover</div>
                        <div class="cover-area-hint">JPG, PNG, WEBP · Max 3MB</div>
                        <input type="file" id="coverInput" name="CoverImageFile" accept=".jpg,.jpeg,.png,.webp" style="display:none;" onchange="previewCover(this)" />
                    </label>
                    @if (!string.IsNullOrEmpty(Model.ExistingCoverImage))
                    {
                        <img src="@Model.ExistingCoverImage" id="coverPreview" style="display:block;margin-top:1rem;max-width:100%;border-radius:10px;" />
                    }
                    else
                    {
                        <img id="coverPreview" />
                    }
                </div>
            </div>

            <div class="re-panel fade-up">
                <div class="re-panel-header" style="display:flex;align-items:center;gap:.45rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Access Type
                </div>
                <div class="re-panel-body">
                    <div class="type-grid">
                        <label class="type-opt @freeOptClass" id="optFree">
                            <input type="radio" name="IsFree" value="true" @Html.Raw(isFreeBool ? "checked" : "") />
                            <span class="type-opt-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a4660" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            </span>
                            <div class="type-opt-label">Free</div>
                            <div class="type-opt-desc">Everyone can read</div>
                        </label>
                        <label class="type-opt @premiumOptClass" id="optPremium">
                            <input type="radio" name="IsFree" value="false" @Html.Raw(isPremiumBool ? "checked" : "") />
                            <span class="type-opt-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            </span>
                            <div class="type-opt-label">Premium</div>
                            <div class="type-opt-desc">Subscribers only</div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="fade-up">
                <button type="submit" class="re-btn-primary" style="display:flex;align-items:center;justify-content:center;gap:.45rem;">
                    @if (isEdit)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        <span>Save Changes</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                        <span>Publish Book</span>
                    }
                </button>
            </div>
        </div>
    </div>
</form>

<script>
    // ── Cover preview ──────────────────────────────────────────────────
    function previewCover(input) {
        const file = input.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = e => {
            const img = document.getElementById('coverPreview');
            img.src = e.target.result;
            img.style.display = 'block';
            img.style.marginTop = '1rem';
        };
        reader.readAsDataURL(file);
    }

    // ── Access type toggle ─────────────────────────────────────────────
    document.querySelectorAll('.type-opt').forEach(opt => {
        opt.addEventListener('click', function () {
            document.querySelectorAll('.type-opt').forEach(o => o.classList.remove('sel'));
            this.classList.add('sel');
        });
    });

    // ── Genre selection ────────────────────────────────────────────────
    function updateGenres() {
        const checkboxes = document.querySelectorAll('.genre-chip input[type="checkbox"]:checked');
        const selected = Array.from(checkboxes).map(cb => cb.value);
        document.getElementById('selectedGenres').value = selected.join(',');

        // Update visual styling
        document.querySelectorAll('.genre-chip').forEach(chip => {
            const cb = chip.querySelector('input[type="checkbox"]');
            if (cb.checked) {
                chip.classList.add('selected');
            } else {
                chip.classList.remove('selected');
            }
        });
    }

    // Initialize on load
    document.addEventListener('DOMContentLoaded', function() {
        updateGenres();

        // Allow clicking the whole chip to toggle checkbox
        document.querySelectorAll('.genre-chip').forEach(chip => {
            chip.addEventListener('click', function(e) {
                if (e.target.tagName !== 'INPUT') {
                    const cb = this.querySelector('input[type="checkbox"]');
                    cb.checked = !cb.checked;
                    updateGenres();
                }
            });
        });
    });
</script>
