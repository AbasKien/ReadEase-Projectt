@using ReadEase.ViewModels.Author
@{
    var isEdit = Model is EditChapterViewModel;
    var editVm = isEdit ? (EditChapterViewModel)Model : null;
    var addVm = isEdit ? null : (PublishChapterViewModel)Model;

    var bookId = isEdit ? editVm!.BookId : addVm!.BookId;
    var bookTitle = isEdit ? editVm!.BookTitle : addVm!.BookTitle;
    var chapterNum = isEdit ? editVm!.ChapterNumber : addVm!.ChapterNumber;

    ViewData["Title"] = isEdit ? $"Edit Chapter {chapterNum}" : $"Add Chapter {chapterNum}";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Min datetime for the picker — 5 minutes from now (ISO format for input[type=datetime-local])
    var minDt = DateTime.Now.AddMinutes(5).ToString("yyyy-MM-ddTHH:mm");
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .pb-page {
        position: relative;
        z-index: 2;
        max-width: 820px;
        margin: 2rem auto;
        padding: 0 1.25rem 3rem;
    }

    .pb-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.75rem;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .pb-title {
        font-family: 'Nunito',sans-serif;
        font-size: 1.75rem;
        font-weight: 900;
        color: #1a1a2e;
        margin: 0;
    }

    .pb-sub {
        font-size: .85rem;
        color: #6b7280;
        font-family: 'Nunito',sans-serif;
        margin-top: .2rem;
    }

    .pb-card {
        background: #fff;
        border: 1px solid #ede8e0;
        border-radius: 20px;
        padding: 2rem;
        box-shadow: 0 2px 20px rgba(0,0,0,.06);
    }

    .form-group {
        margin-bottom: 1.4rem;
    }

    .form-label {
        display: block;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .82rem;
        color: #1a1a2e;
        margin-bottom: .45rem;
    }

    .form-control {
        width: 100%;
        padding: .65rem .9rem;
        border: 1.5px solid #e2ddd8;
        border-radius: 10px;
        font-family: 'Nunito',sans-serif;
        font-size: .9rem;
        color: #1a1a2e;
        background: #faf7f3;
        transition: border-color .18s,box-shadow .18s;
        outline: none;
    }

        .form-control:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.1);
            background: #fff;
        }

    textarea.form-control {
        min-height: 420px;
        resize: vertical;
        line-height: 1.7;
    }

    .ch-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: rgba(242,101,34,.1);
        color: #f26522;
        font-family: 'Nunito',sans-serif;
        font-weight: 900;
        font-size: .8rem;
        padding: .3rem .8rem;
        border-radius: 20px;
        margin-bottom: 1.1rem;
    }

    .btn-orange {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #f26522;
        color: #fff;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .9rem;
        padding: .65rem 1.75rem;
        border-radius: 50px;
        border: none;
        cursor: pointer;
        box-shadow: 0 3px 14px rgba(242,101,34,.35);
        transition: all .18s;
    }

        .btn-orange:hover {
            background: #d9541a;
            transform: translateY(-1px);
        }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        color: #1a1a2e;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .85rem;
        padding: .6rem 1.35rem;
        border-radius: 50px;
        text-decoration: none;
        border: 1.5px solid #e2ddd8;
        transition: all .18s;
    }

        .btn-ghost:hover {
            border-color: #f26522;
            color: #f26522;
        }

    /* ── Schedule Picker ── */
    .sched-toggle-row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: .85rem;
    }

    .sched-radio-label {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-family: 'Nunito',sans-serif;
        font-weight: 700;
        font-size: .88rem;
        color: #1a1a2e;
        padding: .55rem 1.1rem;
        border: 1.5px solid #e2ddd8;
        border-radius: 10px;
        cursor: pointer;
        transition: all .18s;
        user-select: none;
    }

        .sched-radio-label:hover {
            border-color: #f26522;
            color: #f26522;
        }

        .sched-radio-label input[type="radio"] {
            display: none;
        }

        .sched-radio-label.active {
            border-color: #f26522;
            background: #fff9f6;
            color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.12);
        }

    .sched-picker-wrap {
        display: none;
        margin-top: .5rem;
    }

        .sched-picker-wrap.show {
            display: block;
        }

    .sched-hint-box {
        display: flex;
        align-items: flex-start;
        gap: .55rem;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 12px;
        padding: .75rem 1rem;
        margin-top: 1.25rem;
        font-family: 'Nunito',sans-serif;
        font-size: .8rem;
        font-weight: 700;
        color: #c2410c;
        line-height: 1.5;
    }

    .field-error {
        color: #ef4444;
        font-size: .78rem;
        font-weight: 700;
        font-family: 'Nunito',sans-serif;
        margin-top: .3rem;
    }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

<div class="pb-page">
    <div class="pb-header">
        <div>
            <h1 class="pb-title">@(isEdit ? "Edit Chapter" : "New Chapter")</h1>
            <div class="pb-sub">@bookTitle</div>
        </div>
        <a asp-controller="Author" asp-action="Chapters"
           asp-route-bookId="@bookId" class="btn-ghost">← Back to Chapters</a>
    </div>

    <div class="pb-card">
        <div class="ch-badge" style="display:inline-flex;align-items:center;gap:.4rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            Chapter @chapterNum
        </div>

        @if (isEdit)
        {
            @* ── Edit form (no scheduling for existing chapters) ── *@
            <form asp-controller="Author" asp-action="EditChapter" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@editVm!.Id" />
                <input type="hidden" name="BookId" value="@bookId" />
                <input type="hidden" name="ChapterNumber" value="@chapterNum" />

                <div class="form-group">
                    <label class="form-label">Chapter Title</label>
                    <input type="text" name="Title" class="form-control"
                           value="@editVm!.Title" placeholder="e.g. The Beginning" required />
                    @Html.ValidationMessage("Title", "", new { @class = "field-error" })
                </div>
                <div class="form-group">
                    <label class="form-label">Content</label>
                    <textarea name="Content" class="form-control"
                          placeholder="Write your chapter here…" required>@editVm!.Content</textarea>
                    @Html.ValidationMessage("Content", "", new { @class = "field-error" })
                </div>
                <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem;">
                    <button type="submit" class="btn-orange" style="display:inline-flex;align-items:center;gap:.4rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        Save Changes
                    </button>
                    <a asp-controller="Author" asp-action="Chapters"
                       asp-route-bookId="@bookId" class="btn-ghost">Cancel</a>
                </div>
            </form>
        }
        else
        {
            @* ── Add form with schedule picker ── *@
            <form asp-controller="Author" asp-action="AddChapter" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BookId" value="@bookId" />
                <input type="hidden" name="BookTitle" value="@bookTitle" />
                <input type="hidden" name="ChapterNumber" value="@chapterNum" />

                <div class="form-group">
                    <label class="form-label">Chapter Title</label>
                    <input type="text" name="Title" class="form-control"
                           placeholder="e.g. The Beginning" required />
                    @Html.ValidationMessage("Title", "", new { @class = "field-error" })
                </div>
                <div class="form-group">
                    <label class="form-label">Content</label>
                    <textarea name="Content" class="form-control"
                          placeholder="Write your chapter here…" required></textarea>
                    @Html.ValidationMessage("Content", "", new { @class = "field-error" })
                </div>

                @* ── Release Schedule ── *@
                <div class="form-group">
                    <label class="form-label" style="display:inline-flex;align-items:center;gap:.4rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Release Schedule
                    </label>
                    <div class="sched-toggle-row">
                        <label class="sched-radio-label active" id="lblNow" onclick="setMode('now')">
                            <input type="radio" name="_schedMode" value="now" checked />
                            Publish Now
                        </label>
                        <label class="sched-radio-label" id="lblLater" onclick="setMode('later')">
                            <input type="radio" name="_schedMode" value="later" />
                            Schedule for Later
                        </label>
                    </div>

                    <div class="sched-picker-wrap" id="schedPickerWrap">
                        <label class="form-label" style="margin-bottom:.35rem;">Release date &amp; time</label>
                        <input type="datetime-local" name="ScheduledAt" id="schedPicker"
                               class="form-control" style="max-width:300px;"
                               min="@minDt" />
                        <div style="font-size:.74rem;color:#9ca3af;font-weight:600;margin-top:.35rem;">
                            Uses your device's local timezone
                        </div>
                    </div>
                </div>

                @* ── Tier info hint ── *@
                <div class="sched-hint-box">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    <div>
                        <strong>Premium++</strong> readers — notified instantly, can read right away.<br />
                        <strong>Premium</strong> readers — notified, but chapter unlocks after 24 hrs.<br />
                        <strong>Free</strong> readers — no notification, chapter unlocks after 24 hrs.
                    </div>
                </div>

                <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.5rem;">
                    <button type="submit" class="btn-orange" id="submitBtn" style="display:inline-flex;align-items:center;gap:.4rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Publish &amp; Notify Fans
                    </button>
                    <a asp-controller="Author" asp-action="Chapters"
                       asp-route-bookId="@bookId" class="btn-ghost">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ── Auto-grow textarea ────────────────────────────────────────────────
        document.querySelectorAll('textarea.form-control').forEach(ta => {
            ta.addEventListener('input', () => {
                ta.style.height = 'auto';
                ta.style.height = (ta.scrollHeight + 4) + 'px';
            });
        });

        // ── Schedule mode toggle ──────────────────────────────────────────────
        function setMode(mode) {
            const wrap      = document.getElementById('schedPickerWrap');
            const picker    = document.getElementById('schedPicker');
            const submitBtn = document.getElementById('submitBtn');
            const lblNow    = document.getElementById('lblNow');
            const lblLater  = document.getElementById('lblLater');

            if (mode === 'later') {
                wrap.classList.add('show');
                picker.required      = true;
                submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Schedule Chapter';
                lblLater.classList.add('active');
                lblNow.classList.remove('active');
            } else {
                wrap.classList.remove('show');
                picker.required      = false;
                picker.value         = '';
                submitBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Publish &amp; Notify Fans';
                lblNow.classList.add('active');
                lblLater.classList.remove('active');
            }
        }
    </script>
}
