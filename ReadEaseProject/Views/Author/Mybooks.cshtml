@model ReadEase.ViewModels.Author.ManageBooksViewModel
@{
    ViewData["Title"] = "My Books";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@400;500;600;700&display=swap');

    :root {
        --ink: #111318;
        --ink-soft: #5a5f6e;
        --ink-muted: #9499a8;
        --rule: #e4e2dd;
        --surface: #ffffff;
        --bg: #f7f6f3;
        --accent: #f26522;
        --accent-dk: #d9541a;
        --accent-bg: #fff6f2;
        --accent-ring: rgba(242,101,34,.18);
        --green: #065f46;
        --green-lt: #059669;
        --green-bg: #ecfdf5;
        --green-bd: #a7f3d0;
        --violet: #5b52e8;
        --radius-sm: 8px;
        --radius: 14px;
        --radius-lg: 20px;
        --shadow-sm: 0 1px 4px rgba(0,0,0,.06);
        --shadow: 0 3px 14px rgba(0,0,0,.08);
    }

    body {
        font-family: 'DM Sans', sans-serif;
    }

    /* ── Hero banner ── */
    .mb-hero {
        background: linear-gradient(135deg, #0d2b1f 0%, #064e3b 55%, #022c22 100%);
        border-radius: var(--radius-lg);
        padding: 2.25rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .mb-hero::before {
            content: '';
            position: absolute;
            top: -90px;
            right: -90px;
            width: 340px;
            height: 340px;
            background: radial-gradient(circle, rgba(16,185,129,.18) 0%, transparent 65%);
            pointer-events: none;
        }

        .mb-hero::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -60px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(242,101,34,.1) 0%, transparent 65%);
            pointer-events: none;
        }

    .mb-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .mb-hero-eyebrow {
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: rgba(16,185,129,.75);
        margin-bottom: .3rem;
    }

    .mb-hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0;
    }

    .mb-hero-sub {
        font-size: .82rem;
        color: rgba(255,255,255,.45);
        font-weight: 500;
        margin-top: .3rem;
    }

    .btn-publish {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: linear-gradient(135deg, #10b981, #059669);
        border: none;
        border-radius: var(--radius-sm);
        color: #fff;
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: .82rem;
        padding: .6rem 1.25rem;
        text-decoration: none;
        transition: transform .15s, box-shadow .15s;
        white-space: nowrap;
        box-shadow: 0 4px 14px rgba(5,150,105,.35);
    }

        .btn-publish svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

        .btn-publish:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(5,150,105,.45);
            color: #fff;
        }

    /* ── Stat cards ── */
    .stat-card {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 1.15rem 1.3rem;
        box-shadow: var(--shadow-sm);
        position: relative;
        overflow: hidden;
        transition: box-shadow .18s, transform .18s;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 0;
            background: var(--accent);
            transition: width .3s ease;
        }

        .stat-card:hover {
            box-shadow: var(--shadow);
            transform: translateY(-2px);
        }

            .stat-card:hover::after {
                width: 100%;
            }

    .stat-val {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--green);
        line-height: 1;
    }

        .stat-val.violet {
            color: var(--violet);
        }

    .stat-lbl {
        font-size: .67rem;
        font-weight: 700;
        color: var(--ink-muted);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-top: .3rem;
    }

    .stat-icon {
        position: absolute;
        top: 1rem;
        right: 1.1rem;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: .55;
    }

        .stat-icon svg {
            width: 16px;
            height: 16px;
        }

    .stat-icon-green {
        background: var(--green-bg);
        color: var(--green-lt);
    }

    .stat-icon-violet {
        background: #ede9fe;
        color: var(--violet);
    }

    .stat-icon-orange {
        background: var(--accent-bg);
        color: var(--accent);
    }

    /* ── Section title ── */
    .sec-title {
        font-family: 'DM Sans', sans-serif;
        font-weight: 700;
        font-size: .7rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-soft);
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: 1rem;
    }

    .sec-rule {
        flex: 1;
        height: 1px;
        background: var(--rule);
    }

    /* ── Table ── */
    .books-table-wrap {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .books-table thead th {
        background: var(--green) !important;
        color: rgba(255,255,255,.75) !important;
        font-family: 'DM Sans', sans-serif;
        font-size: .65rem !important;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .09em;
        padding: .9rem 1.1rem !important;
        border: none !important;
    }

    .books-table td {
        padding: .8rem 1.1rem !important;
        vertical-align: middle;
        font-size: .84rem;
        border-color: #f2f0ec !important;
        color: var(--ink);
    }

    .books-table tbody tr {
        transition: background .12s;
    }

        .books-table tbody tr:hover {
            background: #f3fdf8 !important;
        }

    .cover-placeholder {
        width: 38px;
        height: 50px;
        border-radius: 6px;
        background: linear-gradient(135deg, #e2e0f9, #c7d2fe);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cover-placeholder svg {
            width: 16px;
            height: 16px;
            color: #6366f1;
        }

    .tag {
        display: inline-block;
        padding: .18rem .6rem;
        border-radius: 20px;
        font-size: .63rem;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

    .tag-cat {
        background: #f1f0ff;
        color: #4f46e5;
    }

    .tag-free {
        background: var(--green-bg);
        color: var(--green);
    }

    .tag-premium {
        background: #fef9e7;
        color: #92400e;
    }

    .act-btn {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        border: 1.5px solid;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .14s;
        text-decoration: none;
        background: transparent;
    }

        .act-btn svg {
            width: 13px;
            height: 13px;
        }

        .act-btn:hover {
            transform: scale(1.1);
            opacity: .85;
        }

    .act-btn-view {
        border-color: var(--green-bd);
        color: var(--green-lt);
        background: var(--green-bg);
    }

    .act-btn-chapter {
        border-color: #fed7aa;
        color: #c2410c;
        background: #fff7ed;
    }

    .act-btn-edit {
        border-color: #bfdbfe;
        color: #2563eb;
        background: #eff6ff;
    }

    .act-btn-del {
        border-color: #fca5a5;
        color: #dc2626;
        background: #fef2f2;
    }

    /* ── Empty state ── */
    .empty-state {
        text-align: center;
        padding: 4rem 1.5rem;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: var(--bg);
        border: 1.5px solid var(--rule);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

        .empty-icon svg {
            width: 28px;
            height: 28px;
            color: var(--ink-muted);
        }

    .empty-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: .4rem;
    }

    .empty-sub {
        font-size: .84rem;
        color: var(--ink-muted);
        margin-bottom: 1.25rem;
    }

    /* ── Pagination ── */
    .re-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
    }

    .re-page-info {
        font-size: .75rem;
        font-weight: 600;
        color: var(--ink-muted);
    }

    .re-page-btns {
        display: flex;
        align-items: center;
        gap: .3rem;
    }

    .re-page-btn {
        min-width: 30px;
        height: 30px;
        padding: 0 .5rem;
        border-radius: 7px;
        border: 1.5px solid var(--rule);
        background: var(--surface);
        font-family: 'DM Sans', sans-serif;
        font-size: .75rem;
        font-weight: 700;
        color: var(--ink-soft);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .14s;
    }

        .re-page-btn:hover:not(:disabled) {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-bg);
        }

        .re-page-btn.active {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

        .re-page-btn:disabled {
            opacity: .3;
            cursor: default;
        }

    /* ── Alerts ── */
    .pb-alert {
        border-radius: var(--radius-sm);
        padding: .75rem 1rem;
        font-size: .82rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: .6rem;
        margin-bottom: 1rem;
    }

    .pb-alert-success {
        background: var(--green-bg);
        border: 1px solid var(--green-bd);
        color: var(--green);
    }

    .pb-alert-danger {
        background: #fff1f1;
        border: 1px solid #fca5a5;
        color: #b91c1c;
    }

    .fade-up {
        animation: fadeUp .4s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="pb-alert pb-alert-success">
        <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px;flex-shrink:0"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="pb-alert pb-alert-danger">
        <svg viewBox="0 0 20 20" fill="currentColor" style="width:15px;height:15px;flex-shrink:0"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
        @TempData["ErrorMessage"]
    </div>
}

<div class="mb-hero fade-up">
    <div class="mb-hero-inner">
        <div>
            <div class="mb-hero-eyebrow">Author Dashboard</div>
            <h1 class="mb-hero-title">My Books</h1>
            <div class="mb-hero-sub">Manage and track your published works</div>
        </div>
        <a asp-controller="Author" asp-action="Create" class="btn-publish">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Publish New Book
        </a>
    </div>
</div>

<div class="row g-3 mb-4 fade-up">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" /></svg>
            </div>
            <div class="stat-val">@Model.Books.Count(b => !b.IsDeleted)</div>
            <div class="stat-lbl">Published</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
            </div>
            <div class="stat-val">@Model.Books.Where(b => !b.IsDeleted).Sum(b => b.ReadCount)</div>
            <div class="stat-lbl">Total Reads</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-icon stat-icon-orange">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
            </div>
            <div class="stat-val" style="color:var(--accent)">@Model.Books.Count(b => !b.IsDeleted && b.IsFree)</div>
            <div class="stat-lbl">Free Books</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Author" asp-action="Archive" class="stat-card text-decoration-none d-block">
            <div class="stat-icon stat-icon-violet">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" /></svg>
            </div>
            <div class="stat-val violet">@Model.Books.Count(b => b.IsDeleted)</div>
            <div class="stat-lbl">Archived</div>
        </a>
    </div>
</div>

<div class="sec-title fade-up">
    Published Books
    <div class="sec-rule"></div>
</div>

@if (!Model.Books.Any(b => !b.IsDeleted))
{
    <div class="books-table-wrap fade-up">
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 016.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" /></svg>
            </div>
            <div class="empty-title">No books published yet</div>
            <div class="empty-sub">Start by sharing your first story with the world.</div>
            <a asp-controller="Author" asp-action="Create" class="btn-publish" style="display:inline-flex;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                Publish Your First Book
            </a>
        </div>
    </div>
}
else
{
    <div class="books-table-wrap fade-up">
        <div class="table-responsive">
            <table class="table books-table align-middle mb-0" id="mybooksTable">
                <thead>
                    <tr>
                        <th style="width:52px;">Cover</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Access</th>
                        <th>Published</th>
                        <th class="text-center">Reads</th>
                        <th class="text-end" style="width:140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.Books.Where(b => !b.IsDeleted).OrderByDescending(b => b.PublishedAt))
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(book.CoverImage))
                                {
                                    <img src="@book.CoverImage" style="width:38px;height:50px;object-fit:cover;border-radius:6px;" />
                                }
                                else
                                {
                                    <div class="cover-placeholder">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 016.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" /></svg>
                                    </div>
                                }
                            </td>
                            <td style="font-weight:600;max-width:220px;">@book.Title</td>
                            <td><span class="tag tag-cat">@book.Category</span></td>
                            <td>
                                <span class="tag @(book.IsFree ? "tag-free" : "tag-premium")">
                                    @(book.IsFree ? "Free" : "Premium")
                                </span>
                            </td>
                            <td style="color:var(--ink-muted);font-size:.8rem;">@book.PublishedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-center" style="font-weight:700;color:var(--green-lt);">@book.ReadCount</td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-controller="Library" asp-action="Detail" asp-route-id="@book.Id"
                                       class="act-btn act-btn-view" title="View">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                    </a>
                                 
                                    <a asp-controller="Author" asp-action="Chapters" asp-route-bookId="@book.Id"
                                       class="act-btn act-btn-chapter" title="Manage Chapters">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 10h16M4 14h10" /></svg>
                                    </a>
                                    <a asp-controller="Author" asp-action="Edit" asp-route-id="@book.Id"
                                       class="act-btn act-btn-edit" title="Edit">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                    </a>
                                    <form asp-controller="Author" asp-action="Delete" asp-route-id="@book.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="act-btn act-btn-del" title="Archive"
                                                onclick="return confirm('Move this book to the archive?')">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="re-pagination" id="mybooksPagination">
        <span class="re-page-info" id="mybooksPageInfo"></span>
        <div class="re-page-btns" id="mybooksPageBtns"></div>
    </div>
}

@section Scripts {
    <script>
        const PAGE_SIZE = 10;
        let currentPage = 1;

        function renderPagination() {
            const rows = Array.from(document.querySelectorAll('#mybooksTable tbody tr'));
            const total = rows.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            currentPage = Math.min(currentPage, totalPages);
            const start = (currentPage - 1) * PAGE_SIZE;

            rows.forEach((r, i) => {
                r.style.display = (i >= start && i < start + PAGE_SIZE) ? '' : 'none';
            });

            const info = document.getElementById('mybooksPageInfo');
            const btns = document.getElementById('mybooksPageBtns');
            const showing = Math.min(PAGE_SIZE, total - start);
            info.textContent = total === 0
                ? 'No books'
                : `Showing ${start + 1}–${start + showing} of ${total} book${total !== 1 ? 's' : ''}`;

            btns.innerHTML = '';
            const pag = document.getElementById('mybooksPagination');
            if (totalPages <= 1) { pag.style.display = 'none'; return; }
            pag.style.display = 'flex';

            const mkBtn = (label, page, disabled, active) => {
                const b = document.createElement('button');
                b.className = 're-page-btn' + (active ? ' active' : '');
                b.textContent = label;
                b.disabled = disabled;
                if (!disabled && !active) b.onclick = () => { currentPage = page; renderPagination(); };
                btns.appendChild(b);
            };

            mkBtn('← Prev', currentPage - 1, currentPage === 1, false);
            for (let p = 1; p <= totalPages; p++) {
                if (totalPages > 7 && p > 2 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
                    if (p === 3 || p === totalPages - 2) {
                        const d = document.createElement('span');
                        d.style.cssText = 'color:var(--ink-muted);font-size:.75rem;padding:0 .2rem;';
                        d.textContent = '…';
                        btns.appendChild(d);
                    }
                    continue;
                }
                mkBtn(p, p, false, p === currentPage);
            }
            mkBtn('Next →', currentPage + 1, currentPage === totalPages, false);
        }

        renderPagination();
    </script>
}
