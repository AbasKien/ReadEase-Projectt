@section Scripts {
    <script>
        // ── Redirect all non-anchor links to Login ──────────────────────
        document.querySelectorAll('a[href]:not([href^="#"])').forEach(a => {
            a.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                // Only intercept if it's NOT already the login/register page
                if (href && !href.includes('Login') && !href.includes('login')
                         && !href.includes('Register') && !href.includes('register')
                         && !href.includes('GuestRead') && !href.includes('guestread')) {
                    e.preventDefault();
                    window.location.href = '/Auth/Login';
                }
            });
        });

        // Also intercept book cards (onclick) — but not the preview CTA link or Read button
        document.querySelectorAll('.book-card').forEach(card => {
            card.addEventListener('click', function (e) {
                if (e.target.closest('.book-preview-cta')) return;
                if (e.target.closest('.btn-book-read')) return;
                e.preventDefault();
                window.location.href = '/Auth/Login';
            });
        });

        // Scroll-triggered fade-up for sections
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.style.opacity = '1';
                    e.target.style.transform = 'none';
                    observer.unobserve(e.target);
                }
            });
        }, { threshold: 0.08 });

        document.querySelectorAll('.re-section').forEach(s => {
            s.style.opacity = '0';
            s.style.transform = 'translateY(28px)';
            s.style.transition = 'opacity .55s ease, transform .55s ease';
            observer.observe(s);
        });
        document.querySelectorAll('.re-stats-bar').forEach(s => {
            s.style.opacity = '0';
            s.style.transform = 'translateY(12px)';
            s.style.transition = 'opacity .4s ease .1s, transform .4s ease .1s';
            observer.observe(s);
        });

        // Smooth scroll for nav anchors
        document.querySelectorAll('a[href^="#"]').forEach(a => {
            a.addEventListener('click', e => {
                const target = document.querySelector(a.getAttribute('href'));
                if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            });
        });

        // ── Genre Panel ────────────────────────────────────────────────
        let activeGenre = null;

        function fmtViews(v) {
            if (v >= 1000000) return (v / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
            if (v >= 1000) return (v / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
            return v.toString();
        }

        function toggleGenrePanel(pill) {
            const genre = pill.dataset.genre;
            const panel = document.getElementById('genre-panel');
            const allPills = document.querySelectorAll('.genre-pill-clickable');

            // If clicking the already-active genre, close it
            if (activeGenre === genre) {
                closeGenrePanel();
                return;
            }

            // Deactivate all pills
            allPills.forEach(p => p.classList.remove('active'));
            pill.classList.add('active');
            activeGenre = genre;

            // Build books from data attribute
            let books = [];
            try { books = JSON.parse(pill.dataset.books || '[]'); } catch(e) {}

            // Populate panel
            document.getElementById('genre-panel-name').textContent = genre;

            // Icon
            const iconEl = document.getElementById('genre-panel-icon');
            iconEl.style.background = pill.dataset.bg || '#fff3ed';
            const srcIcon = pill.querySelector('.genre-icon');
            iconEl.innerHTML = srcIcon ? srcIcon.innerHTML : '';

            // Books grid
            const grid = document.getElementById('genre-books-grid');

            if (!books.length) {
                grid.innerHTML = `<div class="genre-empty">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    No books found in <strong>${genre}</strong> yet.
                </div>`;
            } else {
                const sorted = [...books].sort((a, b) => b.readCount - a.readCount);
                grid.innerHTML = sorted.map((b, i) => {
                    const rank = i + 1;
                    const isTop3 = rank <= 3;
                    const coverHtml = b.cover
                        ? `<img src="${b.cover}" alt="${escHtml(b.title)}" loading="lazy" style="width:60px;height:80px;object-fit:cover;border-radius:8px;" />`
                        : `<svg viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/></svg>`;

                    const readBtn = b.isFree
                        ? `<a href="/Landing/GuestRead/${b.id}" class="btn-genre-read" onclick="event.stopPropagation()">
                                Read
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:10px;height:10px;"><polyline points="9 18 15 12 9 6"/></svg>
                           </a>`
                        : `<a href="/Auth/Login" class="btn-genre-read locked" onclick="event.stopPropagation()" title="Premium – login to read">
                                🔒 Login
                           </a>`;

                    const tag = b.isFree
                        ? `<span class="genre-book-tag free">free</span>`
                        : `<span class="genre-book-tag premium">premium</span>`;

                    return `<div class="genre-book-item" onclick="window.location='${b.isFree ? '/Landing/GuestRead/' + b.id : '/Auth/Login'}'">
                        <div class="genre-book-num ${isTop3 ? 'top3' : ''}">${rank}</div>
                        <div class="genre-book-cover">${coverHtml}</div>
                        <div class="genre-book-info">
                            <div class="genre-book-title">${escHtml(b.title)}</div>
                            <div class="genre-book-author">${escHtml(b.author)}</div>
                            <div class="genre-book-tags">${tag}</div>
                            <div class="genre-book-reads">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                ${fmtViews(b.readCount)}
                            </div>
                        </div>
                        <div class="genre-book-actions">${readBtn}</div>
                    </div>`;
                }).join('');
            }

            // Show panel
            panel.style.display = 'block';

            // Scroll to panel smoothly
            setTimeout(() => {
                panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 60);
        }

        function closeGenrePanel() {
            const panel = document.getElementById('genre-panel');
            panel.style.display = 'none';
            document.querySelectorAll('.genre-pill-clickable').forEach(p => p.classList.remove('active'));
            activeGenre = null;
        }

        function escHtml(str) {
            return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }
    </script>
}
