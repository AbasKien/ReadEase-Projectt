@model ReadEase.ViewModels.Landing.LandingViewModel
@{
    ViewData["Title"] = "ReadEase – Your Reading World";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Gradient palette — assigned by index so each book gets a distinct colour
    string[] gradients = {
        "linear-gradient(160deg,#667eea,#764ba2)",
        "linear-gradient(160deg,#f26522,#e91e63)",
        "linear-gradient(160deg,#f093fb,#f5576c)",
        "linear-gradient(160deg,#4facfe,#00f2fe)",
        "linear-gradient(160deg,#43e97b,#38f9d7)",
        "linear-gradient(160deg,#fa709a,#fee140)",
        "linear-gradient(160deg,#a18cd1,#fbc2eb)",
        "linear-gradient(160deg,#fda085,#f6d365)",
        "linear-gradient(160deg,#30cfd0,#330867)",
        "linear-gradient(160deg,#6a11cb,#2575fc)",
    };

    string[] rankClass = { "gold", "silver", "bronze", "", "", "" };

    string StarsSvg(double r)
    {
        var sb = new System.Text.StringBuilder();
        int rounded = (int)Math.Round(r);
        for (int i = 1; i <= 5; i++)
        {
            bool full = i <= rounded;
            sb.Append($"<svg class='star-{(full ? "full" : "empty")}' viewBox='0 0 24 24' fill='currentColor'><path d='M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'/></svg>");
        }
        return sb.ToString();
    }

    string FmtViews(int v) => v >= 1000 ? $"{v / 1000.0:0.#}k" : v.ToString();
    string FmtRating(double r) => r > 0 ? r.ToString("0.0") : "—";
}

<style>
    /* ══════════════════════════════════════════
                       DESIGN TOKENS
                    ══════════════════════════════════════════ */
    :root {
        --orange: #f26522;
        --orange-dark: #d9541a;
        --orange-glow: rgba(242,101,34,.18);
        --orange-light: #fff3ed;
        --navy: #1a1a2e;
        --navy-mid: #0f3460;
        --navy-light: #16213e;
        --cream: #faf7f3;
        --cream-border: #ede8e0;
        --text-body: #3d3a4a;
        --text-muted: #6b6878;
        --text-faint: #9994a8;
        --white: #ffffff;
        --font: 'Nunito', sans-serif;
        --radius-sm: 8px;
        --radius-md: 14px;
        --radius-lg: 22px;
        --radius-xl: 30px;
        --shadow-card: 0 4px 20px rgba(0,0,0,.07);
        --shadow-hover: 0 20px 56px rgba(0,0,0,.13);
    }

    /* ══════════════════════════════════════════
                       RESET & BASE
                    ══════════════════════════════════════════ */
    body > nav, footer, .re-main > .container {
        display: none !important;
    }

    .re-main {
        padding: 0 !important;
        max-width: 100% !important;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: var(--font);
        background: var(--cream);
        color: var(--text-body);
        overflow-x: hidden;
    }

    /* ══════════════════════════════════════════
                       AMBIENT BLOBS (fixed, full-page depth)
                    ══════════════════════════════════════════ */
    .blob {
        position: fixed;
        background: var(--orange);
        pointer-events: none;
        z-index: 0;
        opacity: .045;
    }

    .blob-tl {
        width: 340px;
        height: 660px;
        top: -200px;
        left: -130px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: bA 9s ease-in-out infinite;
    }

    .blob-br {
        width: 310px;
        height: 590px;
        bottom: -190px;
        right: -115px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: bB 11s ease-in-out infinite;
    }

    @@keyframes bA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes bB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    /* ══════════════════════════════════════════
                       NAVBAR
                    ══════════════════════════════════════════ */
    .re-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(15,52,96,.96);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255,255,255,.08);
        padding: .75rem 0;
    }

    .re-nav-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-brand {
        display: flex;
        align-items: center;
        gap: .6rem;
        text-decoration: none;
    }

    .re-brand-book {
        width: 32px;
        height: 38px;
        background: var(--orange);
        border-radius: 4px 6px 6px 4px;
        position: relative;
        box-shadow: 0 4px 14px var(--orange-glow);
        flex-shrink: 0;
    }

        .re-brand-book::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 0;
            bottom: 0;
            width: 3px;
            background: rgba(0,0,0,.18);
        }

        .re-brand-book::after {
            content: '';
            position: absolute;
            left: 13px;
            top: 9px;
            width: 12px;
            height: 12px;
            background: linear-gradient(#fff,#fff) 0 0/12px 2px no-repeat, linear-gradient(#fff,#fff) 0 5px/12px 2px no-repeat, linear-gradient(#fff,#fff) 0 10px/8px 2px no-repeat;
            opacity: .9;
        }

    .re-brand-name {
        font-size: 1.45rem;
        font-weight: 900;
        color: #fff;
        letter-spacing: -.025em;
        line-height: 1;
    }

        .re-brand-name em {
            color: var(--orange);
            font-style: normal;
        }

    .re-nav-links {
        display: flex;
        align-items: center;
        gap: 1.75rem;
    }

        .re-nav-links a {
            font-size: .85rem;
            font-weight: 700;
            color: rgba(255,255,255,.6);
            text-decoration: none;
            transition: color .15s;
        }

            .re-nav-links a:hover {
                color: var(--orange);
            }

    .re-nav-cta {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .btn-nav-ghost {
        font-size: .82rem;
        font-weight: 800;
        color: rgba(255,255,255,.85) !important;
        padding: .42rem 1.1rem;
        border: 1.5px solid rgba(255,255,255,.25);
        border-radius: 50px;
        text-decoration: none !important;
        transition: border-color .15s, color .15s;
        background: transparent;
    }

        .btn-nav-ghost:hover {
            border-color: var(--orange);
            color: var(--orange) !important;
        }

    .btn-nav-primary {
        font-size: .82rem;
        font-weight: 800;
        color: #fff !important;
        padding: .42rem 1.2rem;
        border-radius: 50px;
        background: var(--orange);
        text-decoration: none !important;
        box-shadow: 0 3px 12px var(--orange-glow);
        transition: background .15s, box-shadow .15s;
    }

        .btn-nav-primary:hover {
            background: var(--orange-dark);
            color: #fff !important;
        }

    /* ══════════════════════════════════════════
                       HERO
                    ══════════════════════════════════════════ */
    /* ── Hero video background ── */
    .re-hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 6rem 0 4rem;
        background: linear-gradient(150deg, #0a1428 0%, #0f3460 55%, #0a1428 100%);
    }

    .re-hero-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        z-index: 0;
    }
    /* Dark overlay so text stays readable */
    .re-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( 135deg, rgba(10,20,45,.82) 0%, rgba(15,52,96,.70) 50%, rgba(10,20,45,.75) 100% );
        z-index: 1;
    }
        /* Subtle orange glow top-right */
        .re-hero-overlay::after {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(242,101,34,.18) 0%, transparent 65%);
            pointer-events: none;
        }

    .re-hero-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
        position: relative;
        z-index: 2;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: flex-start;
    }

    .re-hero-text {
        flex: 1;
        min-width: 300px;
        max-width: 680px;
    }

    .re-hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: rgba(242,101,34,.15);
        border: 1px solid rgba(242,101,34,.3);
        border-radius: 20px;
        padding: .22rem .8rem;
        font-size: .67rem;
        font-weight: 900;
        color: #fbb07a;
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: 1.25rem;
    }

        .re-hero-eyebrow svg {
            width: 12px;
            height: 12px;
        }

    .re-hero-h1 {
        font-size: clamp(2.4rem, 5vw, 3.8rem);
        font-weight: 900;
        color: #fff;
        line-height: 1.08;
        letter-spacing: -.03em;
        margin-bottom: 1.25rem;
    }

        .re-hero-h1 em {
            color: var(--orange);
            font-style: normal;
        }

        .re-hero-h1 .line-accent {
            display: inline-block;
            position: relative;
        }

            .re-hero-h1 .line-accent::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -4px;
                width: 100%;
                height: 3px;
                background: var(--orange);
                border-radius: 2px;
            }

    .re-hero-sub {
        font-size: 1.05rem;
        color: rgba(255,255,255,.65);
        font-weight: 600;
        line-height: 1.65;
        margin-bottom: 2.25rem;
        max-width: 520px;
    }

    .re-hero-btns {
        display: flex;
        align-items: center;
        gap: .85rem;
        flex-wrap: wrap;
    }

    .btn-hero-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: var(--orange);
        color: #fff;
        font-family: var(--font);
        font-weight: 900;
        font-size: .95rem;
        padding: .85rem 2rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 6px 28px rgba(242,101,34,.42);
        transition: background .18s, transform .18s, box-shadow .18s;
    }

        .btn-hero-primary:hover {
            background: var(--orange-dark);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 36px rgba(242,101,34,.5);
        }

        .btn-hero-primary svg {
            width: 16px;
            height: 16px;
        }

    .btn-hero-ghost {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: rgba(255,255,255,.12);
        border: 1.5px solid rgba(255,255,255,.25);
        color: rgba(255,255,255,.85);
        font-family: var(--font);
        font-weight: 800;
        font-size: .9rem;
        padding: .8rem 1.6rem;
        border-radius: 50px;
        text-decoration: none;
        transition: background .18s;
    }

        .btn-hero-ghost:hover {
            background: rgba(255,255,255,.2);
            color: #fff;
        }

        .btn-hero-ghost svg {
            width: 14px;
            height: 14px;
        }
    /* Trust bar */
    .re-hero-trust {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-top: 2.5rem;
        flex-wrap: wrap;
    }

    .trust-item {
        display: flex;
        align-items: center;
        gap: .45rem;
        font-size: .78rem;
        font-weight: 700;
        color: rgba(255,255,255,.5);
    }

        .trust-item svg {
            width: 14px;
            height: 14px;
            color: rgba(242,101,34,.8);
        }

    .trust-sep {
        width: 1px;
        height: 18px;
        background: rgba(255,255,255,.15);
    }

    /* ══════════════════════════════════════════
                       STATS BAR
                    ══════════════════════════════════════════ */
    .re-stats-bar {
        background: #fff;
        border-bottom: 1px solid var(--cream-border);
        position: relative;
        z-index: 3;
    }

    .re-stats-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1.75rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .stat-item {
        text-align: center;
    }

    .stat-num {
        font-size: 1.75rem;
        font-weight: 900;
        color: var(--navy);
        line-height: 1;
    }

        .stat-num span {
            color: var(--orange);
        }

    .stat-label {
        font-size: .7rem;
        font-weight: 800;
        color: var(--text-faint);
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-top: .2rem;
    }

    .stat-div {
        width: 1px;
        height: 40px;
        background: var(--cream-border);
    }

    /* ══════════════════════════════════════════
                       SECTION CHROME
                    ══════════════════════════════════════════ */
    .re-section {
        padding: 4.5rem 0;
        position: relative;
        z-index: 2;
    }

    .re-section-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .re-section-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .re-section-eyebrow {
        font-size: .68rem;
        font-weight: 900;
        color: var(--orange);
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: .35rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

        .re-section-eyebrow svg {
            width: 12px;
            height: 12px;
        }

    .re-section-title {
        font-size: 1.75rem;
        font-weight: 900;
        color: var(--navy);
        line-height: 1.15;
        letter-spacing: -.025em;
    }

        .re-section-title em {
            color: var(--orange);
            font-style: normal;
        }

    .re-section-sub {
        font-size: .88rem;
        color: var(--text-muted);
        font-weight: 600;
        margin-top: .3rem;
    }

    .re-view-all {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .8rem;
        font-weight: 800;
        color: var(--orange);
        text-decoration: none;
        padding: .42rem 1rem;
        border: 1.5px solid rgba(242,101,34,.25);
        border-radius: 50px;
        transition: background .15s, border-color .15s;
        flex-shrink: 0;
    }

        .re-view-all:hover {
            background: var(--orange-light);
            border-color: var(--orange);
        }

        .re-view-all svg {
            width: 13px;
            height: 13px;
        }

    /* ══════════════════════════════════════════
                       BOOK CARDS (shared)
                    ══════════════════════════════════════════ */
    .book-card {
        background: #fff;
        border: 1px solid var(--cream-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition: transform .28s cubic-bezier(.34,1.56,.64,1), box-shadow .28s, border-color .2s;
        box-shadow: var(--shadow-card);
        height: 100%;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

        .book-card:hover {
            transform: translateY(-8px) scale(1.015);
            box-shadow: var(--shadow-hover);
            border-color: var(--orange);
        }

    .book-cover-wrap {
        position: relative;
        overflow: hidden;
    }

    .book-cover {
        width: 100%;
        height: 220px;
        object-fit: cover;
        display: block;
        transition: transform .38s ease;
    }

    .book-card:hover .book-cover {
        transform: scale(1.06);
    }

    .book-cover-ph {
        width: 100%;
        height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .book-cover-ph svg {
            width: 48px;
            height: 48px;
            opacity: .5;
            color: #fff;
        }
    /* Rank badge */
    .book-rank {
        position: absolute;
        top: 10px;
        left: 10px;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: rgba(26,26,46,.75);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .65rem;
        font-weight: 900;
        color: #fff;
    }

        .book-rank.gold {
            background: linear-gradient(135deg,#f59e0b,#d97706);
        }

        .book-rank.silver {
            background: linear-gradient(135deg,#94a3b8,#64748b);
        }

        .book-rank.bronze {
            background: linear-gradient(135deg,#c2855c,#a0633a);
        }
    /* Free / premium badge */
    .book-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        border-radius: 6px;
        font-size: .58rem;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: .18rem .5rem;
    }

        .book-badge.free {
            background: #dcfce7;
            color: #15803d;
        }

        .book-badge.premium {
            background: linear-gradient(135deg,#f59e0b,#d97706);
            color: #fff;
        }
    /* Stars */
    .star-row {
        display: flex;
        align-items: center;
        gap: .2rem;
        margin-bottom: .3rem;
    }

        .star-row svg {
            width: 11px;
            height: 11px;
        }

    .star-full {
        color: #f59e0b;
    }

    .star-empty {
        color: #ddd;
    }

    .star-val {
        font-size: .68rem;
        font-weight: 800;
        color: var(--text-muted);
        margin-left: .2rem;
    }
    /* Card body */
    .book-body {
        padding: .8rem .9rem .4rem;
        flex: 1;
    }

    .book-genre-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        background: var(--cream);
        border: 1px solid var(--cream-border);
        border-radius: 20px;
        padding: .1rem .55rem;
        font-size: .58rem;
        font-weight: 800;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .35rem;
    }

        .book-genre-pill svg {
            width: 9px;
            height: 9px;
        }

    .book-title {
        font-family: var(--font);
        font-size: .85rem;
        font-weight: 900;
        color: var(--navy);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        margin-bottom: .18rem;
    }

    .book-author {
        font-size: .7rem;
        color: var(--text-muted);
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    /* Card footer */
    .book-foot {
        padding: .45rem .9rem .8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
    }

    .book-views {
        display: flex;
        align-items: center;
        gap: .28rem;
        font-size: .64rem;
        font-weight: 700;
        color: var(--text-faint);
    }

        .book-views svg {
            width: 11px;
            height: 11px;
        }

    .btn-book-read {
        font-size: .7rem;
        font-weight: 900;
        padding: .3rem .9rem;
        border-radius: 8px;
        background: var(--orange);
        color: #fff;
        border: none;
        text-decoration: none;
        transition: background .15s;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        box-shadow: 0 2px 10px var(--orange-glow);
    }

        .btn-book-read:hover {
            background: var(--orange-dark);
            color: #fff;
        }

        .btn-book-read svg {
            width: 11px;
            height: 11px;
        }

    /* ══════════════════════════════════════════
                       BOOK PREVIEW SNIPPET  ← NEW ADDITION
                    ══════════════════════════════════════════ */
    .book-preview-wrap {
        position: relative;
        margin: 0 .9rem .1rem;
        padding-top: .55rem;
        border-top: 1px dashed var(--cream-border);
    }

    .book-preview-text {
        font-size: .73rem;
        color: var(--text-muted);
        line-height: 1.6;
        font-weight: 500;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* cream-coloured gradient that fades the text out */
    .book-preview-fade {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2rem;
        background: linear-gradient(to bottom, transparent, #fff);
        pointer-events: none;
    }

    /* "Log in to read more" row */
    .book-preview-cta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        padding: .4rem .9rem .65rem;
        font-size: .72rem;
        font-weight: 700;
        color: var(--text-muted);
    }

        .book-preview-cta svg {
            width: 12px;
            height: 12px;
            color: var(--orange);
            flex-shrink: 0;
        }

        .book-preview-cta a {
            color: var(--orange);
            font-weight: 800;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

            .book-preview-cta a:hover {
                color: var(--orange-dark);
            }

    /* ══════════════════════════════════════════
                       TOP RATED SECTION
                    ══════════════════════════════════════════ */
    .section-rated {
        background: var(--cream);
    }

    /* ══════════════════════════════════════════
                       MOST VIEWED — horizontal scroll on mobile
                    ══════════════════════════════════════════ */
    .section-viewed {
        background: #fff;
    }

    .viewed-scroll-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding-bottom: .5rem;
    }

        .viewed-scroll-wrap::-webkit-scrollbar {
            height: 4px;
        }

        .viewed-scroll-wrap::-webkit-scrollbar-track {
            background: var(--cream);
            border-radius: 2px;
        }

        .viewed-scroll-wrap::-webkit-scrollbar-thumb {
            background: var(--orange);
            border-radius: 2px;
        }

    .viewed-row {
        display: flex;
        gap: 1rem;
        width: max-content;
        padding: .25rem .1rem;
    }

    .viewed-card-wrap {
        width: 170px;
        flex-shrink: 0;
    }

    /* ══════════════════════════════════════════
                       FEATURED / SPOTLIGHT
                    ══════════════════════════════════════════ */
    .section-spotlight {
        background: var(--cream);
    }

    .spotlight-card {
        background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 60%, var(--navy-light) 100%);
        border-radius: var(--radius-xl);
        overflow: hidden;
        position: relative;
        padding: 3rem 3rem 3rem 2.5rem;
        display: flex;
        align-items: center;
        gap: 3rem;
        flex-wrap: wrap;
        box-shadow: 0 20px 60px rgba(0,0,0,.18);
    }

        .spotlight-card::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(242,101,34,.18) 0%, transparent 65%);
            pointer-events: none;
        }

    .spotlight-text {
        flex: 1;
        min-width: 260px;
        position: relative;
        z-index: 1;
    }

    .spotlight-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(242,101,34,.15);
        border: 1px solid rgba(242,101,34,.3);
        border-radius: 20px;
        padding: .2rem .8rem;
        font-size: .65rem;
        font-weight: 900;
        color: #fbb07a;
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: 1rem;
    }

        .spotlight-eyebrow svg {
            width: 11px;
            height: 11px;
        }

    .spotlight-title {
        font-size: 1.75rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.15;
        letter-spacing: -.02em;
        margin-bottom: .65rem;
    }

        .spotlight-title em {
            color: var(--orange);
            font-style: normal;
        }

    .spotlight-desc {
        font-size: .9rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        line-height: 1.65;
        margin-bottom: 1.75rem;
        max-width: 460px;
    }

    .spotlight-stats {
        display: flex;
        gap: 2rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .sp-stat {
    }

    .sp-stat-num {
        font-size: 1.4rem;
        font-weight: 900;
        color: #fff;
    }

        .sp-stat-num em {
            color: var(--orange);
            font-style: normal;
        }

    .sp-stat-label {
        font-size: .65rem;
        font-weight: 800;
        color: rgba(255,255,255,.35);
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .btn-spotlight {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: var(--orange);
        color: #fff;
        font-family: var(--font);
        font-weight: 900;
        font-size: .9rem;
        padding: .75rem 1.75rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 4px 22px rgba(242,101,34,.4);
        transition: background .18s, transform .18s;
    }

        .btn-spotlight:hover {
            background: var(--orange-dark);
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-spotlight svg {
            width: 15px;
            height: 15px;
        }

    .spotlight-visual {
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
        gap: 1rem;
        position: relative;
        z-index: 1;
    }

    .sp-book {
        border-radius: 12px;
        position: relative;
        box-shadow: 0 16px 48px rgba(0,0,0,.4);
    }

        .sp-book::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 8px;
            background: rgba(0,0,0,.25);
            border-radius: 12px 0 0 12px;
        }

    .sp-book-1 {
        width: 80px;
        height: 120px;
        background: linear-gradient(160deg,#667eea,#764ba2);
        transform: rotate(-5deg);
    }

    .sp-book-2 {
        width: 90px;
        height: 138px;
        background: linear-gradient(160deg,#f26522,#e91e63);
    }

    .sp-book-3 {
        width: 80px;
        height: 112px;
        background: linear-gradient(160deg,#43e97b,#38f9d7);
        transform: rotate(4deg);
    }

    /* ══════════════════════════════════════════
                       GENRES SECTION
                    ══════════════════════════════════════════ */
    .section-genres {
        background: #fff;
    }

    .genre-pill {
        display: flex;
        align-items: center;
        gap: .6rem;
        background: var(--cream);
        border: 1.5px solid var(--cream-border);
        border-radius: 14px;
        padding: .8rem 1.1rem;
        cursor: default;
        position: relative;
    }

    .genre-pill-clickable {
        cursor: pointer;
        transition: background .18s, border-color .18s, box-shadow .18s, transform .18s;
    }

        .genre-pill-clickable:hover {
            border-color: var(--orange);
            background: var(--orange-light);
            box-shadow: 0 4px 18px var(--orange-glow);
            transform: translateY(-2px);
        }

        .genre-pill-clickable.active {
            border-color: var(--orange);
            background: var(--orange-light);
            box-shadow: 0 4px 20px var(--orange-glow);
        }

    .genre-chevron {
        width: 14px;
        height: 14px;
        color: var(--text-faint);
        margin-left: auto;
        flex-shrink: 0;
        transition: transform .25s ease, color .18s;
    }

    .genre-pill-clickable.active .genre-chevron {
        transform: rotate(180deg);
        color: var(--orange);
    }

    .genre-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .genre-icon svg {
            width: 18px;
            height: 18px;
        }

    .genre-name {
        font-size: .82rem;
        font-weight: 800;
        color: var(--navy);
    }

    .genre-count {
        font-size: .65rem;
        font-weight: 700;
        color: var(--text-faint);
        margin-top: .05rem;
    }

    /* ── Genre Panel (inline book viewer) ── */
    .genre-panel {
        margin-top: 1.5rem;
        background: #fff;
        border: 1.5px solid var(--cream-border);
        border-radius: var(--radius-lg);
        padding: 1.75rem 2rem;
        box-shadow: 0 8px 40px rgba(0,0,0,.08);
        animation: panelSlideIn .3s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes panelSlideIn {
        from {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .genre-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        gap: 1rem;
    }

    .genre-panel-title {
        display: flex;
        align-items: center;
        gap: .85rem;
    }

    .genre-panel-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .genre-panel-icon svg {
            width: 20px;
            height: 20px;
        }

    .genre-panel-eyebrow {
        font-size: .62rem;
        font-weight: 900;
        color: var(--orange);
        text-transform: uppercase;
        letter-spacing: .8px;
    }

    .genre-panel-name {
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--navy);
        line-height: 1.1;
    }

    .genre-panel-close {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1.5px solid var(--cream-border);
        background: var(--cream);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .18s, border-color .18s;
        flex-shrink: 0;
        padding: 0;
    }

        .genre-panel-close svg {
            width: 15px;
            height: 15px;
            color: var(--text-muted);
        }

        .genre-panel-close:hover {
            background: #fff0ec;
            border-color: var(--orange);
        }

            .genre-panel-close:hover svg {
                color: var(--orange);
            }

    .genre-panel-note {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .75rem;
        font-weight: 600;
        color: var(--text-muted);
        background: #fafaf8;
        border: 1px solid var(--cream-border);
        border-radius: 10px;
        padding: .55rem .9rem;
        margin-bottom: 1.5rem;
    }

    .genre-books-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 640px) {
        .genre-books-grid {
            grid-template-columns: 1fr;
        }

        .genre-panel {
            padding: 1.25rem;
        }
    }

    .genre-book-item {
        display: flex;
        gap: .85rem;
        padding: .9rem 1rem;
        background: var(--cream);
        border: 1px solid var(--cream-border);
        border-radius: 14px;
        transition: box-shadow .22s, transform .22s, border-color .22s;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        align-items: center;
    }

        .genre-book-item:hover {
            box-shadow: 0 8px 28px rgba(0,0,0,.1);
            transform: translateY(-3px);
            border-color: var(--orange);
        }

    .genre-book-num {
        font-size: 1.1rem;
        font-weight: 900;
        color: #e0dbd3;
        min-width: 20px;
        flex-shrink: 0;
        line-height: 1;
        align-self: flex-start;
        margin-top: .2rem;
    }

        .genre-book-num.top3 {
            color: var(--orange);
        }

    .genre-book-cover {
        width: 60px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
        background: linear-gradient(135deg,#667eea,#764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .genre-book-cover img {
            width: 60px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }

        .genre-book-cover svg {
            width: 24px;
            height: 24px;
            opacity: .5;
            color: #fff;
        }

    .genre-book-info {
        flex: 1;
        min-width: 0;
    }

    .genre-book-title {
        font-size: .82rem;
        font-weight: 800;
        color: var(--navy);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.3;
        margin-bottom: .15rem;
    }

    .genre-book-author {
        font-size: .68rem;
        color: var(--text-muted);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: .35rem;
    }

    .genre-book-tags {
        display: flex;
        gap: .3rem;
        flex-wrap: wrap;
        margin-bottom: .35rem;
    }

    .genre-book-tag {
        font-size: .6rem;
        font-weight: 800;
        padding: .1rem .45rem;
        border-radius: 6px;
        border: 1px solid;
    }

        .genre-book-tag.free {
            background: #f0fdf4;
            color: #15803d;
            border-color: #bbf7d0;
        }

        .genre-book-tag.premium {
            background: #fff7ed;
            color: #c2410c;
            border-color: #fed7aa;
        }

    .genre-book-reads {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        font-size: .62rem;
        font-weight: 700;
        color: var(--text-faint);
    }

        .genre-book-reads svg {
            width: 10px;
            height: 10px;
        }

    .genre-book-actions {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        flex-shrink: 0;
    }

    .btn-genre-read {
        font-size: .72rem;
        font-weight: 800;
        padding: .3rem .75rem;
        border-radius: 8px;
        background: var(--orange);
        color: #fff;
        text-decoration: none;
        text-align: center;
        white-space: nowrap;
        transition: background .18s, transform .15s;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        border: none;
        cursor: pointer;
        font-family: var(--font);
    }

        .btn-genre-read:hover {
            background: var(--orange-dark);
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-genre-read.locked {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

    .genre-empty {
        grid-column: 1/-1;
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--text-muted);
        font-weight: 600;
        font-size: .88rem;
    }

        .genre-empty svg {
            display: block;
            margin: 0 auto .75rem;
            opacity: .35;
        }

    /* ══════════════════════════════════════════
                       CTA SECTION
                    ══════════════════════════════════════════ */
    .section-cta {
        background: var(--cream);
    }

    .cta-card {
        background: linear-gradient(135deg, #1a1a2e 0%, #0f3460 60%, #16213e 100%);
        border-radius: var(--radius-xl);
        padding: 4rem 3rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .cta-card::before {
            content: '';
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(242,101,34,.15) 0%, transparent 65%);
            pointer-events: none;
        }

    .cta-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(242,101,34,.15);
        border: 1px solid rgba(242,101,34,.3);
        border-radius: 20px;
        padding: .22rem .85rem;
        font-size: .67rem;
        font-weight: 900;
        color: #fbb07a;
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: 1.25rem;
    }

        .cta-eyebrow svg {
            width: 11px;
            height: 11px;
        }

    .cta-title {
        font-size: clamp(1.6rem,3.5vw,2.6rem);
        font-weight: 900;
        color: #fff;
        line-height: 1.12;
        letter-spacing: -.03em;
        margin-bottom: .8rem;
    }

        .cta-title em {
            color: var(--orange);
            font-style: normal;
        }

    .cta-sub {
        font-size: 1rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        max-width: 500px;
        margin: 0 auto 2.25rem;
        line-height: 1.65;
    }

    .cta-btns {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-cta-primary {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: var(--orange);
        color: #fff;
        font-family: var(--font);
        font-weight: 900;
        font-size: .95rem;
        padding: .9rem 2.25rem;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 6px 28px rgba(242,101,34,.5);
        transition: background .18s, transform .18s;
    }

        .btn-cta-primary:hover {
            background: var(--orange-dark);
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-cta-primary svg {
            width: 16px;
            height: 16px;
        }

    .btn-cta-ghost {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.2);
        color: rgba(255,255,255,.8);
        font-family: var(--font);
        font-weight: 800;
        font-size: .9rem;
        padding: .85rem 1.75rem;
        border-radius: 50px;
        text-decoration: none;
        transition: background .18s;
    }

        .btn-cta-ghost:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

        .btn-cta-ghost svg {
            width: 14px;
            height: 14px;
        }

    /* ══════════════════════════════════════════
                       FOOTER
                    ══════════════════════════════════════════ */
    .re-footer {
        background: var(--navy);
        border-top: 1px solid rgba(255,255,255,.06);
        padding: 3rem 0 2rem;
    }

    .re-footer-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .re-footer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-bottom: 2.5rem;
    }

    .re-footer-brand-name {
        font-size: 1.3rem;
        font-weight: 900;
        color: #fff;
        letter-spacing: -.025em;
    }

        .re-footer-brand-name em {
            color: var(--orange);
            font-style: normal;
        }

    .re-footer-brand-sub {
        font-size: .75rem;
        font-weight: 600;
        color: rgba(255,255,255,.3);
        margin-top: .15rem;
    }

    .re-footer-links {
        display: flex;
        gap: 1.75rem;
        flex-wrap: wrap;
    }

        .re-footer-links a {
            font-size: .82rem;
            font-weight: 700;
            color: rgba(255,255,255,.4);
            text-decoration: none;
            transition: color .15s;
        }

            .re-footer-links a:hover {
                color: var(--orange);
            }

    .re-footer-bottom {
        border-top: 1px solid rgba(255,255,255,.07);
        padding-top: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-footer-copy {
        font-size: .75rem;
        font-weight: 600;
        color: rgba(255,255,255,.25);
    }

    .re-footer-socials {
        display: flex;
        gap: .65rem;
    }

    .footer-social {
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,.07);
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background .15s, border-color .15s;
    }

        .footer-social:hover {
            background: rgba(242,101,34,.2);
            border-color: rgba(242,101,34,.4);
        }

        .footer-social svg {
            width: 14px;
            height: 14px;
            color: rgba(255,255,255,.5);
        }

        .footer-social:hover svg {
            color: var(--orange);
        }

    /* ══════════════════════════════════════════
                       ANIMATIONS
                    ══════════════════════════════════════════ */
    .fade-up {
        animation: fadeUp .5s ease both;
    }

    .fade-up-1 {
        animation-delay: .1s;
    }

    .fade-up-2 {
        animation-delay: .2s;
    }

    .fade-up-3 {
        animation-delay: .3s;
    }

    .fade-up-4 {
        animation-delay: .4s;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(22px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* ══════════════════════════════════════════
                       RESPONSIVE
                    ══════════════════════════════════════════ */
    @@media (max-width: 991px) {
        .re-hero-visual {
            display: none;
        }

        .re-hero-inner {
            justify-content: center;
            text-align: center;
        }

        .re-hero-btns {
            justify-content: center;
        }

        .re-hero-trust {
            justify-content: center;
        }

        .re-hero-sub {
            margin-left: auto;
            margin-right: auto;
        }

        .spotlight-card {
            text-align: center;
            justify-content: center;
        }

        .spotlight-visual {
            justify-content: center;
        }

        .spotlight-stats {
            justify-content: center;
        }

        .btn-spotlight {
            margin: 0 auto;
            display: inline-flex;
        }
    }

    @@media (max-width: 767px) {
        .re-nav-links {
            display: none;
        }

        .re-section {
            padding: 3rem 0;
        }

        .re-section-title {
            font-size: 1.4rem;
        }

        .re-hero {
            padding: 4rem 0 3rem;
        }

        .cta-card {
            padding: 3rem 1.5rem;
        }
    }

    /* ══════════════════════════════════════════
                       HERO VISUAL (right side)
                    ══════════════════════════════════════════ */
    .re-hero-visual {
        flex-shrink: 0;
        width: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .hero-books-scene {
        position: relative;
        width: 340px;
        height: 340px;
    }

    /* Glow rings */
    .hero-glow-ring {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(242,101,34,.18);
        pointer-events: none;
        top: 50%;
        left: 50%;
    }

    .hero-glow-ring-1 { width: 180px; height: 180px; transform: translate(-50%,-50%); animation: ringPulse 3.5s ease-in-out infinite; }
    .hero-glow-ring-2 { width: 260px; height: 260px; transform: translate(-50%,-50%); animation: ringPulse 3.5s ease-in-out infinite .7s; }
    .hero-glow-ring-3 { width: 340px; height: 340px; transform: translate(-50%,-50%); animation: ringPulse 3.5s ease-in-out infinite 1.4s; }

    @@keyframes ringPulse {
        0%, 100% { opacity: .2; }
        50% { opacity: .5; }
    }

    /* Book stack */
    .hero-book-stack {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: flex-end;
        gap: .9rem;
    }

    .hbs-book {
        border-radius: 10px;
        position: relative;
        box-shadow: 0 24px 56px rgba(0,0,0,.45), inset 0 0 0 1px rgba(255,255,255,.12);
    }

        .hbs-book::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 9px;
            background: rgba(0,0,0,.22);
            border-radius: 10px 0 0 10px;
        }

        .hbs-book::after {
            content: '';
            position: absolute;
            left: 16px;
            top: 14px;
            right: 10px;
            height: 2px;
            background: rgba(255,255,255,.25);
            border-radius: 2px;
            box-shadow: 0 7px 0 rgba(255,255,255,.18), 0 14px 0 rgba(255,255,255,.12);
        }

    .hbs-1 { width: 78px; height: 114px; background: linear-gradient(160deg,#667eea,#764ba2); animation: hbsFloat1 5s ease-in-out infinite; }
    .hbs-2 { width: 90px; height: 132px; background: linear-gradient(160deg,#f26522,#e91e63); animation: hbsFloat2 5s ease-in-out infinite .9s; }
    .hbs-3 { width: 74px; height: 108px; background: linear-gradient(160deg,#43e97b,#38f9d7); animation: hbsFloat3 5s ease-in-out infinite 1.8s; }

    @@keyframes hbsFloat1 {
        0%, 100% { transform: rotate(-9deg) translateY(8px); }
        50% { transform: rotate(-9deg) translateY(-6px); }
    }

    @@keyframes hbsFloat2 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-14px); }
    }

    @@keyframes hbsFloat3 {
        0%, 100% { transform: rotate(7deg) translateY(6px); }
        50% { transform: rotate(7deg) translateY(-6px); }
    }

    /* Floating info badges */
    .hero-badge {
        position: absolute;
        background: rgba(255,255,255,.1);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 14px;
        padding: .65rem 1rem;
        display: flex;
        align-items: center;
        gap: .55rem;
    }

    .hero-badge-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .hero-badge-icon svg {
            width: 16px;
            height: 16px;
        }

    .hero-badge-text {
        font-size: .78rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.2;
        white-space: nowrap;
    }

    .hero-badge-sub {
        font-size: .63rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        white-space: nowrap;
    }

    .hero-badge-1 {
        top: 24px;
        right: 10px;
        animation: badgeFloat1 4.5s ease-in-out infinite;
    }

    .hero-badge-2 {
        bottom: 50px;
        left: 5px;
        animation: badgeFloat2 4.5s ease-in-out infinite 1.5s;
    }

    .hero-badge-3 {
        top: 50%;
        right: -20px;
        animation: badgeFloat3 4.5s ease-in-out infinite 3s;
    }

    @@keyframes badgeFloat1 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    @@keyframes badgeFloat2 {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }

    @@keyframes badgeFloat3 {
        0%, 100% { transform: translateY(-50%); }
        50% { transform: translateY(calc(-50% - 8px)); }
    }

    /* ══════════════════════════════════════════
                       FEATURES SECTION
                    ══════════════════════════════════════════ */
    .section-features {
        background: linear-gradient(180deg, #fff 0%, var(--cream) 100%);
    }

    .re-section-head-center {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    @@media (max-width: 900px) {
        .features-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 560px) {
        .features-grid {
            grid-template-columns: 1fr;
        }
    }

    .feature-card {
        background: #fff;
        border: 1.5px solid var(--cream-border);
        border-radius: var(--radius-lg);
        padding: 1.75rem 1.5rem 1.5rem;
        position: relative;
        overflow: hidden;
        transition: transform .28s cubic-bezier(.34,1.56,.64,1), box-shadow .28s, border-color .2s;
        box-shadow: var(--shadow-card);
    }

        .feature-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 3px 3px 0 0;
            opacity: 0;
            transition: opacity .2s;
        }

        .feature-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--shadow-hover);
            border-color: var(--orange);
        }

        .feature-card:hover::after {
            opacity: 1;
            background: var(--orange);
        }

    .feature-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.1rem;
    }

        .feature-card-icon svg {
            width: 24px;
            height: 24px;
        }

    .feature-card-title {
        font-size: 1rem;
        font-weight: 900;
        color: var(--navy);
