<section class="re-section section-genres" id="genres">
    <div class="re-section-inner">
        <div class="re-section-head">
            <div>
                <div class="re-section-eyebrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                    Explore by Category
                </div>
                <div class="re-section-title">Browse <em>Genres</em></div>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-2">
            @{
                // Color + icon palette — cycles by index for visual variety
                var genreStyles = new[] {
                        new { Color="#667eea", Bg="#eef0fd", Icon="<path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/>" },
                        new { Color="#4facfe", Bg="#e8f5fe", Icon="<circle cx='12' cy='12' r='10'/><line x1='2' y1='12' x2='22' y2='12'/><path d='M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z'/>" },
                        new { Color="#f5576c", Bg="#fdeef0", Icon="<path d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/>" },
                        new { Color="#f26522", Bg="#fff3ed", Icon="<polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'/>" },
                        new { Color="#43e97b", Bg="#eafbf1", Icon="<path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/>" },
                        new { Color="#764ba2", Bg="#f3eef8", Icon="<circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/>" },
                        };
            }
            @if (!Model.Genres.Any())
            {
                <div class="col-12">
                    <p style="color:var(--text-muted);font-size:.88rem;font-weight:600;">No categories found yet.</p>
                </div>
            }
            @{
                int gIdx = 0;
            }
            @foreach (var g in Model.Genres)
            {
                var style = genreStyles[gIdx % genreStyles.Length];
                gIdx++;
                // Serialize books for this genre as JSON for client-side rendering
                var genreBooks = Model.AllBooks
                .Where(b => !string.IsNullOrWhiteSpace(b.Category) &&
                    b.Category.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                              .Any(tag => string.Equals(tag.Trim(), g.Name, StringComparison.OrdinalIgnoreCase)))
                .GroupBy(b => b.Id)
                .Select(grp => grp.First())
                .ToList();

                var booksJson = System.Text.Json.JsonSerializer.Serialize(genreBooks.Select(b => new
                {
                    id = b.Id,
                    title = b.Title,
                    author = b.Author,
                    cover = b.CoverImage ?? "",
                    isFree = b.IsFree,
                    readCount = b.ReadCount,
                    category = b.Category,
                    rating = b.AverageRating,
                    description = ""
                }));

                <div class="col">
                    <div class="genre-pill genre-pill-clickable"
                         data-genre="@g.Name"
                         data-color="@style.Color"
                         data-bg="@style.Bg"
                         data-books="@Html.Raw(System.Web.HttpUtility.HtmlAttributeEncode(booksJson))"
                         onclick="toggleGenrePanel(this)"
                         role="button"
                         tabindex="0"
                         onkeydown="if(event.key==='Enter'||event.key===' ')toggleGenrePanel(this)">
                        <div class="genre-icon" style="background:@style.Bg;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="@style.Color" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(style.Icon)</svg>
                        </div>
                        <div>
                            <div class="genre-name">@g.Name</div>
                            <div class="genre-count">@g.Count book@(g.Count != 1 ? "s" : "")</div>
                        </div>
                        <svg class="genre-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                    </div>
                </div>
            }
        </div>

        <!-- ── Inline Genre Book Panel ── -->
        <div id="genre-panel" class="genre-panel" style="display:none;" aria-live="polite">
            <div class="genre-panel-header">
                <div class="genre-panel-title">
                    <div class="genre-panel-icon" id="genre-panel-icon"></div>
                    <div>
                        <div class="genre-panel-eyebrow">Browsing Genre</div>
                        <div class="genre-panel-name" id="genre-panel-name"></div>
                    </div>
                </div>
                <button class="genre-panel-close" onclick="closeGenrePanel()" title="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                </button>
            </div>
            <div class="genre-panel-note">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;flex-shrink:0;"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                You're browsing as a guest. Free books are available to read now — <a href="/Auth/Login" style="color:var(--orange);font-weight:800;">log in</a> to unlock Premium titles.
            </div>
            <div id="genre-books-grid" class="genre-books-grid"></div>
        </div>
    </div>
</section>

