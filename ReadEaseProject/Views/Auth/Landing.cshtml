<!-- ═══════════════════ TOP RATED ═══════════════════ -->
<section class="re-section section-rated" id="rated">
    <div class="re-section-inner">
        <div class="re-section-head">
            <div>
                <div class="re-section-eyebrow">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                    Best of ReadEase
                </div>
                <div class="re-section-title">Top <em>Rated</em> Books</div>
                <div class="re-section-sub">Handpicked favorites with the highest community ratings</div>
            </div>
            <a asp-controller="Library" asp-action="Index" class="re-view-all">
                View All
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6" /></svg>
            </a>
        </div>
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
            @if (!Model.TopRated.Any())
            {
                <div class="col-12">
                    <p style="color:var(--text-muted);font-weight:600;font-size:.88rem;">No rated books yet — be the first to rate one!</p>
                </div>
            }
            @{
                int rIdx = 0;
            }
            @foreach (var b in Model.TopRated)
            {
                int rank = rIdx + 1;
                string grad = gradients[rIdx % gradients.Length];
                string rClass = rank <= 3 ? rankClass[rank - 1] : "";
                rIdx++;
                <div class="col fade-up">
                    <div class="book-card" onclick="window.location='@Url.Action("Detail", "Library", new { id = b.Id })'">
                        <div class="book-cover-wrap">
                            @if (!string.IsNullOrEmpty(b.CoverImage))
                            {
                                <img src="@b.CoverImage" class="book-cover" alt="@b.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="book-cover-ph" style="background:@grad">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                                </div>
                            }
                            <div class="book-rank @rClass">@rank</div>
                            <span class="book-badge @(b.IsFree ? "free" : "premium")">@(b.IsFree ? "Free" : "Premium")</span>
                        </div>
                        <div class="book-body">
                            <div class="book-genre-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                                @(b.Category?.Split(',').FirstOrDefault()?.Trim() ?? b.Category)
                            </div>
                            <div class="star-row">
                                @Html.Raw(StarsSvg(b.AverageRating))
                                <span class="star-val">@FmtRating(b.AverageRating)</span>
                            </div>
                            <div class="book-title">@b.Title</div>
                            <div class="book-author">@b.Author</div>
                        </div>

                        <div class="book-foot">
                            <div class="book-views">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                @FmtViews(b.ReadCount)
                            </div>
                            @if (b.IsFree)
                            {
                                <a asp-controller="Landing" asp-action="GuestRead" asp-route-id="@b.Id" class="btn-book-read" onclick="event.stopPropagation()">
                                    Read
