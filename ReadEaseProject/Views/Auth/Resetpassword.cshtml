@model ReadEase.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body > nav, footer, .re-main > .container {
        display: none !important;
    }

    .re-main {
        padding: 0 !important;
        max-width: 100% !important;
    }

    .wp-page {
        min-height: 100vh;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        font-family: 'Nunito', sans-serif;
        padding: 2rem 1rem;
    }

    /* ── BLOBS ── */
    .blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
    }

    .blob-tl {
        width: 280px;
        height: 580px;
        top: -160px;
        left: -110px;
        border-radius: 38% 62% 55% 45% / 42% 38% 62% 58%;
        animation: morph1 9s ease-in-out infinite;
    }

    .blob-br {
        width: 260px;
        height: 520px;
        bottom: -160px;
        right: -100px;
        border-radius: 55% 45% 38% 62% / 60% 42% 58% 40%;
        animation: morph2 11s ease-in-out infinite;
    }

    @@keyframes morph1 {
        0%, 100% {
            border-radius: 38% 62% 55% 45% / 42% 38% 62% 58%;
        }

        33% {
            border-radius: 55% 45% 40% 60% / 55% 45% 58% 42%;
        }

        66% {
            border-radius: 45% 55% 62% 38% / 40% 58% 42% 60%;
        }
    }

    @@keyframes morph2 {
        0%, 100% {
            border-radius: 55% 45% 38% 62% / 60% 42% 58% 40%;
        }

        33% {
            border-radius: 40% 60% 58% 42% / 45% 55% 40% 60%;
        }

        66% {
            border-radius: 62% 38% 45% 55% / 55% 45% 62% 38%;
        }
    }

    /* ── CARD ── */
    .wp-card {
        position: relative;
        z-index: 1;
        background: #fff;
        border-radius: 24px;
        padding: 2.75rem 2.5rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 70px rgba(0,0,0,.12);
        border: 1px solid #f0ece6;
        animation: cardIn .4s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes cardIn {
        from {
            opacity: 0;
            transform: translateY(20px) scale(.97);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    /* Brand */
    .brand-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .6rem;
        margin-bottom: 2rem;
    }

    .brand-book {
        width: 32px;
        height: 38px;
        background: #f26522;
        border-radius: 3px 5px 5px 3px;
        position: relative;
        box-shadow: 0 3px 12px rgba(242,101,34,.38);
        flex-shrink: 0;
    }

        .brand-book::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 0;
            bottom: 0;
            width: 2.5px;
            background: rgba(0,0,0,.18);
        }

        .brand-book::after {
            content: '';
            position: absolute;
            left: 12px;
            top: 9px;
            width: 12px;
            height: 11px;
            background: linear-gradient(#fff,#fff) 0 0 / 12px 2px no-repeat, linear-gradient(#fff,#fff) 0 4.5px / 12px 2px no-repeat, linear-gradient(#fff,#fff) 0 9px / 8px 2px no-repeat;
            opacity: .88;
        }

    .brand-name {
        font-size: 1.45rem;
        font-weight: 900;
        color: #1a1a2e;
        letter-spacing: -.025em;
        line-height: 1;
    }

        .brand-name em {
            color: #f26522;
            font-style: normal;
        }

    /* Icon circle */
    .icon-circle {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fff3ed, #ffdcc4);
        border: 3px solid rgba(242,101,34,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #f26522;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 18px rgba(242,101,34,.15);
        animation: pulseGlow 3s ease-in-out infinite;
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 4px 18px rgba(242,101,34,.15);
        }

        50% {
            box-shadow: 0 4px 28px rgba(242,101,34,.32);
        }
    }

    .wp-card-title {
        font-size: 1.55rem;
        font-weight: 900;
        color: #1a1a2e;
        text-align: center;
        margin-bottom: .4rem;
        letter-spacing: -.02em;
    }

    .wp-card-sub {
        font-size: .88rem;
        color: #9994a8;
        font-weight: 600;
        text-align: center;
        margin-bottom: 1.75rem;
        line-height: 1.55;
    }

    /* Fields */
    .wp-label {
        font-size: .74rem;
        font-weight: 800;
        color: #4a4660;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: .38rem;
        display: block;
    }

    .wp-input {
        width: 100%;
        border: 1.5px solid #e0dbd3;
        border-radius: 10px;
        padding: .68rem 1rem;
        font-size: .9rem;
        font-family: 'Nunito', sans-serif;
        background: #fff;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

        .wp-input:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.13);
        }

    .pw-wrap {
        position: relative;
    }

        .pw-wrap .wp-input {
            padding-right: 3.5rem;
        }

    /* Kill ALL browser-native password icons */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="password"]::-webkit-contacts-auto-fill-button,
    input[type="password"]::-webkit-credentials-auto-fill-button,
    input[type="text"]::-webkit-contacts-auto-fill-button,
    input[type="text"]::-webkit-credentials-auto-fill-button {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
        width: 0 !important;
        height: 0 !important;
    }

    /* Strength bar */
    .strength-bar-wrap {
        display: flex;
        gap: .3rem;
        margin-top: .5rem;
    }

    .strength-seg {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: #e8e3dc;
        transition: background .3s;
    }

    .strength-label {
        font-size: .72rem;
        font-weight: 700;
        margin-top: .3rem;
    }

    /* Submit */
    .btn-wp-submit {
        width: 100%;
        padding: .82rem 1rem;
        border-radius: 50px;
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 800;
        background: #f26522;
        color: #fff;
        border: none;
        cursor: pointer;
        transition: background .2s, transform .15s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(242,101,34,.3);
        margin-top: .25rem;
    }

        .btn-wp-submit:hover {
            background: #d9541a;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(242,101,34,.4);
        }

    /* Password match indicator */
    #pwMatchMsg {
        font-size: .78rem;
        font-weight: 700;
        margin-top: .35rem;
    }

    /* Back link */
    .back-link {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin-top: 1.4rem;
        font-size: .88rem;
        font-weight: 700;
        color: #9994a8;
        text-decoration: none;
        transition: color .18s;
    }

        .back-link:hover {
            color: #1a1a2e;
        }

        .back-link .arrow {
            font-size: 1rem;
            transition: transform .18s;
        }

        .back-link:hover .arrow {
            transform: translateX(-3px);
        }

    /* Alert */
    .wp-alert {
        border-radius: 10px;
        padding: .65rem 1rem;
        font-size: .85rem;
        font-weight: 600;
        margin-bottom: 1rem;
    }

    /* Success state */
    .success-state {
        text-align: center;
        animation: cardIn .4s ease both;
    }

    .success-icon {
        font-size: 3.5rem;
        margin-bottom: .75rem;
        display: block;
        animation: bounceIn .5s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes bounceIn {
        from {
            transform: scale(0);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .success-title {
        font-size: 1.35rem;
        font-weight: 900;
        color: #1a1a2e;
        margin-bottom: .5rem;
    }

    .success-sub {
        font-size: .88rem;
        color: #6b6878;
        font-weight: 600;
        line-height: 1.55;
        margin-bottom: 1.5rem;
    }

    .btn-wp-login {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .78rem 2rem;
        border-radius: 50px;
        font-family: 'Nunito', sans-serif;
        font-size: .93rem;
        font-weight: 800;
        background: #1a1a2e;
        color: #fff;
        text-decoration: none;
        transition: background .2s, transform .15s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(26,26,46,.22);
    }

        .btn-wp-login:hover {
            background: #0d0d1e;
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(26,26,46,.3);
            color: #fff;
        }

    @@media (max-width: 480px) {
        .wp-card {
            padding: 2rem 1.5rem;
        }
    }
</style>

<div class="wp-page">
    <div class="blob blob-tl"></div>
    <div class="blob blob-br"></div>

    <div class="wp-card">
        <!-- Brand -->
        <div class="brand-row">
            <div class="brand-book"></div>
            <div class="brand-name">Read<em>Ease</em></div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-state">
                <span class="success-icon">🎉</span>
                <div class="success-title">Password Reset!</div>
                <p class="success-sub">
                    Your password has been updated successfully.<br>
                    You can now log in with your new password.
                </p>
                <a asp-action="Login" class="btn-wp-login">Go to Login →</a>
            </div>
        }
        else
        {
            <div class="icon-circle">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h1 class="wp-card-title">Set New Password</h1>
            <p class="wp-card-sub">Choose a strong password to protect your account.</p>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger wp-alert"></div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label class="wp-label">New Password</label>
                    <div class="pw-wrap">
                        <input asp-for="NewPassword" type="password" class="wp-input" id="pwNew"
                               placeholder="Min 6 characters" autocomplete="new-password" autofocus />
                        <input type="checkbox" id="pwNewCheck"
                               onchange="this.previousElementSibling.type=this.checked?'text':'password';this.nextElementSibling.textContent=this.checked?'Hide':'Show'"
                               style="position:absolute;opacity:0;width:0;height:0;pointer-events:none;" />
                        <label for="pwNewCheck"
                               style="position:absolute!important;right:.85rem!important;top:50%!important;
                                          transform:translateY(-50%)!important;cursor:pointer!important;
                                          font-size:.75rem!important;font-weight:800!important;color:#888!important;
                                          font-family:'Nunito',sans-serif!important;background:#fff!important;
                                          padding:2px 6px!important;border-radius:4px!important;
                                          z-index:9999!important;user-select:none!important;line-height:1!important;
                                          display:block!important;visibility:visible!important;">Show</label>
                    </div>
                    <!-- Strength bar -->
                    <div class="strength-bar-wrap" id="strengthBar">
                        <div class="strength-seg" id="seg1"></div>
                        <div class="strength-seg" id="seg2"></div>
                        <div class="strength-seg" id="seg3"></div>
                        <div class="strength-seg" id="seg4"></div>
                    </div>
                    <div class="strength-label" id="strengthLabel" style="color:#9994a8;"></div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="wp-label">Confirm Password</label>
                    <div class="pw-wrap">
                        <input asp-for="ConfirmPassword" type="password" class="wp-input" id="pwConfirm"
                               placeholder="Repeat your password" autocomplete="new-password" />
                        <input type="checkbox" id="pwConfCheck"
                               onchange="this.previousElementSibling.type=this.checked?'text':'password';this.nextElementSibling.textContent=this.checked?'Hide':'Show'"
                               style="position:absolute;opacity:0;width:0;height:0;pointer-events:none;" />
                        <label for="pwConfCheck"
                               style="position:absolute!important;right:.85rem!important;top:50%!important;
                                          transform:translateY(-50%)!important;cursor:pointer!important;
                                          font-size:.75rem!important;font-weight:800!important;color:#888!important;
                                          font-family:'Nunito',sans-serif!important;background:#fff!important;
                                          padding:2px 6px!important;border-radius:4px!important;
                                          z-index:9999!important;user-select:none!important;line-height:1!important;
                                          display:block!important;visibility:visible!important;">Show</label>
                    </div>
                    <div id="pwMatchMsg"></div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-wp-submit">Reset Password →</button>
            </form>

            <a asp-action="Login" class="back-link">
                <span class="arrow">←</span> Back to Login
            </a>
        }
    </div>
</div>

@section Scripts {
    <script>
        const pwNew    = document.getElementById('pwNew');
        const pwConf   = document.getElementById('pwConfirm');
        const matchMsg = document.getElementById('pwMatchMsg');
        const segs     = [document.getElementById('seg1'), document.getElementById('seg2'),
                          document.getElementById('seg3'), document.getElementById('seg4')];
        const lbl      = document.getElementById('strengthLabel');

        const colors = ['#ef4444','#f97316','#eab308','#22c55e'];
        const labels = ['Weak','Fair','Good','Strong'];

        function getStrength(v) {
            let s = 0;
            if (v.length >= 6)  s++;
            if (v.length >= 10) s++;
            if (/[A-Z]/.test(v) && /[0-9]/.test(v)) s++;
            if (/[^A-Za-z0-9]/.test(v)) s++;
            return s; // 0–4
        }

        pwNew.addEventListener('input', function () {
            const v = this.value;
            if (!v) { segs.forEach(s => s.style.background = ''); lbl.textContent = ''; return; }
            const strength = getStrength(v);
            segs.forEach((s, i) => {
                s.style.background = i < strength ? colors[strength - 1] : '#e8e3dc';
            });
            lbl.textContent = labels[strength - 1] || '';
            lbl.style.color = strength > 0 ? colors[strength - 1] : '#9994a8';
            checkMatch();
        });

        function checkMatch() {
            if (!pwConf.value) { matchMsg.textContent = ''; pwConf.style.borderColor = ''; return; }
            const ok = pwNew.value === pwConf.value;
            matchMsg.style.color      = ok ? '#16a34a' : '#dc2626';
            matchMsg.textContent      = ok ? '✅ Passwords match' : '❌ Passwords do not match';
            pwConf.style.borderColor  = ok ? '#16a34a' : '#dc2626';
        }

        pwConf.addEventListener('input', checkMatch);
    </script>
}
