@model ReadEase.ViewModels.Library.ReadingProgressViewModel
@{
    ViewData["Title"] = "Ongoing Reads";
    Layout = "~/Views/Shared/_Layout.cshtml";

    const string IcoBook = "<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 24 24' fill='none' stroke='rgba(255,255,255,0.75)' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/></svg>";
    const string IcoBookOr = "<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='#f26522' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M4 19.5A2.5 2.5 0 0 1 6.5 17H20'/><path d='M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z'/></svg>";
    const string IcoInbox = "<svg xmlns='http://www.w3.org/2000/svg' width='52' height='52' viewBox='0 0 24 24' fill='none' stroke='#f26522' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'><polyline points='22 12 16 12 14 15 10 15 8 12 2 12'/><path d='M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z'/></svg>";
    const string IcoChevL = "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='15 18 9 12 15 6'/></svg>";
    const string IcoChevR = "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='9 18 15 12 9 6'/></svg>";
    const string IcoCalendar = "<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'/><line x1='16' y1='2' x2='16' y2='6'/><line x1='8' y1='2' x2='8' y2='6'/><line x1='3' y1='10' x2='21' y2='10'/></svg>";
}

<style>
    .lib-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
    }

    .lib-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobMorph1 9s ease-in-out infinite;
        opacity: .07;
    }

    .lib-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobMorph2 11s ease-in-out infinite;
        opacity: .07;
    }

    @@keyframes blobMorph1 {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobMorph2 {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    @@media(max-width:768px) {
        .lib-blob-tl, .lib-blob-br {
            display: none
        }
    }

    .sec-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.1rem;
        position: relative;
        z-index: 2;
    }

    .sec-bar-title {
        font-family: 'Nunito',sans-serif;
        font-weight: 900;
        font-size: 1.2rem;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .sec-bar-badge {
        font-size: .67rem;
        font-weight: 800;
        background: #fff3ed;
        color: #f26522;
        padding: .15rem .55rem;
        border-radius: 20px;
        border: 1px solid #fcd9c3;
        margin-left: .3rem;
    }

    .rp-tabs {
        display: flex;
        gap: .5rem;
        margin-bottom: 1.8rem;
        position: relative;
        z-index: 2;
        flex-wrap: wrap;
    }

    .rp-tab {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-family: 'Nunito',sans-serif;
        font-weight: 800;
        font-size: .83rem;
        padding: .5rem 1.2rem;
        border-radius: 50px;
        text-decoration: none;
        border: 1.5px solid rgba(0,0,0,.1);
        transition: all .18s;
    }

        .rp-tab.active {
            background: #f26522;
            color: #fff;
            border-color: #f26522;
            box-shadow: 0 4px 14px rgba(242,101,34,.35);
        }

        .rp-tab:not(.active) {
            background: #fff;
            color: #1a1a2e;
        }

            .rp-tab:not(.active):hover {
                border-color: #f26522;
                color: #f26522;
            }

    .rp-tab-badge {
        font-size: .65rem;
        font-weight: 900;
        padding: .1rem .4rem;
        border-radius: 20px;
        min-width: 18px;
        text-align: center;
    }

    .rp-tab.active .rp-tab-badge {
        background: rgba(255,255,255,.3);
        color: #fff;
    }

    .rp-tab:not(.active) .rp-tab-badge {
        background: rgba(255,97,34,.12);
        color: #f26522;
    }

    .carousel-outer {
        position: relative;
        margin-bottom: 2.75rem;
        z-index: 2;
    }

    .book-rail {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: .3rem .15rem 1rem;
        scrollbar-width: none;
    }

        .book-rail::-webkit-scrollbar {
            display: none;
        }

    .bk-card {
        flex: 0 0 152px;
        width: 152px;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #ede8e0;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
        transition: transform .25s cubic-bezier(.34,1.56,.64,1),box-shadow .25s,border-color .2s;
        position: relative;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

        .bk-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0,0,0,.16);
            border-color: #f26522;
        }

    .bk-cover {
        width: 100%;
        height: 196px;
        object-fit: cover;
        display: block;
        transition: transform .35s;
    }

    .bk-card:hover .bk-cover {
        transform: scale(1.06);
    }

    .bk-cover-ph {
        width: 100%;
        height: 196px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bk-status-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(242,101,34,.9);
        color: #fff;
        font-size: .58rem;
        font-weight: 800;
        padding: .18rem .52rem;
        border-radius: 6px;
        backdrop-filter: blur(6px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .bk-body {
        padding: .65rem .75rem .3rem;
        flex: 1;
    }

    .bk-cat {
        display: flex;
        flex-wrap: wrap;
        gap: .2rem;
        margin-bottom: .25rem;
    }

    .bk-tag {
        font-family: 'Nunito',sans-serif;
        font-size: .58rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #f26522;
        background: #fff3ed;
        border: 1px solid #fcd9c3;
        padding: .1rem .4rem;
        border-radius: 20px;
        white-space: nowrap;
    }

    .genre-section-label {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        background: linear-gradient(135deg, #fff3ed, #fff);
        border: 1.5px solid #fcd9c3;
        border-radius: 50px;
        padding: .28rem .9rem .28rem .55rem;
        font-family: 'Nunito',sans-serif;
        font-weight: 900;
        font-size: .88rem;
        color: #1a1a2e;
        box-shadow: 0 2px 8px rgba(242,101,34,.1);
    }

    .bk-title {
        font-family: 'Nunito',sans-serif;
        font-size: .8rem;
        font-weight: 800;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        color: #1a1a2e;
        margin-bottom: .15rem;
    }

    .bk-author {
        font-size: .67rem;
        color: #6b6878;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: .2rem;
    }

    .bk-reads-pill {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        background: #fff3ed;
        border: 1px solid #fcd9c3;
        border-radius: 20px;
        padding: .12rem .55rem;
        font-size: .62rem;
        font-weight: 800;
        color: #c2410c;
        margin-top: .1rem;
    }

    .bk-actions {
        display: flex;
        gap: .35rem;
        padding: .5rem .75rem .7rem;
    }

    .btn-bk-read {
        flex: 1;
        font-family: 'Nunito',sans-serif;
        font-size: .72rem;
        font-weight: 800;
        padding: .32rem .4rem;
        border-radius: 8px;
        background: #f26522;
        border: none;
        color: #fff;
        transition: background .18s,transform .15s;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        box-shadow: 0 2px 8px rgba(242,101,34,.25);
    }

        .btn-bk-read:hover {
            background: #d9541a;
            color: #fff;
            transform: translateY(-1px);
        }

    .rail-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-75%);
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #fff;
        border: 1.5px solid #ede8e0;
        box-shadow: 0 4px 16px rgba(0,0,0,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        cursor: pointer;
        transition: all .2s cubic-bezier(.34,1.56,.64,1);
        padding: 0;
        color: #1a1a2e;
    }

        .rail-arrow:hover {
            background: #f26522;
            border-color: #f26522;
            box-shadow: 0 6px 22px rgba(242,101,34,.4);
            transform: translateY(-75%) scale(1.15);
        }

            .rail-arrow:hover svg {
                stroke: #fff;
            }

        .rail-arrow.prev {
            left: -17px;
        }

        .rail-arrow.next {
            right: -17px;
        }

    .lib-empty {
        text-align: center;
        padding: 5rem 2rem;
        position: relative;
        z-index: 2;
    }

        .lib-empty .empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem;
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: #fff3ed;
            animation: floatIcon 3s ease-in-out infinite;
        }

    @@keyframes floatIcon {
        0%, 100% {
            transform: translateY(0)
        }

        50% {
            transform: translateY(-10px)
        }
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    @@media(max-width:768px) {
        .rail-arrow {
            display: none
        }

        .bk-card {
            flex: 0 0 132px;
            width: 132px
        }

        .bk-cover, .bk-cover-ph {
            height: 172px
        }
    }
</style>

<div class="lib-blob lib-blob-tl"></div>
<div class="lib-blob lib-blob-br"></div>

<div class="rp-tabs fade-up">
    <a class="rp-tab active" asp-controller="Library" asp-action="Ongoing">
        Ongoing
        <span class="rp-tab-badge">@Model.OngoingCount</span>
    </a>
    <a class="rp-tab" asp-controller="Library" asp-action="Completed">
        Completed
        <span class="rp-tab-badge">@Model.CompletedCount</span>
    </a>
</div>

@if (!Model.Books.Any())
{
    <div class="lib-empty">
        <div class="empty-icon">@Html.Raw(IcoInbox)</div>
        <h4 style="font-family:'Nunito',sans-serif;font-weight:900;color:#1a1a2e;">No ongoing reads yet</h4>
        <p style="color:#6b6878;">Open a book from the library to start tracking your progress.</p>
        <a asp-controller="Library" asp-action="Index"
           style="display:inline-flex;align-items:center;gap:.4rem;background:#f26522;color:#fff;font-family:'Nunito',sans-serif;font-weight:800;font-size:.88rem;padding:.65rem 1.5rem;border-radius:50px;text-decoration:none;box-shadow:0 4px 16px rgba(242,101,34,.35);margin-top:.5rem;">
            Browse Library →
        </a>
    </div>
}
else
{
    var grouped = Model.Books
        .GroupBy(b => (b.Category ?? "Unknown")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .FirstOrDefault()?.Trim() ?? "Unknown")
        .OrderBy(g => g.Key)
        .ToList();
    int ridx = 0;
    foreach (var group in grouped)
    {
        var cid = string.Format("rail-og{0}", ridx++);
        <div class="fade-up">
            <div class="sec-bar">
                <div class="sec-bar-title">
                    <span class="genre-section-label">
                        @Html.Raw(IcoBookOr)
                        @group.Key
                        <span class="sec-bar-badge">@group.Count()</span>
                    </span>
                </div>
            </div>
            <div class="carousel-outer">
                <button class="rail-arrow prev" onclick="scrollRail('@cid',-1)">@Html.Raw(IcoChevL)</button>
                <div class="book-rail" id="@cid">
                    @foreach (var b in group.OrderByDescending(x => x.ReadAt))
                    {
                        <div class="bk-card"
                             onclick="window.location='@Url.Action("Read", "Library", new { id = b.Id })'">
                            <span class="bk-status-badge">Ongoing</span>
                            @if (!string.IsNullOrEmpty(b.CoverImage))
                            {
                                <img src="@b.CoverImage" class="bk-cover" alt="@b.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="bk-cover-ph" style="background:linear-gradient(135deg,#667eea,#764ba2);">@Html.Raw(IcoBook)</div>
                            }
                            <div class="bk-body">
                                <div class="bk-cat">
                                    @foreach (var t in (b.Category ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2))
                                    {
                                        <span class="bk-tag">@t.Trim()</span>
                                    }
                                </div>
                                <p class="bk-title">@b.Title</p>
                                <p class="bk-author">by @b.Author</p>
                                <span class="bk-reads-pill" title="Started reading">
                                    @Html.Raw(IcoCalendar) @b.ReadAt.ToString("MMM d")
                                </span>
                            </div>
                            <div class="bk-actions">
                                <a asp-controller="Library" asp-action="Read" asp-route-id="@b.Id"
                                   class="btn-bk-read" onclick="event.stopPropagation()">Continue →</a>
                            </div>
                        </div>
                    }
                </div>
                <button class="rail-arrow next" onclick="scrollRail('@cid',1)">@Html.Raw(IcoChevR)</button>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        function scrollRail(id, dir) {
            const el = document.getElementById(id);
            if (el) el.scrollBy({ left: dir * 540, behavior: 'smooth' });
        }
    </script>
}
