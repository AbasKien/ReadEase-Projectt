@* ═══════════════════ CATEGORY PAGE ═══════════════════ *@
@if (isCategoryPage)
{
    <div class="cat-hero fade-up">
        <div class="cat-hero-bg"></div>
        <div class="cat-hero-inner">
            <span class="cat-hero-badge">
                @Html.Raw(IcoBadgeBook)
                Genre
            </span>
            <h1 class="cat-hero-title">@Model.SelectedCategory Stories</h1>
            <div class="cat-hero-count">@Model.Books.Count().ToString("N0") stories</div>
        </div>
    </div>
   

    <div class="list-bar fade-up">
        <div class="list-count">@Model.Books.Count().ToString("N0") Stories</div>
        
    </div>

    @if (!Model.Books.Any())
    {
        <div class="lib-empty">
            <div class="empty-icon">@Html.Raw(IcoInbox)</div>
            <h4 style="font-family:'Nunito',sans-serif;font-weight:900;color:#1a1a2e;">No @Model.SelectedCategory books yet</h4>
            <p style="color:#6b6878;">Authors haven't published in this category yet.</p>
        </div>
    }
    else
    {
        <div class="book-list-row fade-up">
            @{
                var sortedBooks = Model.Books.OrderByDescending(b => b.ReadCount).ToList();
                for (int ri = 0; ri < sortedBooks.Count; ri++)
                {
                    var book = sortedBooks[ri];
                    bool canRead = book.IsFree || Model.IsSubscribed;
                    bool premLocked = !book.IsFree && !Model.IsSubscribed;
                    int rankNo = ri + 1;
                    <div class="book-list-item"
                         onclick="window.location='@Url.Action("Detail", "Library", new { id = book.Id })'">
                        <span class="book-list-num @(rankNo <= 3 ? "top3" : "")">@rankNo</span>
                        @if (!string.IsNullOrEmpty(book.CoverImage))
                        {
                            <img src="@book.CoverImage" class="book-list-cover" alt="@book.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="book-list-cover-ph">@Html.Raw(IcoBookSm)</div>
                        }
                        <div class="book-list-info">
                            <div class="book-list-title">@book.Title</div>
                            <div class="book-list-author">@book.Author</div>
                            <div class="book-list-tags">
                                <span class="book-tag">@book.Category.ToLower()</span>
                                @if (!book.IsFree)
                                {
                                    <span class="book-tag" style="background:#fff7ed;color:#c2410c;border-color:#fed7aa;">premium</span>
                                }
                                else
                                {
                                    <span class="book-tag" style="background:#f0fdf4;color:#15803d;border-color:#bbf7d0;">free</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(book.Description))
                            {
                                <div class="book-list-desc">@book.Description</div>
                            }
                            <div class="book-list-meta">
                                <span class="reads-pill"
                                      data-book-id="@book.Id.ToString()"
                                      title="@book.ReadCount.ToString("N0") unique readers">
                                    @Html.Raw(IcoEye)
                                    <span class="reads-count-val" data-raw="@book.ReadCount">@FormatReads(book.ReadCount)</span>
                                    readers
                                </span>
                                @if (premLocked)
                                {
                                    <span style="color:#d97706;font-weight:800;font-size:.72rem;display:inline-flex;align-items:center;gap:3px;">
                                        @Html.Raw(IcoStarAmb) Premium
                                    </span>
                                }
                                <button class="btn-bk-fav fav-btn ms-auto" data-id="@book.Id.ToString()"
                                        onclick="event.stopPropagation()">
                                    @Html.Raw(book.IsFavorite ? IcoHrtFill : IcoHrtLine)
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
}

