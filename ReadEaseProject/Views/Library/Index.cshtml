<style>
    .lib-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
    }

    .lib-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45% / 42% 38% 62% 58%;
        animation: blobMorph1 9s ease-in-out infinite;
        opacity: .07;
    }

    .lib-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62% / 60% 42% 58% 40%;
        animation: blobMorph2 11s ease-in-out infinite;
        opacity: .07;
    }

    @@keyframes blobMorph1 {
        0%, 100% {
            border-radius: 38% 62% 55% 45% / 42% 38% 62% 58%;
        }

        33% {
            border-radius: 55% 45% 40% 60% / 55% 45% 58% 42%;
        }

        66% {
            border-radius: 45% 55% 62% 38% / 40% 58% 42% 60%;
        }
    }

    @@keyframes blobMorph2 {
        0%, 100% {
            border-radius: 55% 45% 38% 62% / 60% 42% 58% 40%;
        }

        33% {
            border-radius: 40% 60% 58% 42% / 45% 55% 40% 60%;
        }

        66% {
            border-radius: 62% 38% 45% 55% / 55% 45% 62% 38%;
        }
    }

    @@media (max-width: 768px) {
        .lib-blob-tl, .lib-blob-br {
            display: none;
        }
    }

    .sec-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.1rem;
        position: relative;
        z-index: 2;
    }

    .sec-bar-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 900;
        font-size: 1.2rem;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .sec-bar-badge {
        font-size: .67rem;
        font-weight: 800;
        background: #fff3ed;
        color: #f26522;
        padding: .15rem .55rem;
        border-radius: 20px;
        border: 1px solid #fcd9c3;
        margin-left: .3rem;
    }

    .sec-bar-link {
        font-size: .8rem;
        font-weight: 800;
        color: #f26522;
        text-decoration: none;
        white-space: nowrap;
        transition: color .15s;
    }

        .sec-bar-link:hover {
            color: #d9541a;
            text-decoration: underline;
        }

    .carousel-outer {
        position: relative;
        margin-bottom: 2.75rem;
        z-index: 2;
    }

    .book-rail {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: .3rem .15rem 1rem;
        scrollbar-width: none;
    }

        .book-rail::-webkit-scrollbar {
            display: none;
        }

    .bk-card {
        flex: 0 0 180px;
        width: 180px;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #ede8e0;
        box-shadow: 0 3px 12px rgba(0,0,0,.07);
        transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s, border-color .2s;
        position: relative;
        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

        .bk-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 50px rgba(0,0,0,.16);
            border-color: #f26522;
        }

    .bk-cover {
        width: 100%;
        height: 234px;
        object-fit: cover;
        display: block;
        transition: transform .35s;
    }

    .bk-card:hover .bk-cover {
        transform: scale(1.06);
    }

    .bk-cover-ph {
        width: 100%;
        height: 234px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bk-premium-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        background: rgba(0,0,0,.72);
        color: #fbbf24;
        font-size: .58rem;
        font-weight: 800;
        padding: .18rem .52rem;
        border-radius: 6px;
        backdrop-filter: blur(6px);
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .bk-body {
        padding: .65rem .75rem .3rem;
        flex: 1;
        display: flex; /* ADD THIS */
        flex-direction: column; /* ADD THIS */
    }

    .bk-title {
        font-family: 'Nunito', sans-serif;
        font-size: .8rem;
        font-weight: 800;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        color: #1a1a2e;
        margin-bottom: .15rem;
        min-height: 2.16rem;
    }

    .bk-author {
        font-size: .67rem;
        color: #6b6878;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: .2rem;
        flex: 1;
    }

    .bk-reads-pill {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        background: #fff3ed;
        border: 1px solid #fcd9c3;
        border-radius: 20px;
        padding: .12rem .55rem;
        font-size: .62rem;
        font-weight: 800;
        color: #c2410c;
        margin-top: auto; /* CHANGE from .1rem to auto */
        transition: background .2s, transform .15s;
        cursor: help;
        align-self: flex-start; /* ADD THIS — don't stretch full width */
    }

        .bk-reads-pill:hover {
            background: #f26522;
            color: #fff;
            border-color: #f26522;
            transform: scale(1.05);
        }

            .bk-reads-pill:hover svg {
                stroke: #fff;
            }

    .bk-actions {
        display: flex;
        gap: .35rem;
        padding: .5rem .75rem .7rem;
    }

    .btn-bk-read {
        flex: 1;
        font-family: 'Nunito', sans-serif;
        font-size: .72rem;
        font-weight: 800;
        padding: .32rem .4rem;
        border-radius: 8px;
        background: #f26522;
        border: none;
        color: #fff;
        transition: background .18s, transform .15s;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        box-shadow: 0 2px 8px rgba(242,101,34,.25);
    }

        .btn-bk-read:hover {
            background: #d9541a;
            color: #fff;
            transform: translateY(-1px);
        }

        .btn-bk-read.locked {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            font-size: .65rem;
        }

    .btn-bk-fav {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        border-radius: 8px;
        border: 1.5px solid #ede8e0;
        background: #fafafa;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: all .18s cubic-bezier(.34,1.56,.64,1);
        cursor: pointer;
    }

        .btn-bk-fav:hover {
            border-color: #fca5a5;
            background: #fff5f5;
            transform: scale(1.25);
        }

    .rail-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-75%);
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #fff;
        border: 1.5px solid #ede8e0;
        box-shadow: 0 4px 16px rgba(0,0,0,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        cursor: pointer;
        transition: all .2s cubic-bezier(.34,1.56,.64,1);
        padding: 0;
        color: #1a1a2e;
    }

        .rail-arrow:hover {
            background: #f26522;
            border-color: #f26522;
            box-shadow: 0 6px 22px rgba(242,101,34,.4);
            transform: translateY(-75%) scale(1.15);
        }

            .rail-arrow:hover svg {
                stroke: #fff;
            }

        .rail-arrow.prev {
            left: -17px;
        }

        .rail-arrow.next {
            right: -17px;
        }

    .cat-hero {
        background: linear-gradient(160deg, #1a1a2e 0%, #0f3460 55%, #16213e 100%);
        border-radius: 22px;
        margin-bottom: 2rem;
        overflow: hidden;
        position: relative;
        min-height: 220px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        box-shadow: 0 12px 48px rgba(26,26,46,.3);
    }

    .cat-hero-bg::before {
        content: '';
        position: absolute;
        top: -80px;
        right: -80px;
        width: 380px;
        height: 380px;
        background: radial-gradient(circle, rgba(242,101,34,.28) 0%, transparent 65%);
    }

    .cat-hero-bg::after {
        content: '';
        position: absolute;
        bottom: -60px;
        left: 20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(37,99,235,.18) 0%, transparent 65%);
    }

    .cat-hero-inner {
        position: relative;
        z-index: 2;
        padding: 2.5rem 2.5rem 1.75rem;
    }

    .cat-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(242,101,34,.2);
        border: 1px solid rgba(242,101,34,.4);
        border-radius: 20px;
        padding: .2rem .75rem;
        font-size: .68rem;
        font-weight: 800;
        color: #f9a875;
        text-transform: uppercase;
        letter-spacing: .8px;
        margin-bottom: .85rem;
    }

    .cat-hero-title {
        font-family: 'Nunito', sans-serif;
        font-size: 2.4rem;
        font-weight: 900;
        color: #fff;
        margin: 0 0 .3rem;
        line-height: 1.1;
    }

    .cat-hero-count {
        font-size: .9rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
    }

    .book-list-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.1rem;
        margin-bottom: .1rem;
        position: relative;
        z-index: 2;
    }

    .book-list-item {
        display: flex;
        gap: 1rem;
        padding: 1rem;
        background: #fff;
        border: 1px solid #ede8e0;
        border-radius: 16px;
        transition: box-shadow .22s, transform .22s, border-color .22s;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        text-decoration: none !important;
        color: inherit !important;
        cursor: pointer;
    }

        .book-list-item:hover {
            box-shadow: 0 10px 32px rgba(0,0,0,.12);
            transform: translateY(-3px);
            border-color: #f26522;
        }

    .book-list-num {
        font-family: 'Nunito', sans-serif;
        font-size: 1.3rem;
        font-weight: 900;
        color: #e0dbd3;
        min-width: 22px;
        align-self: flex-start;
        line-height: 1;
        margin-top: .35rem;
    }

        .book-list-num.top3 {
            color: #f26522;
        }

    .book-list-cover {
        width: 72px;
        height: 96px;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        display: block;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

    .book-list-cover-ph {
        width: 72px;
        height: 96px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea, #764ba2);
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

    .book-list-info {
        flex: 1;
        min-width: 0;
    }

    .book-list-title {
        font-family: 'Nunito', sans-serif;
        font-size: .9rem;
        font-weight: 800;
        color: #1a1a2e;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
        margin-bottom: .2rem;
    }

    .book-list-author {
        font-size: .75rem;
        color: #6b6878;
        font-weight: 600;
        margin-bottom: .4rem;
    }

    .book-list-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem;
        margin-bottom: .4rem;
    }

    .book-tag {
        font-size: .62rem;
        font-weight: 700;
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
        padding: .1rem .45rem;
        border-radius: 20px;
        text-transform: lowercase;
    }

    .book-list-desc {
        font-size: .75rem;
        color: #6b6878;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    .book-list-meta {
        display: flex;
        gap: .75rem;
        margin-top: .45rem;
        font-size: .7rem;
        color: #9994a8;
        font-weight: 600;
        align-items: center;
        flex-wrap: wrap;
    }

    .reads-pill {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        background: #fff3ed;
        border: 1px solid #fcd9c3;
        border-radius: 20px;
        padding: .1rem .5rem;
        font-size: .68rem;
        font-weight: 800;
        color: #c2410c;
        transition: background .18s, color .18s;
        cursor: help;
    }

        .reads-pill:hover {
            background: #f26522;
            color: #fff;
            border-color: #f26522;
        }

            .reads-pill:hover svg {
                stroke: #fff;
            }

    .list-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        gap: .75rem;
        position: relative;
        z-index: 2;
    }

    .list-count {
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 800;
        color: #1a1a2e;
    }

    .sort-btn {
        background: #fff;
        border: 1.5px solid #e0dbd3;
        border-radius: 10px;
        padding: .4rem .9rem;
        font-family: 'Nunito', sans-serif;
        font-size: .8rem;
        font-weight: 800;
        color: #4a4660;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: .4rem;
        transition: all .18s;
        text-decoration: none;
    }

        .sort-btn:hover {
            border-color: #f26522;
            color: #f26522;
        }

    .tag-refine {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 16px;
        padding: 1.1rem 1.5rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        position: relative;
        z-index: 2;
    }

    .tag-refine-label {
        font-size: .75rem;
        font-weight: 800;
        color: #9994a8;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: .75rem;
    }

    .tag-chips {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        align-items: center;
    }

    .tag-chip {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .28rem .75rem;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .18s;
        border: 1.5px solid;
        cursor: pointer;
    }

        .tag-chip.active {
            background: #1a1a2e;
            border-color: #1a1a2e;
            color: #fff;
        }

        .tag-chip.inactive {
            background: #fff;
            border-color: #e0dbd3;
            color: #4a4660;
        }

            .tag-chip.inactive:hover {
                border-color: #f26522;
                color: #f26522;
                background: #fff9f6;
            }

        .tag-chip.add {
            background: transparent;
            border-color: #e0dbd3;
            color: #9994a8;
        }

            .tag-chip.add:hover {
                border-color: #f26522;
                color: #f26522;
            }

    .lib-empty {
        text-align: center;
        padding: 5rem 2rem;
        position: relative;
        z-index: 2;
    }

        .lib-empty .empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.25rem;
            width: 88px;
            height: 88px;
            border-radius: 50%;
            background: #fff3ed;
            animation: floatIcon 3s ease-in-out infinite;
        }

    @@keyframes floatIcon {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .bk-reads-pill.updated,
    .reads-pill.updated {
        background: #f26522 !important;
        color: #fff !important;
        border-color: #f26522 !important;
        transition: background .3s, color .3s;
    }

    @@media (max-width: 768px) {
        .book-list-row {
            grid-template-columns: 1fr;
        }

        .cat-hero-title {
            font-size: 1.75rem;
        }

        .cat-hero-inner {
            padding: 1.75rem 1.25rem 1.25rem;
        }

        .rail-arrow {
            display: none;
        }

        .bk-card {
            flex: 0 0 132px;
            width: 132px;
        }

        .bk-cover, .bk-cover-ph {
            height: 172px;
        }
    }
