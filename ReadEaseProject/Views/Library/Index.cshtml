@model ReadEase.ViewModels.Library.LibraryViewModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.SelectedCategory) ? "Browse Books" : Model.SelectedCategory + " Stories";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var allCategories = Model.Categories.ToList();
    bool isFiltering = !string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedCategory);
    bool isCategoryPage = !string.IsNullOrEmpty(Model.SelectedCategory) && string.IsNullOrEmpty(Model.SearchQuery);

    string FormatReads(int count)
    {
        if (count >= 1_000_000) return (count / 1_000_000.0).ToString("0.#") + "M";
        if (count >= 1_000) return (count / 1_000.0).ToString("0.#") + "K";
        return count.ToString();
    }

