@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function scrollRail(id, dir) {
            const el = document.getElementById(id);
            if (el) el.scrollBy({ left: dir * 540, behavior: 'smooth' });
        }

        const heartFilled  = `<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='#ef4444' stroke='#ef4444' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/></svg>`;
        const heartOutline = `<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='#c4bfb8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z'/></svg>`;

        document.querySelectorAll('.fav-btn').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.stopPropagation();
                const id    = this.dataset.id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const res   = await fetch('/Library/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `bookId=${id}`
                });
                if (res.ok) {
                    const json  = await res.json();
                    const isFav = json.isFavorite ?? json.IsFavorite ?? false;
                    this.innerHTML = isFav ? heartFilled : heartOutline;
                    this.style.transform = 'scale(1.45)';
                    setTimeout(() => this.style.transform = '', 220);
                }
            });
        });

        function formatReads(n) {
            if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
            if (n >= 1000)    return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
            return n.toString();
        }

        async function refreshReadCounts() {
            const token  = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            const allIds = [...new Set(
                [...document.querySelectorAll('.fav-btn[data-id]')]
                    .map(b => b.dataset.id).filter(Boolean)
            )];
            document.querySelectorAll('.reads-pill[data-book-id]').forEach(pill => {
                const id = pill.dataset.bookId;
                if (id && !allIds.includes(id)) allIds.push(id);
            });
            if (!allIds.length) return;
            try {
                const res = await fetch('/Library/GetReadCounts', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify(allIds)
                });
                if (!res.ok) return;
                const data = await res.json();
                document.querySelectorAll('.fav-btn[data-id]').forEach(btn => {
                    const id  = btn.dataset.id;
                    const val = data[id];
                    if (val == null) return;
                    const card = btn.closest('.bk-card, .col');
                    if (!card) return;
                    card.querySelectorAll('.reads-count-val').forEach(span => _applyUpdate(span, val));
                });
                document.querySelectorAll('.reads-pill[data-book-id]').forEach(pill => {
                    const id  = pill.dataset.bookId;
                    const val = data[id];
                    if (val == null) return;
                    const span = pill.querySelector('.reads-count-val');
                    if (span) _applyUpdate(span, val, pill);
                });
            } catch (_) {}
        }

        function _applyUpdate(span, val, pillOverride) {
            const oldRaw = parseInt(span.dataset.raw ?? '0', 10);
            if (oldRaw === val) return;
            span.dataset.raw = val;
            span.textContent = formatReads(val);
            const pill = pillOverride ?? span.closest('.bk-reads-pill, .reads-pill');
            if (pill) {
                pill.title = val.toLocaleString() + ' unique readers';
                pill.classList.add('updated');
                setTimeout(() => pill.classList.remove('updated'), 1200);
            }
        }

        refreshReadCounts();
        setInterval(refreshReadCounts, 30000);
    </script>
}
