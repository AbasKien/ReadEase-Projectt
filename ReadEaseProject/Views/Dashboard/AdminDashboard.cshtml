@model ReadEase.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .re-hero {
        background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 55%, #450a0a 100%);
        border-radius: 20px;
        padding: 2.25rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .re-hero::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 320px;
            height: 320px;
            background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 65%);
            pointer-events: none;
        }

        .re-hero::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -40px;
            width: 240px;
            height: 240px;
            background: radial-gradient(circle, rgba(242,101,34,.12) 0%, transparent 65%);
            pointer-events: none;
        }

    .re-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-hero-label {
        font-size: .7rem;
        font-weight: 800;
        color: rgba(255,255,255,.45);
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: .25rem;
    }

    .re-hero-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0;
    }

    .re-hero-sub {
        font-size: .88rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        margin-top: .2rem;
    }

    .re-stat {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        padding: 1.3rem 1.4rem 1.1rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        transition: transform .22s, box-shadow .22s;
        display: block;
        text-decoration: none !important;
        color: inherit !important;
        position: relative;
        overflow: hidden;
    }

        .re-stat::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 0;
            background: #f26522;
            transition: width .3s ease;
            border-radius: 0 0 0 18px;
        }

        .re-stat:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(0,0,0,.1);
        }

            .re-stat:hover::before {
                width: 100%;
            }

    .re-stat-icon {
        margin-bottom: .65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: 12px;
        flex-shrink: 0;
    }

    .re-stat-val {
        font-family: 'Nunito', sans-serif;
        font-size: 2.1rem;
        font-weight: 900;
        color: #1a1a2e;
        line-height: 1;
    }

    .re-stat-lbl {
        font-size: .7rem;
        font-weight: 800;
        color: #9994a8;
        text-transform: uppercase;
        letter-spacing: .55px;
        margin-top: .25rem;
    }

    .re-stat-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        background: #fff3ed;
        color: #f26522;
        font-size: .62rem;
        font-weight: 800;
        padding: .15rem .5rem;
        border-radius: 20px;
        border: 1px solid #fcd9c3;
        margin-top: .45rem;
    }

    .re-stat.warn .re-stat-val {
        color: #d97706;
    }

    .re-sec-title {
        font-family: 'Nunito', sans-serif;
        font-weight: 900;
        font-size: 1.05rem;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1.1rem;
        position: relative;
        z-index: 2;
    }

    .re-sec-line {
        flex: 1;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg, rgba(153,27,27,.5) 0%, transparent 100%);
        margin-left: .4rem;
    }

    .re-action {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: #fff;
        border: 1.5px solid #e8e3dc;
        border-radius: 14px;
        padding: 1rem 1.15rem;
        text-decoration: none !important;
        color: #1a1a2e !important;
        transition: border-color .18s, box-shadow .18s, transform .22s;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

        .re-action:hover {
            border-color: #f26522;
            box-shadow: 0 8px 28px rgba(242,101,34,.14);
            transform: translateY(-3px);
        }

    .re-action-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: #fff3ed;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .re-action-title {
        font-family: 'Nunito', sans-serif;
        font-size: .9rem;
        font-weight: 800;
    }

    .re-action-desc {
        font-size: .75rem;
        color: #9994a8;
        font-weight: 600;
    }

    .re-action-arrow {
        margin-left: auto;
        color: #c0bdd0;
        font-size: 1.2rem;
        transition: transform .18s, color .18s;
    }

    .re-action:hover .re-action-arrow {
        transform: translateX(4px);
        color: #f26522;
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="re-hero fade-up">
    <div class="re-hero-inner">
        <div>
            <div class="re-hero-label">Control Panel</div>
            <div class="re-hero-title" style="display:flex;align-items:center;gap:.65rem;">
        <div style="width:42px;height:42px;border-radius:12px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        Admin Dashboard
    </div>
            <div class="re-hero-sub">Manage users, content, and platform activity</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2 fade-up-1">
        <div class="re-stat re-stat-accent">
            <div class="re-stat-icon ib-bl">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="re-stat-val">@Model.TotalUsers</div>
            <div class="re-stat-lbl">Total Users</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2 fade-up-2">
        <div class="re-stat re-stat-accent">
            <div class="re-stat-icon ib-pu">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div class="re-stat-val">@Model.TotalAuthors</div>
            <div class="re-stat-lbl">Authors</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2 fade-up-3">
        <div class="re-stat re-stat-accent">
            <div class="re-stat-icon ib-gr">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="re-stat-val">@Model.ActiveUsers</div>
            <div class="re-stat-lbl">Active</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2 fade-up-4">
        <div class="re-stat re-stat-accent">
            <div class="re-stat-icon ib-red">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
            </div>
            <div class="re-stat-val">@Model.InactiveUsers</div>
            <div class="re-stat-lbl">Inactive</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl-2 fade-up-1">
        <a asp-controller="Admin" asp-action="PendingBooks"
           class="re-stat re-stat-accent @(Model.PendingPremiumBooks > 0 ? "warn" : "")">
            <div class="re-stat-icon ib-or">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div class="re-stat-val">@Model.PendingPremiumBooks</div>
            <div class="re-stat-lbl">Pending Books</div>
            @if (Model.PendingPremiumBooks > 0)
            {
                <span class="re-stat-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Action needed
                </span>
            }
        </a>
    </div>
    <div class="col-6 col-md-4 col-xl-2 fade-up-2">
        <a asp-controller="Admin" asp-action="Subscriptions"
           class="re-stat re-stat-accent @(Model.PendingSubscriptions > 0 ? "warn" : "")">
            <div class="re-stat-icon ib-am">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <div class="re-stat-val">@Model.PendingSubscriptions</div>
            <div class="re-stat-lbl">Pending Subs</div>
            @if (Model.PendingSubscriptions > 0)
            {
                <span class="re-stat-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Review
                </span>
            }
        </a>
    </div>
</div>

<div class="re-sec-title fade-up">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f26522" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
    Quick Actions
    <div class="re-sec-line"></div>
</div>
<div class="row g-3 fade-up">
    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="PendingBooks" class="re-action">
            <div class="re-action-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </div>
            <div>
                <div class="re-action-title">
                    Pending Books
                    @if (Model.PendingPremiumBooks > 0)
                    {
                        <span style="background:#f26522;color:#fff;font-size:.6rem;font-weight:900;
                                         padding:.1rem .45rem;border-radius:99px;margin-left:.4rem;
                                         vertical-align:middle;">@Model.PendingPremiumBooks</span>
                    }
                </div>
                <div class="re-action-desc">Approve or reject premium books</div>
            </div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Users" class="re-action">
            <div class="re-action-icon" style="background:#eff6ff;color:#1d4ed8;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div><div class="re-action-title">User Management</div><div class="re-action-desc">Activate / deactivate users</div></div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Subscriptions" class="re-action">
            <div class="re-action-icon" style="background:#fffbeb;color:#d97706;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <div><div class="re-action-title">Subscriptions</div><div class="re-action-desc">Approve or reject requests</div></div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="AuditLogs" class="re-action">
            <div class="re-action-icon" style="background:#f0fdf4;color:#15803d;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div><div class="re-action-title">Audit Logs</div><div class="re-action-desc">Track all platform activity</div></div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Books" class="re-action">
            <div class="re-action-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <div><div class="re-action-title">All Books</div><div class="re-action-desc">View &amp; moderate content</div></div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-controller="Admin" asp-action="Archive" class="re-action">
            <div class="re-action-icon" style="background:#faf5ff;color:#6d28d9;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
            </div>
            <div><div class="re-action-title">Archive</div><div class="re-action-desc">Deleted books &amp; inactive users</div></div>
            <span class="re-action-arrow">›</span>
        </a>
    </div>
</div>