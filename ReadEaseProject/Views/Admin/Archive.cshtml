@model ReadEase.ViewModels.Archive.ArchiveViewModel
@{
    ViewData["Title"] = "Archive";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .re-hero {
        background: linear-gradient(135deg,#44403c 0%,#292524 100%);
        border-radius: 20px;
        padding: 2.25rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .re-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle,rgba(255,255,255,.06) 0%,transparent 65%);
            pointer-events: none;
        }

    .re-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-hero-title {
        font-family: 'Nunito',sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0;
    }

    .re-hero-sub {
        font-size: .88rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        margin-top: .2rem;
    }

    .re-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 10px;
        color: rgba(255,255,255,.8) !important;
        font-family: 'Nunito',sans-serif;
        font-weight: 700;
        font-size: .82rem;
        padding: .45rem 1rem;
        text-decoration: none !important;
        transition: background .18s;
    }

        .re-btn-ghost:hover {
            background: rgba(255,255,255,.18);
            color: #fff !important;
        }

    .re-sec-title {
        font-family: 'Nunito',sans-serif;
        font-weight: 900;
        font-size: 1.05rem;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
        position: relative;
        z-index: 2;
    }

    .re-sec-line {
        flex: 1;
        height: 2px;
        border-radius: 2px;
        background: linear-gradient(90deg,rgba(120,113,108,.4) 0%,transparent 100%);
        margin-left: .4rem;
    }

    .re-table-wrap {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        margin-bottom: 2rem;
        position: relative;
        z-index: 2;
    }

    .re-table thead th {
        background: #44403c !important;
        color: rgba(255,255,255,.82) !important;
        font-size: .68rem !important;
        text-transform: uppercase;
        letter-spacing: .65px;
        padding: .85rem 1.1rem !important;
        border: none !important;
    }

    .re-table td {
        padding: .78rem 1.1rem !important;
        vertical-align: middle;
        font-size: .855rem;
        border-color: #f0eeea !important;
    }

    .re-table tbody tr:hover {
        background: #faf9f7 !important;
    }

    .re-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .88rem;
        cursor: pointer;
        transition: all .16s;
    }

        .re-icon-btn.restore {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #059669;
        }

        .re-icon-btn.del {
            background: #fef2f2;
            border-color: #fecaca;
            color: #dc2626;
        }

    .re-empty {
        background: #faf9f7;
        border: 1px solid #e8e3dc;
        border-radius: 14px;
        padding: 2rem;
        text-align: center;
        color: #6b6878;
        font-weight: 600;
        position: relative;
        z-index: 2;
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* ── PAGINATION ── */
    .re-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
        position: relative;
        z-index: 2;
    }

    .re-page-info {
        font-family: 'Nunito',sans-serif;
        font-size: .78rem;
        font-weight: 700;
        color: #9994a8;
    }

    .re-page-btns {
        display: flex;
        align-items: center;
        gap: .3rem;
    }

    .re-page-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid #e8e3dc;
        background: #fff;
        font-family: 'Nunito',sans-serif;
        font-size: .78rem;
        font-weight: 800;
        color: #6b6878;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        padding: 0;
    }

        .re-page-btn:hover:not(:disabled) {
            border-color: #f26522;
            color: #f26522;
            background: #fff3ed;
        }

        .re-page-btn.active {
            background: #f26522;
            border-color: #f26522;
            color: #fff;
        }

        .re-page-btn:disabled {
            opacity: .35;
            cursor: default;
        }

        .re-page-btn.prev-next {
            width: auto;
            padding: 0 .65rem;
            gap: .25rem;
            font-size: .72rem;
        }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
<div class="re-pagination" id="archiveBooksPagination">
    <span class="re-page-info" id="archiveBooksPageInfo"></span>
    <div class="re-page-btns" id="archiveBooksPageBtns"></div>
</div>


<div class="re-sec-title fade-up" style="display:flex;align-items:center;gap:.45rem;">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    Inactive Users <div class="re-sec-line"></div>
</div>
@if (!Model.InactiveUsers.Any())
{
    <div class="re-empty fade-up">No inactive users.</div>
}
else
{
    <div class="re-table-wrap fade-up">
        <div class="table-responsive">
            <table class="table re-table align-middle mb-0" id="archiveUsersTable">
                <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var user in Model.InactiveUsers)
                    {
                        <tr>
                            <td class="fw-semibold">@user.Name</td>
                            <td class="text-muted small">@user.Email</td>
                            <td><span class="badge bg-secondary rounded-pill" style="font-size:.62rem;">@user.Role</span></td>
                            <td>
                                <div style="display:flex;gap:.4rem;">
                                    <form asp-controller="Admin" asp-action="RestoreUser" method="post">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="re-icon-btn restore" title="Restore"
                                                onclick="return confirm('Restore @user.Name?')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="PermanentDeleteUser" method="post">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="re-icon-btn del" title="Permanently Delete"
                                                onclick="return confirm('Permanently delete @user.Name? This CANNOT be undone and will remove them from the database entirely.')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="re-pagination" id="archiveUsersPagination">
        <span class="re-page-info" id="archiveUsersPageInfo"></span>
        <div class="re-page-btns" id="archiveUsersPageBtns"></div>
    </div>
}

@section Scripts {
    <script>
        const PAGE_SIZE = 10;

        function makePaginator(tableId, paginationId, infoId, btnsId) {
            let currentPage = 1;
            function render() {
                const rows = Array.from(document.querySelectorAll(`#${tableId} tbody tr`));
                const total = rows.length;
                const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
                currentPage = Math.min(currentPage, totalPages);
                const start = (currentPage - 1) * PAGE_SIZE;
                rows.forEach((r, i) => { r.style.display = (i >= start && i < start + PAGE_SIZE) ? '' : 'none'; });

                const info = document.getElementById(infoId);
                const btns = document.getElementById(btnsId);
                const showing = Math.min(PAGE_SIZE, total - start);
                info.textContent = total === 0 ? 'Empty' : `Showing ${start + 1}–${start + showing} of ${total}`;

                btns.innerHTML = '';
                if (totalPages <= 1) { document.getElementById(paginationId).style.display = 'none'; return; }
                document.getElementById(paginationId).style.display = 'flex';

                const prev = document.createElement('button');
                prev.className = 're-page-btn prev-next'; prev.textContent = '← Prev';
                prev.disabled = currentPage === 1;
                prev.onclick = () => { currentPage--; render(); };
                btns.appendChild(prev);

                for (let p = 1; p <= totalPages; p++) {
                    if (totalPages > 7 && p > 2 && p < totalPages - 1 && Math.abs(p - currentPage) > 1) {
                        if (p === 3 || p === totalPages - 2) { const d = document.createElement('span'); d.className = 're-page-info'; d.style.padding = '0 .2rem'; d.textContent = '…'; btns.appendChild(d); }
                        continue;
                    }
                    const b = document.createElement('button');
                    b.className = 're-page-btn' + (p === currentPage ? ' active' : '');
                    b.textContent = p;
                    b.onclick = ((pg) => () => { currentPage = pg; render(); })(p);
                    btns.appendChild(b);
                }

                const next = document.createElement('button');
                next.className = 're-page-btn prev-next'; next.textContent = 'Next →';
                next.disabled = currentPage === totalPages;
                next.onclick = () => { currentPage++; render(); };
                btns.appendChild(next);
            }
            render();
        }

        makePaginator('archiveBooksTable', 'archiveBooksPagination', 'archiveBooksPageInfo', 'archiveBooksPageBtns');
        makePaginator('archiveUsersTable', 'archiveUsersPagination', 'archiveUsersPageInfo', 'archiveUsersPageBtns');
    </script>
}
