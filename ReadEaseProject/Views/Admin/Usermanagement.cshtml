@model List<ReadEase.ViewModels.Admin.UserManagementViewModel>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .re-hero {
        background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 55%, #450a0a 100%);
        border-radius: 20px;
        padding: 2.25rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .re-hero::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 65%);
            pointer-events: none;
        }

    .re-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-hero-icon {
        width: 48px;
        height: 48px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .re-hero-icon svg {
            width: 22px;
            height: 22px;
            color: #fff;
        }

    .re-hero-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0;
    }

    .re-hero-sub {
        font-size: .88rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        margin-top: .2rem;
    }

    .re-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 10px;
        color: rgba(255,255,255,.8) !important;
        font-family: 'Nunito', sans-serif;
        font-weight: 700;
        font-size: .82rem;
        padding: .45rem 1rem;
        text-decoration: none !important;
        transition: background .18s;
    }

        .re-btn-ghost:hover {
            background: rgba(255,255,255,.18);
            color: #fff !important;
        }

    .search-wrap {
        position: relative;
        max-width: 380px;
        margin-bottom: 1.25rem;
        z-index: 2;
    }

    .search-icon {
        position: absolute;
        top: 50%;
        left: .9rem;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        color: #9994a8;
    }

        .search-icon svg {
            width: 15px;
            height: 15px;
        }

    .re-input {
        border: 1.5px solid #e8e3dc;
        border-radius: 10px;
        padding: .6rem .9rem .6rem 2.5rem;
        font-size: .875rem;
        transition: border-color .18s;
        font-family: 'Nunito', sans-serif;
        width: 100%;
    }

        .re-input:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.12);
            outline: none;
        }

    .re-table-wrap {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        position: relative;
        z-index: 2;
    }

    .re-table thead th {
        background: #991b1b !important;
        color: rgba(255,255,255,.82) !important;
        font-family: 'Nunito', sans-serif;
        font-size: .68rem !important;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .65px;
        padding: .85rem 1.1rem !important;
        border: none !important;
    }

    .re-table td {
        padding: .78rem 1.1rem !important;
        vertical-align: middle;
        font-size: .855rem;
        border-color: #f0eeea !important;
    }

    .re-table tbody tr {
        transition: background .12s;
    }

        .re-table tbody tr:hover {
            background: #fef2f2 !important;
        }

    .user-avatar-ph {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .82rem;
        font-weight: 900;
        color: #fff;
        flex-shrink: 0;
        font-family: 'Nunito', sans-serif;
    }

    /* ── Action buttons — icon-only, SVG ── */
    .re-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .16s;
        background: transparent;
        padding: 0;
    }

        .re-icon-btn svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

        .re-icon-btn.activate {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #059669;
        }

            .re-icon-btn.activate:hover {
                background: #dcfce7;
                border-color: #6ee7b7;
            }

        .re-icon-btn.deactivate {
            background: #fef2f2;
            border-color: #fecaca;
            color: #dc2626;
        }

            .re-icon-btn.deactivate:hover {
                background: #fee2e2;
                border-color: #f87171;
            }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* ── PAGINATION ── */
    .re-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
        position: relative;
        z-index: 2;
    }

    .re-page-info {
        font-family: 'Nunito', sans-serif;
        font-size: .78rem;
        font-weight: 700;
        color: #9994a8;
    }

    .re-page-btns {
        display: flex;
        align-items: center;
        gap: .3rem;
    }

    .re-page-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid #e8e3dc;
        background: #fff;
        font-family: 'Nunito', sans-serif;
        font-size: .78rem;
        font-weight: 800;
        color: #6b6878;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        padding: 0;
    }

        .re-page-btn:hover:not(:disabled) {
            border-color: #f26522;
            color: #f26522;
            background: #fff3ed;
        }

        .re-page-btn.active {
            background: #f26522;
            border-color: #f26522;
            color: #fff;
        }

        .re-page-btn:disabled {
            opacity: .35;
            cursor: default;
        }

        .re-page-btn.prev-next {
            width: auto;
            padding: 0 .65rem;
            font-size: .72rem;
        }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="re-hero fade-up">
    <div class="re-hero-inner">
        <div class="d-flex align-items-center gap-3">
            <div class="re-hero-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
            </div>
            <div>
                <div class="re-hero-title">User Management</div>
                <div class="re-hero-sub">@Model.Count total user@(Model.Count != 1 ? "s" : "") on the platform</div>
            </div>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="re-btn-ghost">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px;">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Dashboard
        </a>
    </div>
</div>

<div class="search-wrap fade-up">
    <span class="search-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
    </span>
    <input type="text" id="userSearch" class="re-input" placeholder="Search by name, email, or role…" />
</div>

@if (!Model.Any())
{
    <div class="text-center py-5" style="position:relative;z-index:2;">
        <div style="width:64px;height:64px;border-radius:18px;background:#fef2f2;border:1.5px solid #fecaca;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
            <svg viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:28px;height:28px;">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
        </div>
        <h5 style="font-family:'Nunito',sans-serif;font-weight:900;">No users found</h5>
    </div>
}
else
{
    <div class="re-table-wrap fade-up">
        <div class="table-responsive">
            <table class="table re-table align-middle mb-0" id="usersTable">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Provider</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-avatar-ph" style="background:linear-gradient(135deg,#667eea,#764ba2);">
                                        @user.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold" style="font-size:.88rem;">@user.Name</span>
                                </div>
                            </td>
                            <td class="text-muted small">@user.Email</td>
                            <td>
                                <span class="badge rounded-pill @(user.Role == "Admin" ? "bg-danger" : user.Role == "Author" ? "bg-success" : "bg-primary")" style="font-size:.62rem;">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill @(user.Provider == "Google" ? "bg-warning text-dark" : "bg-secondary")" style="font-size:.62rem;">
                                    @user.Provider
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill @(user.IsActive ? "bg-success" : "bg-secondary")" style="font-size:.62rem;">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-muted small">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                @if (user.IsActive)
                                {
                                    <form asp-controller="Admin" asp-action="DeactivateUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="re-icon-btn deactivate"
                                                title="Deactivate @user.Name"
                                                onclick="return confirm('Deactivate @user.Name?')">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="10" />
                                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07" />
                                            </svg>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="ActivateUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="re-icon-btn activate"
                                                title="Activate @user.Name"
                                                onclick="return confirm('Activate @user.Name?')">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12" />
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-2" style="position:relative;z-index:2;">Showing @Model.Count user(s)</p>

    <div class="re-pagination" id="usersPagination">
        <span class="re-page-info" id="usersPageInfo"></span>
        <div class="re-page-btns" id="usersPageBtns"></div>
    </div>
}

@section Scripts {
    <script>
        const PAGE_SIZE = 10;
        let usersCurrentPage = 1;

        function renderUsersPagination() {
            const allRows = Array.from(document.querySelectorAll('#usersTable tbody tr'));
            const visible = allRows.filter(r => !r.dataset.filtered);
            const total = visible.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            usersCurrentPage = Math.min(usersCurrentPage, totalPages);
            const start = (usersCurrentPage - 1) * PAGE_SIZE;

            visible.forEach((r, i) => {
                r.style.display = (i >= start && i < start + PAGE_SIZE) ? '' : 'none';
            });

            const info = document.getElementById('usersPageInfo');
            const btns = document.getElementById('usersPageBtns');
            const showing = Math.min(PAGE_SIZE, total - start);
            info.textContent = total === 0
                ? 'No results'
                : `Showing ${start + 1}–${start + showing} of ${total} user(s)`;

            btns.innerHTML = '';
            if (totalPages <= 1) {
                document.getElementById('usersPagination').style.display = 'none';
                return;
            }
            document.getElementById('usersPagination').style.display = 'flex';

            const prev = document.createElement('button');
            prev.className = 're-page-btn prev-next';
            prev.textContent = '← Prev';
            prev.disabled = usersCurrentPage === 1;
            prev.onclick = () => { usersCurrentPage--; renderUsersPagination(); };
            btns.appendChild(prev);

            for (let p = 1; p <= totalPages; p++) {
                if (totalPages > 7 && p > 2 && p < totalPages - 1 && Math.abs(p - usersCurrentPage) > 1) {
                    if (p === 3 || p === totalPages - 2) {
                        const d = document.createElement('span');
                        d.className = 're-page-info';
                        d.style.padding = '0 .2rem';
                        d.textContent = '…';
                        btns.appendChild(d);
                    }
                    continue;
                }
                const b = document.createElement('button');
                b.className = 're-page-btn' + (p === usersCurrentPage ? ' active' : '');
                b.textContent = p;
                b.onclick = () => { usersCurrentPage = p; renderUsersPagination(); };
                btns.appendChild(b);
            }

            const next = document.createElement('button');
            next.className = 're-page-btn prev-next';
            next.textContent = 'Next →';
            next.disabled = usersCurrentPage === totalPages;
            next.onclick = () => { usersCurrentPage++; renderUsersPagination(); };
            btns.appendChild(next);
        }

        document.getElementById('userSearch').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('#usersTable tbody tr').forEach(r => {
                const match = r.innerText.toLowerCase().includes(q);
                r.dataset.filtered = match ? '' : '1';
                if (!match) r.style.display = 'none';
            });
            usersCurrentPage = 1;
            renderUsersPagination();
        });

        renderUsersPagination();
    </script>
}
