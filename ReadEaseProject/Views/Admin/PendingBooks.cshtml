@model List<ReadEase.ViewModels.Admin.PendingBookViewModel>
@{
    ViewData["Title"] = "Pending Premium Books";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pb-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 55%, #0f0d2e 100%);
        border-radius: 20px;
        padding: 2rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .pb-hero::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 280px;
            height: 280px;
            background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 65%);
            pointer-events: none;
        }

    .pb-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .pb-hero-label {
        font-size: .7rem;
        font-weight: 800;
        color: rgba(255,255,255,.45);
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: .25rem;
    }

    .pb-hero-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.75rem;
        font-weight: 900;
        color: #fff;
        margin: 0;
    }

    .pb-hero-sub {
        font-size: .85rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        margin-top: .2rem;
    }

    .book-card {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        transition: transform .2s, box-shadow .2s, border-color .2s;
        height: 100%;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        text-decoration: none;
    }

        .book-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 36px rgba(0,0,0,.11);
            border-color: #4f46e5;
        }

    .book-cover-wrap {
        position: relative;
        width: 100%;
        padding-top: 60%;
        background: #f5f4f0;
        overflow: hidden;
        flex-shrink: 0;
    }

        .book-cover-wrap img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .3s;
        }

    .book-card:hover .book-cover-wrap img {
        transform: scale(1.05);
    }

    .book-cover-ph {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        background: linear-gradient(135deg, #e2e0f9, #c7d2fe);
    }

    .book-badge-premium {
        position: absolute;
        top: .6rem;
        right: .6rem;
        background: #fef9e7;
        color: #92400e;
        font-size: .62rem;
        font-weight: 900;
        padding: .18rem .55rem;
        border-radius: 50px;
        border: 1px solid rgba(217,119,6,.2);
    }

    .book-info {
        padding: 1rem 1.1rem 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .book-title {
        font-family: 'Nunito', sans-serif;
        font-size: .9rem;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: .15rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .book-author {
        font-size: .75rem;
        color: #9994a8;
        font-weight: 600;
        margin-bottom: .35rem;
    }

    .book-meta {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-wrap: wrap;
        margin-bottom: .6rem;
    }

    .book-tag {
        display: inline-block;
        padding: .15rem .55rem;
        border-radius: 20px;
        font-size: .62rem;
        font-weight: 700;
        background: #f1f0ff;
        color: #4f46e5;
    }

    .book-date {
        font-size: .68rem;
        color: #9994a8;
        font-weight: 600;
    }

    .book-desc {
        font-size: .78rem;
        color: #6b7280;
        line-height: 1.5;
        margin-bottom: .75rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .book-submitter {
        font-size: .72rem;
        color: #9994a8;
        font-weight: 600;
        margin-bottom: .85rem;
        padding: .4rem .65rem;
        background: #f9f8f6;
        border-radius: 8px;
        border: 1px solid #f0eeea;
    }

    .book-actions {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .btn-review {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: #fff;
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: .82rem;
        padding: .55rem 1rem;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all .18s;
        flex: 1;
        text-decoration: none;
        box-shadow: 0 3px 12px rgba(79,70,229,.3);
    }

        .btn-review:hover {
            background: linear-gradient(135deg, #4338ca, #6d28d9);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(79,70,229,.4);
        }

    .empty-state {
        text-align: center;
        padding: 4rem 1.5rem;
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
    }

    .empty-state-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        display: block;
    }

    .empty-state-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.25rem;
        font-weight: 900;
        color: #1a1a2e;
        margin-bottom: .4rem;
    }

    .empty-state-sub {
        font-size: .85rem;
        color: #9994a8;
        font-weight: 600;
    }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="pb-hero fade-up">
    <div class="pb-hero-inner">
        <div>
            <div class="pb-hero-label">Admin · Content Review</div>
            <div class="pb-hero-title" style="display:flex;align-items:center;gap:.65rem;">
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
                Pending Premium Books
            </div>
            <div class="pb-hero-sub">Review and approve or reject premium book submissions</div>
        </div>
        <a asp-controller="Admin" asp-action="Index"
           style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.1);
                  border:1.5px solid rgba(255,255,255,.2);border-radius:10px;color:#fff;
                  font-family:'Nunito',sans-serif;font-weight:800;font-size:.82rem;
                  padding:.5rem 1.1rem;text-decoration:none;transition:background .15s;">
            ← Dashboard
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state fade-up">
        <span class="empty-state-icon" style="display:flex;align-items:center;justify-content:center;margin:0 auto .75rem;color:#4ade80;">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <div class="empty-state-title">All caught up!</div>
        <div class="empty-state-sub">No premium books are waiting for approval right now.</div>
    </div>
}
else
{
    <div class="row g-4 fade-up">
        @foreach (var book in Model)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="book-card">

                    @* Clickable cover → goes to detail *@
                    <a asp-controller="Admin" asp-action="PendingBookDetail" asp-route-id="@book.Id"
                       style="text-decoration:none;display:block;">
                        <div class="book-cover-wrap">
                            @if (!string.IsNullOrEmpty(book.CoverImage))
                            {
                                <img src="@book.CoverImage" alt="@book.Title" />
                            }
                            else
                            {
                                <div class="book-cover-ph">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.7)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                </div>
                            }
                            <span class="book-badge-premium" style="display:inline-flex;align-items:center;gap:.25rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                Premium
                            </span>
                        </div>
                    </a>

                    @* Info *@
                    <div class="book-info">
                        <div class="book-title">@book.Title</div>
                        <div class="book-author">by @book.Author</div>

                        <div class="book-meta">
                            <span class="book-tag">@book.Category</span>
                            <span class="book-date">@book.SubmittedAt.ToString("MMM dd, yyyy")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(book.Description))
                        {
                            <div class="book-desc">@book.Description</div>
                        }

                        <div class="book-submitter" style="display:flex;align-items:center;gap:.3rem;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            Submitted by <strong>@book.PublishedByEmail</strong>
                        </div>

                        @* Single Review button — Approve/Reject is on the detail page *@
                        <div class="book-actions">
                            <a asp-controller="Admin" asp-action="PendingBookDetail" asp-route-id="@book.Id"
                               class="btn-review" style="display:inline-flex;align-items:center;gap:.35rem;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Review Book
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}
