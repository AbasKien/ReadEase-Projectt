@model ReadEase.ViewModels.Admin.PendingBookViewModel
@{
    ViewData["Title"] = "Review: " + Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .pd-wrap {
        max-width: 860px;
        margin: 0 auto;
    }

    .pd-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 55%, #0f0d2e 100%);
        border-radius: 20px;
        padding: 1.75rem 2rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }

        .pd-hero::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 65%);
            pointer-events: none;
        }

    .pd-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .pd-hero-label {
        font-size: .68rem;
        font-weight: 800;
        color: rgba(255,255,255,.45);
        text-transform: uppercase;
        letter-spacing: .9px;
        margin-bottom: .2rem;
    }

    .pd-hero-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.4rem;
        font-weight: 900;
        color: #fff;
        margin: 0;
    }

    .pd-back-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        border: 1.5px solid rgba(255,255,255,.2);
        border-radius: 10px;
        color: #fff;
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: .82rem;
        padding: .5rem 1.1rem;
        text-decoration: none;
        transition: background .15s;
    }

        .pd-back-btn:hover {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    /* ── Action bar ── */
    .pd-action-bar {
        background: #fff;
        border: 1.5px solid #ede9e2;
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        box-shadow: 0 2px 12px rgba(0,0,0,.05);
    }

    .pd-action-label {
        font-family: 'Nunito', sans-serif;
        font-size: .9rem;
        font-weight: 800;
        color: #1a1a2e;
    }

        .pd-action-label span {
            font-size: .78rem;
            font-weight: 600;
            color: #9994a8;
            display: block;
            margin-top: .1rem;
        }

    .pd-action-btns {
        display: flex;
        gap: .65rem;
        flex-wrap: wrap;
    }

    .btn-approve {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #10b981;
        color: #fff;
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: .85rem;
        padding: .6rem 1.4rem;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
    }

        .btn-approve:hover {
            background: #059669;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 14px rgba(16,185,129,.35);
        }

    .btn-reject {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        color: #dc2626;
        font-family: 'Nunito', sans-serif;
        font-weight: 800;
        font-size: .85rem;
        padding: .6rem 1.4rem;
        border-radius: 10px;
        border: 1.5px solid #fca5a5;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-reject:hover {
            background: #fef2f2;
            transform: translateY(-1px);
        }

    /* ── Book detail card ── */
    .pd-card {
        background: #fff;
        border: 1.5px solid #ede9e2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,.06);
        margin-bottom: 1.5rem;
    }

    .pd-book-top {
        display: flex;
        gap: 2rem;
        padding: 2rem;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .pd-cover {
        width: 160px;
        min-width: 160px;
        height: 220px;
        border-radius: 12px;
        object-fit: cover;
        box-shadow: 0 8px 28px rgba(0,0,0,.18);
        flex-shrink: 0;
    }

    .pd-cover-ph {
        width: 160px;
        min-width: 160px;
        height: 220px;
        border-radius: 12px;
        background: linear-gradient(135deg, #e2e0f9, #c7d2fe);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3.5rem;
        flex-shrink: 0;
        box-shadow: 0 8px 28px rgba(0,0,0,.12);
    }

    .pd-book-info {
        flex: 1;
        min-width: 0;
    }

    .pd-premium-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: #fef9e7;
        color: #92400e;
        border: 1px solid rgba(217,119,6,.2);
        border-radius: 20px;
        font-size: .68rem;
        font-weight: 900;
        padding: .2rem .7rem;
        margin-bottom: .75rem;
    }

    .pd-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.65rem;
        font-weight: 900;
        color: #1a1a2e;
        line-height: 1.2;
        margin-bottom: .25rem;
    }

    .pd-author {
        font-size: .92rem;
        color: #9994a8;
        font-weight: 600;
        margin-bottom: .85rem;
    }

    .pd-meta-row {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
        margin-bottom: .9rem;
    }

    .pd-meta-chip {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        background: #f5f4f0;
        border: 1px solid #ede9e2;
        border-radius: 20px;
        font-size: .72rem;
        font-weight: 700;
        color: #4b4861;
        padding: .22rem .75rem;
    }

    .pd-submitter {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #f9f8f6;
        border: 1px solid #f0eeea;
        border-radius: 10px;
        padding: .5rem .85rem;
        font-size: .78rem;
        font-weight: 600;
        color: #6b7280;
    }

        .pd-submitter strong {
            color: #4f46e5;
        }

    /* ── Description ── */
    .pd-section {
        border-top: 1px solid #f0eeea;
        padding: 1.5rem 2rem;
    }

    .pd-section-label {
        font-family: 'Nunito', sans-serif;
        font-size: .68rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #9994a8;
        margin-bottom: .65rem;
    }

    .pd-desc-text {
        font-size: .9rem;
        color: #4b4861;
        line-height: 1.7;
        font-weight: 500;
    }

    /* ── Reject form ── */
    .reject-panel {
        display: none;
        background: #fff5f5;
        border: 1.5px solid #fca5a5;
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
    }

        .reject-panel.open {
            display: block;
        }

    .reject-label {
        font-size: .72rem;
        font-weight: 900;
        color: #dc2626;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: .5rem;
        display: block;
    }

    .reject-textarea {
        width: 100%;
        border: 1.5px solid #fca5a5;
        border-radius: 10px;
        padding: .65rem .85rem;
        font-family: 'Nunito', sans-serif;
        font-size: .85rem;
        color: #1a1a2e;
        resize: none;
        min-height: 90px;
        outline: none;
        background: #fff;
        transition: border-color .15s;
    }

        .reject-textarea:focus {
            border-color: #dc2626;
        }

    .fade-up {
        animation: fadeUp .4s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }
</style>

<div class="pd-wrap">

    @* ── ALERTS ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @* ── HEADER ── *@
    <div class="pd-hero fade-up">
        <div class="pd-hero-inner">
            <div>
                <div class="pd-hero-label">Admin · Content Review</div>
                <div class="pd-hero-title" style="display:flex;align-items:center;gap:.6rem;">
                    <div style="width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </div>
                    Review Premium Book Submission
                </div>
            </div>
            <a asp-controller="Admin" asp-action="PendingBooks" class="pd-back-btn">
                ← Back to Pending
            </a>
        </div>
    </div>

    @* ── APPROVE / REJECT ACTION BAR ── *@
    <div class="pd-action-bar fade-up">
        <div class="pd-action-label">
            Make a decision
            <span>Approve to publish, or reject with a reason sent to the author.</span>
        </div>
        <div class="pd-action-btns">
            <form asp-controller="Admin" asp-action="ApprovePremiumBook" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="bookId" value="@Model.Id" />
                <button type="submit" class="btn-approve"
                        onclick="return confirm('Approve and publish this premium book?')"
                        style="display:inline-flex;align-items:center;gap:.35rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Approve
                </button>
            </form>
            <button type="button" class="btn-reject" onclick="toggleReject()"
                    style="display:inline-flex;align-items:center;gap:.35rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Reject
            </button>
        </div>
    </div>

    @* ── REJECT PANEL ── *@
    <div class="reject-panel fade-up" id="rejectPanel">
        <form asp-controller="Admin" asp-action="RejectPremiumBook" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BookId" value="@Model.Id" />
            <label class="reject-label">Rejection Reason</label>
            <textarea name="Reason" class="reject-textarea"
                      placeholder="Explain why this book was not approved…"
                      maxlength="500" required></textarea>
            <div style="display:flex;gap:.5rem;margin-top:.75rem;">
                <button type="submit"
                        style="flex:1;padding:.6rem;border-radius:10px;border:none;
                               background:#dc2626;color:#fff;font-family:'Nunito',sans-serif;
                               font-weight:800;font-size:.85rem;cursor:pointer;">
                    Send Rejection
                </button>
                <button type="button" onclick="toggleReject()"
                        style="flex:1;padding:.6rem;border-radius:10px;
                               border:1.5px solid #e8e3dc;background:#fff;
                               font-family:'Nunito',sans-serif;font-weight:700;
                               font-size:.85rem;cursor:pointer;">
                    Cancel
                </button>
            </div>
        </form>
    </div>

    @* ── BOOK DETAIL CARD ── *@
    <div class="pd-card fade-up">
        <div class="pd-book-top">
            @* Cover *@
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <img src="@Model.CoverImage" alt="@Model.Title" class="pd-cover" />
            }
            else
            {
                <div class="pd-cover-ph">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.5)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                </div>
            }

            @* Info *@
            <div class="pd-book-info">
                <div class="pd-premium-badge" style="display:inline-flex;align-items:center;gap:.3rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="#fbbf24" stroke="#fbbf24" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    Premium Submission
                </div>
                <div class="pd-title">@Model.Title</div>
                <div class="pd-author">by @Model.Author</div>

                <div class="pd-meta-row">
                    <span class="pd-meta-chip" style="display:inline-flex;align-items:center;gap:.25rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                        @Model.Category
                    </span>
                    <span class="pd-meta-chip" style="display:inline-flex;align-items:center;gap:.25rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Submitted @Model.SubmittedAt.ToString("MMMM dd, yyyy")
                    </span>
                </div>

                <div class="pd-submitter" style="display:flex;align-items:center;gap:.3rem;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Submitted by <strong>@Model.PublishedByEmail</strong>
                </div>
            </div>
        </div>

        @* Description *@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="pd-section">
                <div class="pd-section-label">Description</div>
                <div class="pd-desc-text">@Model.Description</div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        function toggleReject() {
            document.getElementById('rejectPanel').classList.toggle('open');
        }
    </script>
}