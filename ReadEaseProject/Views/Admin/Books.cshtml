@model List<ReadEase.ViewModels.Admin.BookManagementViewModel>
@{
    ViewData["Title"] = "Book Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .re-blob {
        position: fixed;
        background: #f26522;
        pointer-events: none;
        z-index: 0;
        opacity: .06;
    }

    .re-blob-tl {
        width: 320px;
        height: 640px;
        top: -180px;
        left: -120px;
        border-radius: 38% 62% 55% 45%/42% 38% 62% 58%;
        animation: blobA 9s ease-in-out infinite;
    }

    .re-blob-br {
        width: 300px;
        height: 580px;
        bottom: -180px;
        right: -110px;
        border-radius: 55% 45% 38% 62%/60% 42% 58% 40%;
        animation: blobB 11s ease-in-out infinite;
    }

    @@keyframes blobA {
        0%, 100% {
            border-radius: 38% 62% 55% 45%/42% 38% 62% 58%
        }

        33% {
            border-radius: 55% 45% 40% 60%/55% 45% 58% 42%
        }

        66% {
            border-radius: 45% 55% 62% 38%/40% 58% 42% 60%
        }
    }

    @@keyframes blobB {
        0%, 100% {
            border-radius: 55% 45% 38% 62%/60% 42% 58% 40%
        }

        33% {
            border-radius: 40% 60% 58% 42%/45% 55% 40% 60%
        }

        66% {
            border-radius: 62% 38% 45% 55%/55% 45% 62% 38%
        }
    }

    .re-hero {
        background: linear-gradient(135deg,#7f1d1d 0%,#991b1b 55%,#450a0a 100%);
        border-radius: 20px;
        padding: 2.25rem 2.5rem;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
    }

        .re-hero::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle,rgba(255,255,255,.08) 0%,transparent 65%);
            pointer-events: none;
        }

    .re-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .re-hero-title {
        font-family: 'Nunito',sans-serif;
        font-size: 1.9rem;
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        margin: 0;
    }

    .re-hero-sub {
        font-size: .88rem;
        color: rgba(255,255,255,.5);
        font-weight: 600;
        margin-top: .2rem;
    }

    .re-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 10px;
        color: rgba(255,255,255,.8) !important;
        font-family: 'Nunito',sans-serif;
        font-weight: 700;
        font-size: .82rem;
        padding: .45rem 1rem;
        text-decoration: none !important;
        transition: background .18s;
    }

        .re-btn-ghost:hover {
            background: rgba(255,255,255,.18);
            color: #fff !important;
        }

    .re-stat {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 16px;
        padding: 1.1rem 1.25rem;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
        position: relative;
        overflow: hidden;
    }

        .re-stat::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            width: 0;
            background: #f26522;
            transition: width .3s ease;
        }

        .re-stat:hover::before {
            width: 100%;
        }

    .re-stat-val {
        font-family: 'Nunito',sans-serif;
        font-size: 1.8rem;
        font-weight: 900;
        color: #1a1a2e;
        line-height: 1;
    }

    .re-stat-lbl {
        font-size: .7rem;
        font-weight: 800;
        color: #9994a8;
        text-transform: uppercase;
        letter-spacing: .55px;
        margin-top: .2rem;
    }

    .filter-bar {
        display: flex;
        gap: .75rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
    }

    .re-input {
        border: 1.5px solid #e8e3dc;
        border-radius: 10px;
        padding: .55rem .9rem;
        font-size: .875rem;
        transition: border-color .18s;
        font-family: 'Nunito',sans-serif;
    }

        .re-input:focus {
            border-color: #f26522;
            box-shadow: 0 0 0 3px rgba(242,101,34,.12);
            outline: none;
        }

    .re-table-wrap {
        background: #fff;
        border: 1px solid #e8e3dc;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
        position: relative;
        z-index: 2;
    }

    .re-table thead th {
        background: #991b1b !important;
        color: rgba(255,255,255,.82) !important;
        font-size: .68rem !important;
        text-transform: uppercase;
        letter-spacing: .65px;
        padding: .85rem 1.1rem !important;
        border: none !important;
    }

    .re-table td {
        padding: .78rem 1.1rem !important;
        vertical-align: middle;
        font-size: .855rem;
        border-color: #f0eeea !important;
    }

    .re-table tbody tr:hover {
        background: #fef2f2 !important;
    }

    .re-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .88rem;
        cursor: pointer;
        transition: all .16s;
        text-decoration: none;
    }

        .re-icon-btn.view {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #059669;
        }

        .re-icon-btn.del {
            background: #fef2f2;
            border-color: #fecaca;
            color: #dc2626;
        }

    .fade-up {
        animation: fadeUp .45s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(18px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* ── PAGINATION ── */
    .re-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: 1rem;
        position: relative;
        z-index: 2;
    }

    .re-page-info {
        font-family: 'Nunito',sans-serif;
        font-size: .78rem;
        font-weight: 700;
        color: #9994a8;
    }

    .re-page-btns {
        display: flex;
        align-items: center;
        gap: .3rem;
    }

    .re-page-btn {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        border: 1.5px solid #e8e3dc;
        background: #fff;
        font-family: 'Nunito',sans-serif;
        font-size: .78rem;
        font-weight: 800;
        color: #6b6878;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        padding: 0;
    }

        .re-page-btn:hover:not(:disabled) {
            border-color: #f26522;
            color: #f26522;
            background: #fff3ed;
        }

        .re-page-btn.active {
            background: #f26522;
            border-color: #f26522;
            color: #fff;
        }

        .re-page-btn:disabled {
            opacity: .35;
            cursor: default;
        }

        .re-page-btn.prev-next {
            width: auto;
            padding: 0 .65rem;
            gap: .25rem;
            font-size: .72rem;
        }
</style>

<div class="re-blob re-blob-tl"></div>
<div class="re-blob re-blob-br"></div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="re-hero fade-up">
    <div class="re-hero-inner">
        <div>
            <div class="re-hero-title" style="display:flex;align-items:center;gap:.65rem;">
                <div style="width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                Book Management
            </div>
            <div class="re-hero-sub">All books published on ReadEase</div>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="re-btn-ghost">← Dashboard</a>
    </div>
</div>

<div class="row g-3 mb-4 fade-up">
    <div class="col-6 col-md-3"><div class="re-stat"><div class="re-stat-val">@Model.Count</div><div class="re-stat-lbl">Total Books</div></div></div>
    <div class="col-6 col-md-3"><div class="re-stat"><div class="re-stat-val" style="color:#16a34a;">@Model.Count(b => b.IsFree)</div><div class="re-stat-lbl">Free</div></div></div>
    <div class="col-6 col-md-3"><div class="re-stat"><div class="re-stat-val" style="color:#d97706;">@Model.Count(b => !b.IsFree)</div><div class="re-stat-lbl">Premium</div></div></div>
    <div class="col-6 col-md-3"><div class="re-stat"><div class="re-stat-val" style="color:#f26522;">@Model.Sum(b => b.ReadCount)</div><div class="re-stat-lbl">Total Reads</div></div></div>
</div>

<div class="filter-bar fade-up">
    <input type="text" id="bookSearch" class="re-input" placeholder="Search title, author, category…" style="max-width:320px;" />
    <select id="typeFilter" class="re-input" style="max-width:160px;">
        <option value="">All Types</option>
        <option value="Free">Free</option>
        <option value="Premium">Premium</option>
    </select>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5" style="position:relative;z-index:2;">
        <div style="width:64px;height:64px;border-radius:18px;background:#fff3ed;display:flex;align-items:center;justify-content:center;margin:0 auto .85rem;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f26522" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </div>
        <h5 class="mt-3" style="font-family:'Nunito',sans-serif;font-weight:900;">No books yet</h5>
    </div>
}
else
{
    <div class="re-table-wrap fade-up">
        <div class="table-responsive">
            <table class="table re-table align-middle mb-0" id="booksTable">
                <thead>
                    <tr>
                        <th style="width:55px;">Cover</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th>Published</th>
                        <th class="text-center">Reads</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model.OrderByDescending(b => b.PublishedAt))
                    {
                        <tr class="@(book.IsDeleted ? "text-muted" : "")">
                            <td>
                                @if (!string.IsNullOrEmpty(book.CoverImage))
                                {
                                    <img src="@book.CoverImage" class="rounded" style="width:40px;height:52px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="rounded d-flex align-items-center justify-content-center text-white" style="width:40px;height:52px;background:linear-gradient(135deg,#667eea,#764ba2);">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                    </div>
                                }
                            </td>
                            <td><div class="fw-semibold">@book.Title</div><div class="text-muted" style="font-size:.72rem;">@book.AuthorEmail</div></td>
                            <td class="fw-semibold small">@book.Author</td>
                            <td><span class="badge bg-secondary rounded-pill" style="font-size:.62rem;">@book.Category</span></td>
                            <td><span class="badge rounded-pill @(book.IsFree ? "bg-success" : "bg-warning text-dark")" style="font-size:.62rem;">@(book.IsFree ? "Free" : "Premium")</span></td>
                            <td class="text-muted small">@book.PublishedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-center fw-bold" style="color:#dc2626;">@book.ReadCount</td>
                            <td><span class="badge rounded-pill @(book.IsDeleted ? "bg-danger" : "bg-success")" style="font-size:.62rem;">@(book.IsDeleted ? "Deleted" : "Live")</span></td>
                            <td class="text-end">
                                @if (!book.IsDeleted)
                                {
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a asp-controller="Library" asp-action="Detail" asp-route-id="@book.Id" class="re-icon-btn view">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                        <form asp-controller="Admin" asp-action="DeleteBook" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookId" value="@book.Id" />
                                            <button type="submit" class="re-icon-btn del" onclick="return confirm('Move to archive?')">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Admin" asp-action="Archive" class="btn btn-sm btn-outline-success rounded-pill" style="font-size:.72rem;display:inline-flex;align-items:center;gap:.3rem;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>
                                        Archive
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2" style="position:relative;z-index:2;">Showing @Model.Count book(s)</p>
    <div class="re-pagination" id="booksPagination">
        <span class="re-page-info" id="booksPageInfo"></span>
        <div class="re-page-btns" id="booksPageBtns"></div>
    </div>
}

@section Scripts {
    <script>
        const PAGE_SIZE = 10;
        let booksCurrentPage = 1;

        function renderBooksPagination() {
            const allRows = Array.from(document.querySelectorAll('#booksTable tbody tr'));
            const visible = allRows.filter(r => !r.dataset.filtered);
            const total = visible.length;
            const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
            booksCurrentPage = Math.min(booksCurrentPage, totalPages);
            const start = (booksCurrentPage - 1) * PAGE_SIZE;
            visible.forEach((r, i) => { r.style.display = (i >= start && i < start + PAGE_SIZE) ? '' : 'none'; });

            const info = document.getElementById('booksPageInfo');
            const btns = document.getElementById('booksPageBtns');
            const showing = Math.min(PAGE_SIZE, total - start);
            info.textContent = total === 0 ? 'No results' : `Showing ${start + 1}–${start + showing} of ${total} book(s)`;

            btns.innerHTML = '';
            if (totalPages <= 1) { document.getElementById('booksPagination').style.display = 'none'; return; }
            document.getElementById('booksPagination').style.display = 'flex';

            const prev = document.createElement('button');
            prev.className = 're-page-btn prev-next'; prev.textContent = '← Prev';
            prev.disabled = booksCurrentPage === 1;
            prev.onclick = () => { booksCurrentPage--; renderBooksPagination(); };
            btns.appendChild(prev);

            for (let p = 1; p <= totalPages; p++) {
                if (totalPages > 7 && p > 2 && p < totalPages - 1 && Math.abs(p - booksCurrentPage) > 1) {
                    if (p === 3 || p === totalPages - 2) { const d = document.createElement('span'); d.className = 're-page-info'; d.style.padding = '0 .2rem'; d.textContent = '…'; btns.appendChild(d); }
                    continue;
                }
                const b = document.createElement('button');
                b.className = 're-page-btn' + (p === booksCurrentPage ? ' active' : '');
                b.textContent = p;
                b.onclick = () => { booksCurrentPage = p; renderBooksPagination(); };
                btns.appendChild(b);
            }

            const next = document.createElement('button');
            next.className = 're-page-btn prev-next'; next.textContent = 'Next →';
            next.disabled = booksCurrentPage === totalPages;
            next.onclick = () => { booksCurrentPage++; renderBooksPagination(); };
            btns.appendChild(next);
        }

        const se = document.getElementById('bookSearch');
        const te = document.getElementById('typeFilter');
        function applyFilters() {
            const q = se.value.toLowerCase(), t = te.value.toLowerCase();
            document.querySelectorAll('#booksTable tbody tr').forEach(r => {
                const match = (!q || r.innerText.toLowerCase().includes(q)) && (!t || r.innerText.toLowerCase().includes(t));
                r.dataset.filtered = match ? '' : '1';
                if (!match) r.style.display = 'none';
            });
            booksCurrentPage = 1;
            renderBooksPagination();
        }
        se.addEventListener('input', applyFilters);
        te.addEventListener('change', applyFilters);

        renderBooksPagination();
    </script>
}
