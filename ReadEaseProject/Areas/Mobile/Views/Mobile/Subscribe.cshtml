@using ReadEase.Enums
@model ReadEase.ViewModels.Subscribe.SubscribeViewModel

@{
    ViewData["Title"] = "Subscribe";
    Layout = "~/Areas/Mobile/Views/Shared/_MobileLayout.cshtml";

    var tier = Model.CurrentTier;
    var isFree = tier == SubscriptionTier.Free;
    var isPremium = tier == SubscriptionTier.Premium;
    var isPremiumPlus = tier == SubscriptionTier.PremiumPlus;
    var hasPending = Model.CurrentStatus == SubscriptionStatus.Pending;
    var wasRejected = Model.CurrentStatus == SubscriptionStatus.Rejected;
    var premiumPending = hasPending && Model.RequestedTier == SubscriptionTier.Premium;
    var premPlusPending = hasPending && Model.RequestedTier == SubscriptionTier.PremiumPlus;
}

<style>
    .sub-page { padding-bottom: max(2rem, env(safe-area-inset-bottom, 2rem)); padding-top: max(0px, env(safe-area-inset-top, 0px)); direction: ltr; }
    

    /* ── Current plan hero ── */
    .sub-hero {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        border-radius: 18px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1.5rem;
    }
    .sub-hero-icon {
        width: 46px; height: 46px;
        border-radius: 13px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; flex-shrink: 0;
        overflow: hidden;
    }
    .sub-hero-icon svg { width: 24px; height: 24px; flex-shrink: 0; }
    .sub-hero-icon.free    { background: var(--re-surface-2); }
    .sub-hero-icon.premium { background: rgba(234,179,8,.12); }
    .sub-hero-icon.premplus { background: rgba(139,92,246,.12); }
    .sub-hero-text { flex: 1; min-width: 0; }
    .sub-hero-label { font-size: .68rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; color: var(--re-muted); margin-bottom: .18rem; }
    .sub-hero-plan { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 700; color: var(--re-text); }
    .sub-hero-plan.premium  { color: #eab308; }
    .sub-hero-plan.premplus { color: #a78bfa; }
    .sub-hero-badge { display: inline-flex; align-items: center; gap: .3rem; font-size: .7rem; font-weight: 800; padding: .22rem .75rem; border-radius: 99px; flex-shrink: 0; }
    .badge-active  { background: rgba(34,197,94,.12);  color: #22c55e; border: 1px solid rgba(34,197,94,.2); }
    .badge-pending { background: rgba(234,179,8,.12);  color: #eab308; border: 1px solid rgba(234,179,8,.2); }
    .badge-free    { background: var(--re-surface-2); color: var(--re-muted); border: 1px solid var(--re-border); }

    /* ── Alerts ── */
    .sub-alert { padding: .85rem 1.1rem; border-radius: 14px; font-size: .82rem; font-weight: 700; margin-bottom: 1.2rem; display: flex; align-items: flex-start; gap: .6rem; line-height: 1.45; }
    .sub-alert.success { background: rgba(34,197,94,.1);  color: #22c55e; border: 1px solid rgba(34,197,94,.2); }
    .sub-alert.error   { background: rgba(239,68,68,.1);  color: #ef4444; border: 1px solid rgba(239,68,68,.2); }

    .sub-section-title { font-size: .62rem; font-weight: 900; color: var(--re-muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .85rem; padding: 0 .15rem; }

    /* ── Plan cards — FIXED: horizontal scroll instead of cramped 3-col grid ── */
    .sub-plans-scroll {
        display: flex;
        gap: .85rem;
        overflow-x: auto;
        padding-bottom: .75rem;
        margin-bottom: 1.6rem;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
    }
    .sub-plans-scroll::-webkit-scrollbar { display: none; }

    .plan-card {
        flex-shrink: 0;
        width: calc(75vw - 1rem);
        max-width: 240px;
        min-width: 180px;
        background: var(--re-surface);
        border: 1.5px solid var(--re-border);
        border-radius: 20px;
        padding: 1.1rem 1rem 1.1rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        scroll-snap-align: start;
        transition: border-color .2s, box-shadow .2s;
        overflow: hidden;
    }
    .plan-card.current                { border-color: rgba(242,101,34,.4);   box-shadow: 0 0 0 3px rgba(242,101,34,.08), 0 6px 24px rgba(0,0,0,.25); }
    .plan-card.premium-card.current   { border-color: rgba(234,179,8,.5);    box-shadow: 0 0 0 3px rgba(234,179,8,.1); }
    .plan-card.premplus-card.current  { border-color: rgba(139,92,246,.5);   box-shadow: 0 0 0 3px rgba(139,92,246,.1); }

    .plan-your-tag { position: absolute; top: 0; left: 0; right: 0; font-size: .6rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; padding: .3rem .5rem; text-align: center; }
    .plan-card.current .plan-your-tag               { background: rgba(242,101,34,.18); color: var(--re-orange); }
    .plan-card.premium-card.current .plan-your-tag  { background: rgba(234,179,8,.15);  color: #eab308; }
    .plan-card.premplus-card.current .plan-your-tag { background: rgba(139,92,246,.15); color: #a78bfa; }

    .plan-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; margin-bottom: .5rem; margin-top: .75rem; flex-shrink: 0; }
    .plan-icon svg { width: 28px; height: 28px; flex-shrink: 0; }
    .plan-name { font-size: .88rem; font-weight: 900; color: var(--re-text); margin-bottom: .2rem; }
    .plan-price { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: var(--re-text); line-height: 1; margin-bottom: .1rem; }
    .plan-price.premium-price  { color: #eab308; }
    .plan-price.premplus-price { color: #a78bfa; }
    .plan-cadence { font-size: .66rem; color: var(--re-muted); font-weight: 700; margin-bottom: .85rem; }

    .plan-features { list-style: none; padding: 0; margin: 0 0 1rem; width: 100%; text-align: left; }
    .plan-features li { font-size: .72rem; font-weight: 700; color: var(--re-muted); padding: .22rem 0; display: flex; align-items: center; gap: .4rem; }
    .plan-features li.on  { color: var(--re-text); }
    .plan-features li .fi { font-size: .7rem; flex-shrink: 0; }
    .plan-features li.on .fi  { color: #22c55e; }
    .plan-features li.off .fi { color: var(--re-border); }

    .plan-btn { width: 100%; padding: .65rem .4rem; border-radius: 12px; border: none; font-size: .8rem; font-weight: 900; cursor: pointer; transition: opacity .18s, transform .15s; font-family: 'Nunito', sans-serif; min-height: 44px; }
    .plan-btn:active { transform: scale(.97); opacity: .85; }
    .plan-btn.btn-gold    { background: linear-gradient(135deg, #eab308, #ca8a04); color: #1a1200; }
    .plan-btn.btn-violet  { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; }
    .plan-btn.btn-disabled { background: var(--re-border); color: var(--re-muted); cursor: default; pointer-events: none; }

    .plan-current-label { font-size: .72rem; font-weight: 900; padding: .5rem .4rem; border-radius: 12px; width: 100%; text-align: center; min-height: 44px; display: flex; align-items: center; justify-content: center; }
    .plan-current-label.orange { color: var(--re-orange); background: rgba(242,101,34,.1); }
    .plan-current-label.gold   { color: #eab308; background: rgba(234,179,8,.1); }
    .plan-current-label.violet { color: #a78bfa; background: rgba(139,92,246,.1); }

    /* scroll hint */
    .sub-plans-hint { font-size: .66rem; color: var(--re-muted); font-weight: 600; text-align: center; margin-top: -.5rem; margin-bottom: 1rem; }

    /* ── Features comparison table ── */
    .sub-features { background: var(--re-surface); border: 1px solid var(--re-border); border-radius: 18px; overflow: hidden; margin-bottom: 1.5rem; }
    .sub-feat-row { display: flex; align-items: center; justify-content: space-between; padding: .75rem 1.1rem; border-bottom: 1px solid var(--re-border); font-size: .8rem; }
    .sub-feat-row:last-child { border-bottom: none; }
    .sub-feat-label { font-weight: 700; color: var(--re-text); flex: 1; }
    .sub-feat-tiers { display: flex; gap: .9rem; }
    .tier-dot { width: 22px; text-align: center; font-size: .75rem; }
    .tier-dot.yes { color: #22c55e; }
    .tier-dot.no  { color: var(--re-border); }
    .sub-feat-header { display: flex; justify-content: flex-end; gap: .9rem; padding: .55rem 1.1rem; background: rgba(255,255,255,.03); border-bottom: 1px solid var(--re-border); }
    .sub-feat-header span { width: 22px; font-size: .58rem; font-weight: 900; text-align: center; text-transform: uppercase; letter-spacing: .04em; color: var(--re-muted); }

    /* ── Form ── */
    .sub-form-card { background: var(--re-surface); border: 1px solid var(--re-border); border-radius: 18px; padding: 1.25rem; margin-bottom: 1rem; }
    .sub-form-title { font-size: .92rem; font-weight: 900; color: var(--re-text); margin-bottom: .3rem; }
    .sub-form-desc { font-size: .74rem; color: var(--re-muted); font-weight: 600; margin-bottom: 1.1rem; line-height: 1.45; }

    .sub-upload-area { border: 2px dashed var(--re-border); border-radius: 14px; padding: 1.5rem 1rem; text-align: center; cursor: pointer; transition: border-color .2s, background .2s; margin-bottom: 1rem; position: relative; }
    .sub-upload-area:hover, .sub-upload-area.has-file { border-color: rgba(242,101,34,.4); background: rgba(242,101,34,.04); }
    .sub-upload-area input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
    .sub-upload-icon { font-size: 1.8rem; margin-bottom: .4rem; }
    .sub-upload-text { font-size: .78rem; font-weight: 800; color: var(--re-muted); }
    .sub-upload-sub  { font-size: .66rem; color: var(--re-muted); font-weight: 600; margin-top: .2rem; }
    .sub-upload-name { font-size: .75rem; font-weight: 800; color: var(--re-orange); margin-top: .3rem; display: none; }

    .sub-submit-btn { width: 100%; padding: .9rem; border-radius: 14px; border: none; background: var(--re-orange); color: #fff; font-size: .92rem; font-weight: 900; cursor: pointer; font-family: 'Nunito', sans-serif; display: flex; align-items: center; justify-content: center; gap: .5rem; transition: opacity .18s, transform .15s; min-height: 52px; }
    .sub-submit-btn:active   { opacity: .85; transform: scale(.98); }
    .sub-submit-btn:disabled { opacity: .4; cursor: default; }

    /* Pending card */
    .sub-pending-card { background: rgba(234,179,8,.07); border: 1px solid rgba(234,179,8,.2); border-radius: 18px; padding: 1.4rem 1.25rem; text-align: center; margin-bottom: 1rem; }
    .sub-pending-icon  { font-size: 2rem; margin-bottom: .6rem; }
    .sub-pending-title { font-size: 1rem; font-weight: 900; color: #eab308; margin-bottom: .3rem; }
    .sub-pending-desc  { font-size: .78rem; color: var(--re-muted); font-weight: 600; line-height: 1.5; }
    .sub-pending-time  { font-size: .7rem; color: var(--re-muted); font-weight: 700; margin-top: .6rem; }

    .sub-payment-info { background: rgba(59,130,246,.07); border: 1px solid rgba(59,130,246,.18); border-radius: 14px; padding: .9rem 1.1rem; margin-bottom: 1.1rem; font-size: .76rem; font-weight: 700; color: var(--re-orange); line-height: 1.5; }
    .sub-payment-info strong { color: var(--re-orange-dark); display: block; margin-bottom: .2rem; font-size: .8rem; }
</style>

<div class="sub-page">

    <div class="mob-page-header">
        <a href="/Mobile/Profile" class="mob-back-btn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        </a>
        <div class="mob-page-title">My Plan</div>
    </div>

    @* ── Current Plan Hero ── *@
    <div class="sub-hero">
        <div class="sub-hero-icon @(isPremiumPlus ? "premplus" : isPremium ? "premium" : "free")">
            @if (isPremiumPlus)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            }
            else if (isPremium)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            }
        </div>
        <div class="sub-hero-text">
            <div class="sub-hero-label">Your Current Plan</div>
            <div class="sub-hero-plan @(isPremiumPlus ? "premplus" : isPremium ? "premium" : "")">
                @if (isPremiumPlus)
                {
                    <text>Premium++</text>
                }
                else if (isPremium)
                {

                    <text>Premium</text>
                }
                else
                {

                    <text>Free</text>
                }
            </div>
        </div>
        @if (hasPending)
        {
            <span class="sub-hero-badge badge-pending">Pending</span>
        }
        else if (!isFree)
        {

            <span class="sub-hero-badge badge-active">✓ Active</span>
        }
        else
        {

            <span class="sub-hero-badge badge-free">Free</span>
        }
    </div>

    @* ── Alerts ── *@
    @if (TempData["SuccessMessage"] is string successMsg)
    {
        <div class="sub-alert success"><span>@successMsg</span></div>
    }
    @if (TempData["ErrorMessage"] is string errorMsg)
    {
        <div class="sub-alert error"> <span>@errorMsg</span></div>
    }
    @if (wasRejected && !string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="sub-alert error">
            Error: <span>Your request was rejected: <strong>@Model.RejectionReason</strong>. Please resubmit with a valid receipt.</span>
        </div>
    }

    @* ── Available Plans — horizontal scroll ── *@
    <div class="sub-section-title">Available Plans</div>
    <div class="sub-plans-scroll">

        @* FREE *@
        <div class="plan-card @(isFree ? "current" : "")">
            @if (isFree)
            {
                <div class="plan-your-tag">YOUR PLAN</div>
            }
            <div class="plan-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--re-muted)"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
            <div class="plan-name">Free</div>
            <div class="plan-price">₱0</div>
            <div class="plan-cadence">always free</div>
            <ul class="plan-features">
                <li class="on"><span class="fi">✓</span> Free books</li>
                <li class="off"><span class="fi">✗</span> Premium books</li>
                <li class="on"><span class="fi">✓</span> Notifications</li>
                <li class="off"><span class="fi">✗</span> Downloads</li>
                <li class="off"><span class="fi">✗</span> AI Voice</li>
                <li class="off"><span class="fi">✗</span> AI Chatbot</li>
            </ul>
            @if (isFree)
            {
                <div class="plan-current-label orange">✓ Your Plan</div>
            }
            else
            {

                <div class="plan-btn btn-disabled">—</div>
            }
        </div>

        @* PREMIUM *@
        <div class="plan-card premium-card @(isPremium ? "current" : "")">
            @if (isPremium)
            {
                <div class="plan-your-tag">YOUR PLAN</div>
            }
            <div class="plan-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></div>
            <div class="plan-name">Premium</div>
            <div class="plan-price premium-price">₱99</div>
            <div class="plan-cadence">per month</div>
            <ul class="plan-features">
                <li class="on"><span class="fi">✓</span> Free books</li>
                <li class="on"><span class="fi">✓</span> Premium books</li>
                <li class="on"><span class="fi">✓</span> Notifications</li>
                <li class="off"><span class="fi">✗</span> Downloads</li>
                <li class="off"><span class="fi">✗</span> AI Voice</li>
                <li class="on"><span class="fi">✓</span> AI Chatbot</li>
            </ul>
            @if (isPremium)
            {
                <div class="plan-current-label gold">✓ Your Plan</div>
            }
            else if (isPremiumPlus)
            {

                <div class="plan-btn btn-disabled">—</div>
            }
            else if (premiumPending)
            {

                <div class="plan-btn btn-disabled">Pending</div>
            }
            else
            {
                <button type="button" class="plan-btn btn-gold" onclick="selectPlan('Premium', '11', this)">Select</button>
            }
        </div>

        @* PREMIUM++ *@
        <div class="plan-card premplus-card @(isPremiumPlus ? "current" : "")">
            @if (isPremiumPlus)
            {
                <div class="plan-your-tag">YOUR PLAN</div>
            }
            <div class="plan-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
            <div class="plan-name">Premium++</div>
            <div class="plan-price premplus-price">₱199</div>
            <div class="plan-cadence">per month</div>
            <ul class="plan-features">
                <li class="on"><span class="fi">✓</span> Free books</li>
                <li class="on"><span class="fi">✓</span> Premium books</li>
                <li class="on"><span class="fi">✓</span> Notifications</li>
                <li class="on"><span class="fi">✓</span> Downloads</li>
                <li class="on"><span class="fi">✓</span> AI Voice</li>
                <li class="on"><span class="fi">✓</span> AI Chatbot</li>
            </ul>
            @if (isPremiumPlus)
            {
                <div class="plan-current-label violet">✓ Your Plan</div>
            }
            else if (premPlusPending)
            {

                <div class="plan-btn btn-disabled">Pending</div>
            }
            else
            {
                <button type="button" class="plan-btn btn-violet" onclick="selectPlan('Premium++', '12', this)">
                    @(isPremium ? "Upgrade ↑" : "Select")
                </button>
            }
        </div>
    </div>
    <div class="sub-plans-hint">← Swipe to compare plans →</div>

    @* ── Features table ── *@
    <div class="sub-section-title">What's Included</div>
    <div class="sub-features">
        <div class="sub-feat-header">
            <span style="color: var(--re-border);">F</span>
            <span style="color:#eab308;">P</span>
            <span style="color:#a78bfa;">P+</span>
        </div>
        <div class="sub-feat-row"><span class="sub-feat-label">Free books</span><div class="sub-feat-tiers"><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span></div></div>
        <div class="sub-feat-row"><span class="sub-feat-label">Premium books</span><div class="sub-feat-tiers"><span class="tier-dot no">✗</span><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span></div></div>
        <div class="sub-feat-row"><span class="sub-feat-label">Notifications</span><div class="sub-feat-tiers"><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span></div></div>
        <div class="sub-feat-row"><span class="sub-feat-label">Book downloads</span><div class="sub-feat-tiers"><span class="tier-dot no">✗</span><span class="tier-dot no">✗</span><span class="tier-dot yes">✓</span></div></div>
        <div class="sub-feat-row"><span class="sub-feat-label">AI Voice reader</span><div class="sub-feat-tiers"><span class="tier-dot no">✗</span><span class="tier-dot no">✗</span><span class="tier-dot yes">✓</span></div></div>
        <div class="sub-feat-row"><span class="sub-feat-label">AI Chatbot</span><div class="sub-feat-tiers"><span class="tier-dot no">✗</span><span class="tier-dot yes">✓</span><span class="tier-dot yes">✓</span></div></div>
    </div>

    @* ── Pending info ── *@
    @if (hasPending)
    {
        <div class="sub-pending-card">
            <div class="sub-pending-icon"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
            <div class="sub-pending-title">Review in Progress</div>
            <div class="sub-pending-desc">
                Your receipt has been submitted for
                <strong style="color:#eab308;">
                    @(Model.RequestedTier == SubscriptionTier.PremiumPlus ? "Premium++" : "Premium")
                </strong>. We'll activate your plan within 24 hours.
            </div>
            @if (Model.SubmittedAt.HasValue)
            {
                <div class="sub-pending-time">Submitted @Model.SubmittedAt.Value.ToString("MMM dd, yyyy · h:mm tt")</div>
            }
        </div>
    }

    @* ── Upload form ── *@
    @if (!isPremiumPlus)
    {
        <div id="subFormCard" class="sub-form-card" style="display:none;">
            <div class="sub-form-title">Submit Payment Receipt</div>
            <div class="sub-form-desc">
                Send your GCash / Maya payment to <strong style="color: var(--re-text);">09XX-XXX-XXXX</strong>
                then upload a screenshot of your receipt below.
                Selected plan: <strong id="selectedPlanLabel" style="color:var(--re-orange);">—</strong>
            </div>
            <div class="sub-payment-info">
                <strong>Payment Details</strong>
                GCash / Maya · 09XX-XXX-XXXX · Account Name: ReadEase PH
            </div>
            <form method="post" action="/Mobile/Subscribe" enctype="multipart/form-data" id="subForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestedTier" id="hiddenTierInput" value="11" />
                <div class="sub-upload-area" id="uploadArea">
                    <input type="file" name="receiptPhoto" id="receiptInput" accept="image/*" onchange="onFileChange(this)" />
                    <div class="sub-upload-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--re-muted);flex-shrink:0"><polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/><path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/></svg></div>
                    <div class="sub-upload-text">Tap to upload receipt</div>
                    <div class="sub-upload-sub">JPG, PNG, WEBP · max 5MB</div>
                    <div class="sub-upload-name" id="uploadFileName"></div>
                </div>
                <button type="submit" class="sub-submit-btn" id="submitBtn" disabled>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Submit Receipt
                </button>
            </form>
        </div>
    }
</div>

<script>
    function selectPlan(label, tierValue, btn) {
        document.getElementById('hiddenTierInput').value = tierValue;
        document.getElementById('selectedPlanLabel').textContent = label;
        document.querySelectorAll('.plan-btn').forEach(b => b.style.outline = '');
        btn.style.outline = '2px solid rgba(255,255,255,.4)';
        var card = document.getElementById('subFormCard');
        if (card) { card.style.display = 'block'; card.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        var input = document.getElementById('receiptInput');
        if (input && input.files.length > 0) document.getElementById('submitBtn').disabled = false;
    }
    function onFileChange(input) {
        var area = document.getElementById('uploadArea');
        var nameEl = document.getElementById('uploadFileName');
        var submitEl = document.getElementById('submitBtn');
        if (input.files && input.files.length > 0) {
            area.classList.add('has-file');
            nameEl.style.display = 'block';
            nameEl.textContent = input.files[0].name;
            submitEl.disabled = false;
        } else {
            area.classList.remove('has-file');
            nameEl.style.display = 'none';
            submitEl.disabled = true;
        }
    }
</script>
