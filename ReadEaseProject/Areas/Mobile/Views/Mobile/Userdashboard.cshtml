@model ReadEase.ViewModels.User.UserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Mobile/Views/Shared/_MobileLayout.cshtml";
    var initial = Model.Name.Length > 0 ? Model.Name[0].ToString().ToUpper() : "?";
}

<style>
    /* ── MAUI WebView Compatibility ── */
    body.maui-host .re-main { padding-top: 0 !important; }

    /* ── Hero greeting ── */
    .udash-hero {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding: .25rem 0;
    }

    .udash-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #C8860A, #E9A520);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 900;
        color: var(--re-text);
        flex-shrink: 0;
        overflow: hidden;
        border: 2.5px solid rgba(200,134,10,.4);
        box-shadow: 0 0 0 3px rgba(200,134,10,.12);
    }

    .udash-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .udash-greet {
        font-size: .7rem;
        font-weight: 800;
        color: var(--re-muted);
        text-transform: uppercase;
        letter-spacing: .07em;
    }

    .udash-name {
        font-family: 'Nunito', sans-serif;
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--re-text);
        line-height: 1.2;
    }

    .udash-role-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .62rem;
        font-weight: 900;
        background: rgba(200,134,10,.15);
        color: var(--re-orange);
        border: 1px solid rgba(200,134,10,.25);
        border-radius: 99px;
        padding: .18rem .65rem;
        margin-top: .3rem;
        letter-spacing: .04em;
    }

    /* ── Stats grid ── */
    .udash-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .75rem;
        margin-bottom: 1.5rem;
    }

    .udash-stat-card {
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        border-radius: 16px;
        padding: 1rem 1.1rem;
        position: relative;
        overflow: hidden;
        transition: border-color .2s;
    }

    .udash-stat-card:hover {
        border-color: rgba(200,134,10,.25);
    }

    .udash-stat-card::before {
        content: '';
        position: absolute;
        top: -20px;
        right: -20px;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        opacity: .07;
    }

    .udash-stat-card.orange::before { background: #C8860A; }
    .udash-stat-card.pink::before { background: #ec4899; }
    .udash-stat-card.blue::before { background: #3b82f6; }
    .udash-stat-card.green::before { background: #22c55e; }

    .udash-stat-icon {
        font-size: 1.3rem;
        margin-bottom: .4rem;
    }

    .udash-stat-val {
        font-size: 1.6rem;
        font-weight: 900;
        color: var(--re-text);
        line-height: 1;
    }

    .udash-stat-lbl {
        font-size: .68rem;
        font-weight: 700;
        color: var(--re-muted);
        margin-top: .2rem;
    }

    /* ── Premium CTA banner ── */
    .udash-premium {
        background: linear-gradient(135deg, #C8860A 0%, #E9A520 50%, #f0b840 100%);
        border-radius: 18px;
        padding: 1.25rem 1.15rem;
        margin-bottom: 1.5rem;
        color: var(--re-text);
        position: relative;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(200,134,10,.25);
    }

    .udash-premium::before {
        content: '';
        position: absolute;
        top: -40%;
        right: -10%;
        width: 140px;
        height: 140px;
        background: rgba(255,255,255,.12);
        border-radius: 50%;
    }

    .udash-premium::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -5%;
        width: 100px;
        height: 100px;
        background: rgba(255,255,255,.08);
        border-radius: 50%;
    }

    .udash-premium-icon {
        font-size: 1.6rem;
        margin-bottom: .35rem;
        position: relative;
    }

    .udash-premium-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.15rem;
        font-weight: 900;
        margin-bottom: .25rem;
        position: relative;
    }

    .udash-premium-desc {
        font-size: .78rem;
        opacity: .85;
        margin-bottom: .75rem;
        position: relative;
        line-height: 1.4;
    }

    .udash-premium-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: var(--re-text);
        color: #E9A520;
        font-size: .78rem;
        font-weight: 900;
        padding: .55rem 1.15rem;
        border-radius: 99px;
        text-decoration: none !important;
        position: relative;
        box-shadow: 0 4px 14px rgba(0,0,0,.2);
        transition: transform .15s, box-shadow .15s;
    }

    .udash-premium-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0,0,0,.25);
    }

    /* ── Quick actions ── */
    .udash-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .7rem;
        margin-bottom: 1.5rem;
    }

    .udash-action {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
        padding: 1rem .75rem;
        border-radius: 14px;
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        text-decoration: none !important;
        color: var(--re-text) !important;
        transition: all .18s;
        text-align: center;
    }

    .udash-action:hover {
        border-color: rgba(200,134,10,.3);
        background: rgba(200,134,10,.06);
        transform: translateY(-2px);
    }

    .udash-action-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .udash-action-icon.orange { background: rgba(200,134,10,.16); }
    .udash-action-icon.pink { background: rgba(236,72,153,.12); }
    .udash-action-icon.blue { background: rgba(59,130,246,.12); }
    .udash-action-icon.green { background: rgba(34,197,94,.12); }

    .udash-action-lbl {
        font-size: .78rem;
        font-weight: 800;
    }

    .udash-action-sub {
        font-size: .65rem;
        color: var(--re-muted);
        font-weight: 600;
    }

    /* ── Book list (horizontal rail) ── */
    .udash-book-card {
        flex-shrink: 0;
        width: 110px;
        scroll-snap-align: start;
        text-decoration: none !important;
    }

    .udash-book-cover {
        width: 110px;
        aspect-ratio: 2/3;
        border-radius: 12px;
        object-fit: cover;
        box-shadow: var(--shadow-md);
        transition: transform .22s, box-shadow .22s;
    }

    .udash-book-card:hover .udash-book-cover {
        transform: translateY(-4px) scale(1.02);
        box-shadow: 0 12px 30px rgba(44,26,14,.2);
    }

    .udash-book-cover-ph {
        width: 110px;
        aspect-ratio: 2/3;
        border-radius: 12px;
        background: linear-gradient(135deg, #5C3210, #C8860A);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        box-shadow: var(--shadow-md);
    }

    .udash-book-info {
        padding: 0 .1rem;
        margin-top: .5rem;
    }

    .udash-book-title {
        font-size: .75rem;
        font-weight: 800;
        color: var(--re-text);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
    }

    .udash-book-author {
        font-size: .65rem;
        color: var(--re-muted);
        font-weight: 600;
        margin-top: .1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Book list (vertical list for favorites) ── */
    .udash-book-list-card {
        display: flex;
        gap: .85rem;
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        border-radius: 14px;
        padding: .85rem;
        margin-bottom: .6rem;
        text-decoration: none !important;
        transition: border-color .15s, background .15s;
    }

    .udash-book-list-card:hover {
        border-color: rgba(200,134,10,.25);
        background: rgba(200,134,10,.04);
    }

    .udash-list-cover {
        width: 54px;
        aspect-ratio: 2/3;
        border-radius: 9px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.4);
    }

    .udash-list-cover-ph {
        width: 54px;
        aspect-ratio: 2/3;
        border-radius: 9px;
        background: linear-gradient(135deg, #5C3210, #C8860A);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .udash-list-info {
        flex: 1;
        min-width: 0;
    }

    .udash-list-title {
        font-size: .88rem;
        font-weight: 800;
        color: var(--re-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .udash-list-meta {
        font-size: .68rem;
        color: var(--re-muted);
        font-weight: 600;
        margin-top: .2rem;
    }

    .udash-list-badge {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        font-size: .58rem;
        font-weight: 900;
        padding: .15rem .5rem;
        border-radius: 6px;
        margin-top: .35rem;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .udash-list-badge.free {
        background: rgba(34,197,94,.12);
        color: #4ade80;
    }

    .udash-list-badge.pro {
        background: rgba(200,134,10,.12);
        color: var(--re-orange);
    }
</style>

<!-- Hero greeting -->
<div class="udash-hero">
    <div class="udash-avatar">
        @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
        {
            <img src="@Model.ProfilePhoto" alt="avatar" />
        }
        else
        {
            @initial
        }
    </div>
    <div>
        <div class="udash-greet">My Dashboard</div>
        <div class="udash-name">@Model.Name</div>
        <div class="udash-role-badge">Reader</div>
    </div>
</div>

<!-- Stats -->
<div class="udash-stats">
    <div class="udash-stat-card orange">
        <div class="udash-stat-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
        <div class="udash-stat-val">@Model.BooksRead</div>
        <div class="udash-stat-lbl">Books Read</div>
    </div>
    <div class="udash-stat-card pink">
        <div class="udash-stat-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        <div class="udash-stat-val">@Model.FavoritesCount</div>
        <div class="udash-stat-lbl">Favorites</div>
    </div>
    <div class="udash-stat-card blue">
        <div class="udash-stat-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div>
        <div class="udash-stat-val">@(Model.RecentlyRead?.Count ?? 0)</div>
        <div class="udash-stat-lbl">In Progress</div>
    </div>
    <div class="udash-stat-card green">
        <div class="udash-stat-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div>
        <div class="udash-stat-val">@(Model.IsSubscribed ? "✓" : "—")</div>
        <div class="udash-stat-lbl">@(Model.IsSubscribed ? "Premium" : "Free Plan")</div>
    </div>
</div>

<!-- Premium CTA for free users -->
@if (!Model.IsSubscribed)
{
    <div class="udash-premium">
        <div class="udash-premium-icon">⭐</div>
        <div class="udash-premium-title">Unlock Premium</div>
        <div class="udash-premium-desc">Access all books, AI features, and offline reading with a Premium plan.</div>
        <a href="/Mobile/Subscribe" class="udash-premium-btn">Upgrade Now →</a>
    </div>
}

<!-- Quick actions -->
<div class="mob-sec-head">
    <div class="mob-sec-title">Quick Actions</div>
</div>
<div class="udash-actions">
    <a class="udash-action" href="/Mobile/Ongoing">
        <div class="udash-action-icon orange"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
        <div class="udash-action-lbl">Ongoing</div>
        <div class="udash-action-sub">Continue reading</div>
    </a>
    <a class="udash-action" href="/Mobile/Favorites">
        <div class="udash-action-icon pink"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
        <div class="udash-action-lbl">Favorites</div>
        <div class="udash-action-sub">Books you love</div>
    </a>
    <a class="udash-action" href="/Mobile/Downloads">
        <div class="udash-action-icon blue"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
        <div class="udash-action-lbl">Downloads</div>
        <div class="udash-action-sub">Offline reading</div>
    </a>
    <a class="udash-action" href="/Mobile/Profile">
        <div class="udash-action-icon green"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></div>
        <div class="udash-action-lbl">Profile</div>
        <div class="udash-action-sub">Edit info</div>
    </a>
</div>

<!-- Recently Read -->
@if (Model.RecentlyRead?.Any() == true)
{
    <div class="mob-sec-head">
        <div class="mob-sec-title">📚 Continue Reading</div>
        <a class="mob-sec-link" href="/Mobile/Ongoing">See all</a>
    </div>
    <div class="bk-rail">
        @foreach (var book in Model.RecentlyRead.Take(10))
        {
            <a class="udash-book-card" href="/Mobile/Read/@book.Id">
                @if (!string.IsNullOrEmpty(book.CoverImage))
                {
                    <img class="udash-book-cover" src="@book.CoverImage" alt="@book.Title" loading="lazy" />
                }
                else
                {
                    <div class="udash-book-cover-ph">📖</div>
                }
                <div class="udash-book-info">
                    <div class="udash-book-title">@book.Title</div>
                    <div class="udash-book-author">@book.Author</div>
                </div>
            </a>
        }
    </div>
}

<!-- Favorites -->
@if (Model.Favorites?.Any() == true)
{
    <div class="mob-sec-head" style="margin-top:.75rem;">
        <div class="mob-sec-title">❤️ My Favorites</div>
        <a class="mob-sec-link" href="/Mobile/Favorites">See all</a>
    </div>
    @foreach (var book in Model.Favorites.Take(5))
    {
        <a class="udash-book-list-card" href="/Mobile/Detail/@book.Id">
            @if (!string.IsNullOrEmpty(book.CoverImage))
            {
                <img class="udash-list-cover" src="@book.CoverImage" alt="@book.Title" loading="lazy" />
            }
            else
            {
                <div class="udash-list-cover-ph">📖</div>
            }
            <div class="udash-list-info">
                <div class="udash-list-title">@book.Title</div>
                <div class="udash-list-meta">by @book.Author</div>
                @if (!string.IsNullOrEmpty(book.Category))
                {
                    <span class="udash-list-badge pro">@book.Category</span>
                }
            </div>
        </a>
    }
}

<!-- Empty state if no activity -->
@if ((Model.RecentlyRead == null || !Model.RecentlyRead.Any()) && (Model.Favorites == null || !Model.Favorites.Any()) && Model.BooksRead == 0)
{
    <div class="mob-empty" style="padding:2.5rem 1rem;">
        <span class="mob-empty-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="56" height="56" style="color:var(--re-muted);flex-shrink:0;vertical-align:middle;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
        <div class="mob-empty-title">Start Your Reading Journey</div>
        <div class="mob-empty-sub">Explore books and build your library!</div>
        <a class="mob-empty-btn" href="/Mobile/Home">Browse Books</a>
    </div>
}
