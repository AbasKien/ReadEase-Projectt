@{
    ViewData["Title"] = "Reset Password";
    var email = (string?)ViewBag.Email ?? "";
    var token = (string?)ViewBag.Token ?? "";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Nunito:wght@400;600;700;800;900&display=swap');

    :root {
        --re-orange: #f26522;
        --re-orange-dark: #d9541a;
    }

    body {
        background: #0b1219;
        font-family: 'Nunito', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .rp-wrap {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: max(2rem, env(safe-area-inset-top, 2rem)) 1.35rem max(2rem, env(safe-area-inset-bottom, 2rem));
        position: relative;
        overflow: hidden;
        -webkit-overflow-scrolling: touch;
        overflow-y: auto;
    }

        .rp-wrap::before {
            content: '';
            position: fixed;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 340px;
            height: 340px;
            background: radial-gradient(circle, rgba(242,101,34,.14) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .rp-wrap::after {
            content: '';
            position: fixed;
            bottom: -10%;
            right: -10%;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(242,101,34,.07) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

    .rp-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
        text-decoration: none !important;
        margin-bottom: 2.25rem;
        position: relative;
        z-index: 1;
    }

    .rp-logo-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: linear-gradient(135deg, #f26522, #d97706);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 8px 28px rgba(242,101,34,.35), 0 0 0 1px rgba(242,101,34,.2);
    }

    .rp-logo-text {
        display: flex;
        align-items: baseline;
        gap: 0;
    }

    .rp-logo-read {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--re-text);
        letter-spacing: -.02em;
    }

    .rp-logo-ease {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--re-orange);
        letter-spacing: -.02em;
    }

    .rp-card {
        width: 100%;
        max-width: 400px;
        background: var(--re-surface-2);
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 24px;
        padding: 2rem 1.5rem;
        backdrop-filter: blur(12px);
        box-shadow: 0 24px 64px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
        position: relative;
        z-index: 1;
    }

    .rp-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(242,101,34,.18), rgba(242,101,34,.06));
        border: 2px solid rgba(242,101,34,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 18px rgba(242,101,34,.15);
        animation: rpPulse 3s ease-in-out infinite;
    }

    @@keyframes rpPulse {
        0%, 100% { box-shadow: 0 4px 18px rgba(242,101,34,.15); }
        50% { box-shadow: 0 4px 28px rgba(242,101,34,.32); }
    }

    .rp-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--re-text);
        text-align: center;
        margin-bottom: .3rem;
    }

    .rp-sub {
        font-size: .82rem;
        color: var(--re-muted);
        font-weight: 600;
        text-align: center;
        margin-bottom: 1.75rem;
        line-height: 1.55;
    }

    .rp-err {
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.3);
        color: #fc8181;
        font-size: .82rem;
        font-weight: 700;
        padding: .7rem 1rem;
        border-radius: 12px;
        margin-bottom: 1.1rem;
        display: none;
        animation: errShake .35s ease;
    }

        .rp-err.show { display: block; }

    @@keyframes errShake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-5px); }
        60% { transform: translateX(4px); }
    }

    .mob-field {
        margin-bottom: 1.1rem;
    }

        .mob-field label {
            display: block;
            font-size: .7rem;
            font-weight: 800;
            color: var(--re-muted);
            margin-bottom: .4rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

    .mob-input {
        width: 100%;
        background: var(--re-surface-2);
        border: 1.5px solid rgba(255,255,255,.1);
        border-radius: 12px;
        padding: .8rem 1rem;
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 600;
        color: var(--re-text);
        outline: none;
        transition: border-color .2s, box-shadow .2s, background .2s;
        -webkit-appearance: none;
    }

        .mob-input:focus {
            border-color: rgba(242,101,34,.55);
            box-shadow: 0 0 0 3px rgba(242,101,34,.14);
            background: var(--re-surface-2);
        }

        .mob-input::placeholder {
            color: var(--re-border);
        }

    /* Strength bar */
    .strength-bar-wrap {
        display: flex;
        gap: .3rem;
        margin-top: .5rem;
    }

    .strength-seg {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: rgba(255,255,255,.1);
        transition: background .3s;
    }

    .strength-label {
        font-size: .72rem;
        font-weight: 700;
        margin-top: .3rem;
        color: var(--re-muted);
    }

    /* Password match */
    #pwMatchMsg {
        font-size: .78rem;
        font-weight: 700;
        margin-top: .35rem;
    }

    .rp-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        background: var(--re-orange);
        color: var(--re-text);
        border: none;
        border-radius: 12px;
        padding: .9rem 1.35rem;
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        transition: background .18s, box-shadow .18s, transform .15s;
        margin-top: .5rem;
        box-shadow: 0 5px 18px rgba(242,101,34,.35);
        letter-spacing: .01em;
    }

        .rp-submit:hover:not(:disabled) {
            background: var(--re-orange-dark);
            box-shadow: 0 8px 24px rgba(242,101,34,.45);
            transform: translateY(-1px);
        }

        .rp-submit:active:not(:disabled) {
            transform: scale(.97);
        }

        .rp-submit:disabled {
            opacity: .7;
            cursor: not-allowed;
        }

    .rp-footer {
        text-align: center;
        font-size: .82rem;
        font-weight: 600;
        color: var(--re-muted);
        margin-top: 1.5rem;
    }

        .rp-footer a {
            color: var(--re-orange) !important;
            text-decoration: none !important;
            font-weight: 800;
            transition: color .15s;
        }

            .rp-footer a:hover {
                color: #ff7a35 !important;
            }

    /* Success state */
    .rp-success {
        text-align: center;
        display: none;
        animation: rpFadeIn .4s ease both;
    }

        .rp-success.show { display: block; }

    @@keyframes rpFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
    }

    .rp-success-icon {
        font-size: 3.5rem;
        margin-bottom: .75rem;
        display: block;
        animation: rpBounce .5s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes rpBounce {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .rp-success-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--re-text);
        margin-bottom: .5rem;
    }

    .rp-success-sub {
        font-size: .85rem;
        color: var(--re-muted);
        font-weight: 600;
        line-height: 1.55;
        margin-bottom: 1.5rem;
    }

    .rp-login-btn {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .78rem 2rem;
        border-radius: 12px;
        font-family: 'Nunito', sans-serif;
        font-size: .93rem;
        font-weight: 800;
        background: var(--re-orange);
        color: var(--re-text);
        text-decoration: none;
        transition: background .2s, transform .15s, box-shadow .2s;
        box-shadow: 0 4px 14px rgba(242,101,34,.3);
    }

        .rp-login-btn:hover {
            background: var(--re-orange-dark);
            transform: translateY(-1px);
            box-shadow: 0 8px 22px rgba(242,101,34,.4);
            color: var(--re-text);
        }
</style>

<div class="rp-wrap">
    <a href="/Mobile/Login" class="rp-logo">
        <div class="rp-logo-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> width="36" height="36" style="color:#fff;flex-shrink:0;vertical-align:middle;"<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></div>
        <div class="rp-logo-text">
            <span class="rp-logo-read">Read</span><span class="rp-logo-ease">Ease</span>
        </div>
    </a>

    <div class="rp-card">
        <!-- Form state -->
        <div id="formState">
            <div class="rp-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> width="28" height="28" style="color:var(--re-orange);flex-shrink:0;vertical-align:middle;"<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
            <div class="rp-title">Set New Password</div>
            <div class="rp-sub">Choose a strong password to protect your account.</div>

            <div class="rp-err" id="rpErr"></div>

            <div class="mob-field">
                <label>New Password</label>
                <input type="password" id="pwNew" class="mob-input"
                       placeholder="Min 6 characters" autocomplete="new-password" />
                <div class="strength-bar-wrap" id="strengthBar">
                    <div class="strength-seg" id="seg1"></div>
                    <div class="strength-seg" id="seg2"></div>
                    <div class="strength-seg" id="seg3"></div>
                    <div class="strength-seg" id="seg4"></div>
                </div>
                <div class="strength-label" id="strengthLabel"></div>
            </div>

            <div class="mob-field" style="margin-bottom:.25rem;">
                <label>Confirm Password</label>
                <input type="password" id="pwConfirm" class="mob-input"
                       placeholder="Repeat your password" autocomplete="new-password" />
            </div>
            <div id="pwMatchMsg"></div>

            <button class="rp-submit" id="rpBtn" onclick="doReset()">Reset Password</button>
        </div>

        <!-- Success state -->
        <div class="rp-success" id="successState">
            <span class="rp-success-icon"></span>
            <div class="rp-success-title">Password Reset!</div>
            <p class="rp-success-sub">
                Your password has been updated successfully.<br>
                You can now log in with your new password.
            </p>
            <a href="/Mobile/Login" class="rp-login-btn">Go to Login →</a>
        </div>

        <div class="rp-footer">
            <a href="/Mobile/Login">← Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const resetEmail = '@Html.Raw(email)';
        const resetToken = decodeURIComponent('@Html.Raw(Uri.EscapeDataString(token))');

        const pwNew    = document.getElementById('pwNew');
        const pwConf   = document.getElementById('pwConfirm');
        const matchMsg = document.getElementById('pwMatchMsg');
        const segs     = [document.getElementById('seg1'), document.getElementById('seg2'),
                          document.getElementById('seg3'), document.getElementById('seg4')];
        const lbl      = document.getElementById('strengthLabel');

        const colors = ['#ef4444','#f97316','#eab308','#22c55e'];
        const labels = ['Weak','Fair','Good','Strong'];

        function getStrength(v) {
            let s = 0;
            if (v.length >= 6)  s++;
            if (v.length >= 10) s++;
            if (/[A-Z]/.test(v) && /[0-9]/.test(v)) s++;
            if (/[^A-Za-z0-9]/.test(v)) s++;
            return s;
        }

        pwNew.addEventListener('input', function () {
            const v = this.value;
            if (!v) { segs.forEach(s => s.style.background = ''); lbl.textContent = ''; return; }
            const strength = getStrength(v);
            segs.forEach((s, i) => {
                s.style.background = i < strength ? colors[strength - 1] : 'rgba(255,255,255,.1)';
            });
            lbl.textContent = labels[strength - 1] || '';
            lbl.style.color = strength > 0 ? colors[strength - 1] : 'rgba(255,255,255,.4)';
            checkMatch();
        });

        function checkMatch() {
            if (!pwConf.value) { matchMsg.textContent = ''; pwConf.style.borderColor = ''; return; }
            const ok = pwNew.value === pwConf.value;
            matchMsg.style.color      = ok ? '#86efac' : '#fc8181';
            matchMsg.textContent      = ok ? 'Passwords match' : 'Error: Passwords do not match';
            pwConf.style.borderColor  = ok ? 'rgba(34,197,94,.4)' : 'rgba(239,68,68,.4)';
        }

        pwConf.addEventListener('input', checkMatch);

        async function doReset() {
            const newPass = pwNew.value;
            const confirmPass = pwConf.value;
            const btn   = document.getElementById('rpBtn');
            const errEl = document.getElementById('rpErr');

            errEl.classList.remove('show');

            if (!newPass || !confirmPass) {
                errEl.textContent = 'Please fill in all fields.';
                errEl.classList.add('show');
                return;
            }

            if (newPass.length < 6) {
                errEl.textContent = 'Password must be at least 6 characters.';
                errEl.classList.add('show');
                return;
            }

            if (newPass !== confirmPass) {
                errEl.textContent = 'Passwords do not match.';
                errEl.classList.add('show');
                return;
            }

            if (!resetEmail || !resetToken) {
                errEl.textContent = 'Invalid or expired reset link. Please request a new one.';
                errEl.classList.add('show');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spin-sm"></span> Resetting…';

            try {
                const res = await fetch('/Areas/Mobile/api/Auth/reset-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: resetEmail, token: resetToken, newPassword: newPass })
                });

                const data = await res.json();

                if (!res.ok) {
                    errEl.textContent = data.message || 'Invalid or expired reset link.';
                    errEl.classList.add('show');
                    btn.disabled = false;
                    btn.textContent = 'Reset Password';
                    return;
                }

                // Show success state
                document.getElementById('formState').style.display = 'none';
                const successEl = document.getElementById('successState');
                successEl.classList.add('show');
            } catch (e) {
                errEl.textContent = 'Network error. Please check your connection and try again.';
                errEl.classList.add('show');
                btn.disabled = false;
                btn.textContent = 'Reset Password';
            }
        }
    </script>
}
