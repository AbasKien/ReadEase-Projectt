@{
    ViewData["Title"] = "Register";
    Layout = "~/Areas/Mobile/Views/Shared/_MobileLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Nunito:wght@400;600;700;800;900&display=swap');

    .register-wrap {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: max(2rem, env(safe-area-inset-top, 2rem)) 1.35rem max(2rem, env(safe-area-inset-bottom, 2rem));
        position: relative;
        overflow: hidden;
    }

        .register-wrap::before {
            content: '';
            position: absolute;
            top: -80px;
            left: 50%;
            transform: translateX(-50%);
            width: 380px;
            height: 380px;
            background: radial-gradient(circle, rgba(242,101,34,.14) 0%, transparent 70%);
            pointer-events: none;
        }

    .reg-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1.75rem;
    }

    .reg-logo-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: transparent;
        border: 2px dashed #C8860A;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 16px rgba(200,134,10,.2);
    }

    .reg-logo-icon svg {
        width: 32px;
        height: 32px;
        color: #C8860A;
    }

    .reg-logo-text {
        display: flex;
        align-items: baseline;
        line-height: 1;
    }

    .reg-logo-read {
        font-family: 'Playfair Display',serif;
        font-size: 2rem;
        font-weight: 800;
        color: #C8860A;
    }

    .reg-logo-ease {
        font-family: 'Playfair Display',serif;
        font-size: 2rem;
        font-weight: 800;
        color: #C8860A;
    }

    .reg-card {
        width: 100%;
        max-width: 400px;
        background: #FFFCF7;
        border: 1px solid #E4D8C4;
        border-radius: 22px;
        padding: 2rem 1.6rem;
        box-shadow: 0 12px 40px rgba(44,26,14,.12), 0 4px 12px rgba(44,26,14,.08);
        position: relative;
        z-index: 1;
    }

    .reg-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.45rem;
        font-weight: 700;
        color: var(--re-text);
        margin-bottom: .35rem;
    }

    .reg-sub {
        font-size: .82rem;
        color: rgba(44,26,14,.55);
        font-weight: 600;
        margin-bottom: 1.75rem;
    }

    .reg-divider {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin: 1.25rem 0;
    }

        .reg-divider span {
            font-size: .72rem;
            color: #A08060;
            font-weight: 600;
            white-space: nowrap;
        }

        .reg-divider::before, .reg-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #E4D8C4;
        }

    .reg-footer {
        text-align: center;
        margin-top: 1.5rem;
        font-size: .82rem;
        color: rgba(44,26,14,.55);
        font-weight: 600;
    }

        .reg-footer a {
            color: #C8860A !important;
            font-weight: 800;
            text-decoration: none !important;
        }

            .reg-footer a:hover {
                color: #9E6808 !important;
            }

    .reg-err {
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.35);
        border-radius: 10px;
        padding: .75rem 1rem;
        font-size: .82rem;
        color: #dc2626;
        font-weight: 600;
        margin-bottom: 1.1rem;
        display: none;
    }

    .reg-success {
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(34,197,94,.35);
        border-radius: 10px;
        padding: .75rem 1rem;
        font-size: .82rem;
        color: #16a34a;
        font-weight: 600;
        margin-bottom: 1.1rem;
        display: none;
    }

    .mob-field {
        margin-bottom: 1.1rem;
    }

        .mob-field label {
            display: block;
            font-size: .7rem;
            font-weight: 800;
            color: #A08060;
            margin-bottom: .4rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

    .mob-input {
        width: 100%;
        background: #F5EFE3;
        border: 1.5px solid #E4D8C4;
        border-radius: 12px;
        padding: .8rem 1rem;
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 600;
        color: #2C1A0E;
        outline: none;
        transition: border-color .2s, box-shadow .2s, background .2s;
        -webkit-appearance: none;
    }

        .mob-input:focus {
            border-color: #C8860A;
            box-shadow: 0 0 0 3px rgba(200,134,10,.2);
            background: #FAF6EF;
        }

        .mob-input::placeholder {
            color: #A08060;
        }

    .mob-btn-orange {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        background: #C8860A;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: .9rem 1.35rem;
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        transition: background .18s, box-shadow .18s, transform .15s;
        box-shadow: 0 5px 18px rgba(200,134,10,.35);
        letter-spacing: .01em;
        margin-bottom: .5rem;
    }

        .mob-btn-orange:hover:not(:disabled) {
            background: #9E6808;
            box-shadow: 0 8px 24px rgba(200,134,10,.45);
            transform: translateY(-1px);
        }

        .mob-btn-orange:active:not(:disabled) {
            transform: scale(.97);
        }

        .mob-btn-orange:disabled {
            opacity: .7;
            cursor: not-allowed;
        }

    /* ── Custom Google Button ── */
    .google-btn {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        background: #F5EFE3;
        border: 1.5px solid #E4D8C4;
        border-radius: 12px;
        padding: .78rem 1rem;
        cursor: pointer;
        transition: background .18s, border-color .18s;
        margin-bottom: .65rem;
        text-decoration: none !important;
    }

        .google-btn:hover {
            background: #FAF6EF;
            border-color: #C8860A;
        }

        .google-btn:active {
            transform: scale(.97);
        }

    .google-btn-label {
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 800;
        color: #2C1A0E;
        flex: 1;
        text-align: center;
    }

    /* ── OTP screen ── */
    #otpScreen {
        display: none;
    }

    .otp-icon {
        font-size: 3rem;
        text-align: center;
        margin-bottom: .75rem;
    }

    .otp-title {
        font-family: 'Playfair Display',serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--re-text);
        text-align: center;
        margin-bottom: .4rem;
    }

    .otp-msg {
        font-size: .83rem;
        color: #A08060;
        text-align: center;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

        .otp-msg strong {
            color: #C8860A;
        }

    .otp-boxes {
        display: flex;
        justify-content: center;
        gap: .35rem;
        margin-bottom: 1.25rem;
    }

    @@media (max-width: 340px) {
        .otp-box {
            width: 38px;
            height: 48px;
            font-size: 1.3rem;
        }

        .otp-boxes {
            gap: .25rem;
        }
    }

    .otp-box {
        width: 44px;
        height: 54px;
        border: 2px solid #E4D8C4;
        border-radius: 10px;
        background: #F5EFE3;
        color: #2C1A0E;
        font-size: 1.5rem;
        font-weight: 800;
        text-align: center;
        outline: none;
        transition: border-color .15s;
        caret-color: transparent;
    }

        .otp-box:focus {
            border-color: #C8860A;
        }

    .otp-timer {
        text-align: center;
        font-size: .78rem;
        color: #A08060;
        font-weight: 600;
        margin-bottom: 1.1rem;
    }

        .otp-timer span {
            color: #C8860A;
            font-weight: 800;
        }

    .otp-resend-btn {
        display: block;
        width: 100%;
        background: transparent;
        border: 1.5px solid #E4D8C4;
        border-radius: 10px;
        padding: .72rem;
        font-family: 'Nunito',sans-serif;
        font-size: .84rem;
        font-weight: 800;
        color: #A08060;
        cursor: pointer;
        transition: all .2s;
        margin-bottom: .75rem;
    }

        .otp-resend-btn:hover:not(:disabled) {
            border-color: #C8860A;
            color: #C8860A;
        }

        .otp-resend-btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }
</style>

<div class="register-wrap">
    <div class="reg-logo">
        <div class="reg-logo-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
        </div>
        <div class="reg-logo-text">
            <span class="reg-logo-read">Read</span><span class="reg-logo-ease">Ease</span>
        </div>
    </div>

    <div class="reg-card">

        <!-- ── STEP 1: Registration form ── -->
        <div id="regForm">
            <div class="reg-title">Create Account</div>
            <div class="reg-sub">Start your reading journey today</div>

            <div class="reg-err" id="regError"></div>
            <div class="reg-success" id="regSuccess"></div>

            <!-- Custom Google Button - Opens Chrome for OAuth -->
            <a class="google-btn" id="googleBtnRegister" href="/Mobile/Auth/ExternalLogin?provider=Google&mobile=true">
                <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
                    <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.6 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34.3 6.6 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.2-2.6-.4-3.9z" />
                    <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.5 19 12 24 12c3.1 0 5.8 1.1 7.9 3l5.7-5.7C34.3 6.6 29.4 4 24 4c-7.7 0-14.4 4.4-17.7 10.7z" />
                    <path fill="#4CAF50" d="M24 44c5.2 0 10-1.9 13.7-5.1l-6.3-5.4C29.4 35.1 26.8 36 24 36c-5.3 0-9.6-3.1-11.3-7.5l-6.5 5C9.4 39.4 16.2 44 24 44z" />
                    <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.3 5.5l6.3 5.4C37 38.1 44 33 44 24c0-1.3-.2-2.6-.4-3.9z" />
                </svg>
                <span class="google-btn-label">Continue with Google</span>
            </a>

            <div class="reg-divider"><span>or register with email</span></div>

            <div class="mob-field">
                <label>Full Name</label>
                <input class="mob-input" id="regName" type="text" placeholder="Your name" autocomplete="name" />
            </div>
            <div class="mob-field">
                <label>Email</label>
                <input class="mob-input" id="regEmail" type="email" placeholder="you@gmail.com" autocomplete="email" />
            </div>
            <div class="mob-field">
                <label>Password</label>
                <input class="mob-input" id="regPassword" type="password" placeholder="Min 6 characters" autocomplete="new-password" />
            </div>
            <div class="mob-field">
                <label>Confirm Password</label>
                <input class="mob-input" id="regConfirm" type="password" placeholder="Repeat password" autocomplete="new-password" />
            </div>

            <button class="mob-btn-orange" id="regBtn" onclick="doRegister()">Create Account</button>

            <div class="reg-footer">Already have an account? <a href="/Mobile/Login">Sign in</a></div>
        </div>

        <!-- ── STEP 2: OTP entry screen ── -->
        <div id="otpScreen">
            <div class="reg-err" id="otpError"></div>
            <div class="reg-success" id="otpSuccess"></div>

            <div class="otp-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> width="40" height="40" style="color:var(--re-orange);flex-shrink:0;vertical-align:middle;"<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
            <div class="otp-title">Enter your OTP</div>
            <div class="otp-msg">
                We sent a <strong>6-digit code</strong> to<br />
                <strong id="otpEmailDisplay"></strong><br />
                Check your inbox (and spam folder).
            </div>

            <div class="otp-boxes">
                <input class="otp-box" id="otp0" type="tel" maxlength="1" inputmode="numeric" />
                <input class="otp-box" id="otp1" type="tel" maxlength="1" inputmode="numeric" />
                <input class="otp-box" id="otp2" type="tel" maxlength="1" inputmode="numeric" />
                <input class="otp-box" id="otp3" type="tel" maxlength="1" inputmode="numeric" />
                <input class="otp-box" id="otp4" type="tel" maxlength="1" inputmode="numeric" />
                <input class="otp-box" id="otp5" type="tel" maxlength="1" inputmode="numeric" />
            </div>

            <div class="otp-timer" id="otpTimer">Code expires in <span id="countdown">10:00</span></div>

            <button class="mob-btn-orange" id="otpBtn" onclick="doVerify()">Verify & Sign In</button>

            <button class="otp-resend-btn" id="resendBtn" onclick="resendOtp()" disabled>
                Resend OTP
            </button>

            <div class="reg-footer">Wrong email? <a href="/Mobile/Register">Start over</a></div>
        </div>

    </div>
</div>

<script>
    let _email    = '';
    let _password = '';
    let _timer    = null;

    async function doRegister() {
        const name     = document.getElementById('regName').value.trim();
        const email    = document.getElementById('regEmail').value.trim();
        const password = document.getElementById('regPassword').value;
        const confirm  = document.getElementById('regConfirm').value;
        const errEl    = document.getElementById('regError');
        const btn      = document.getElementById('regBtn');

        errEl.style.display = 'none';

        if (!name || !email || !password || !confirm) {
            return showErr(errEl, 'All fields are required.');
        }
        if (password !== confirm) return showErr(errEl, 'Passwords do not match.');
        if (password.length < 6)  return showErr(errEl, 'Password must be at least 6 characters.');

        btn.disabled = true;
        btn.textContent = 'Creating account…';

        try {
            const res  = await fetch('/Areas/Mobile/Api/Auth/register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, email, password })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Registration failed.');

            _email    = email;
            _password = password;

            document.getElementById('otpEmailDisplay').textContent = email;
            document.getElementById('regForm').style.display   = 'none';
            document.getElementById('otpScreen').style.display = 'block';
            document.getElementById('otp0').focus();

            if (data.emailSent === false) {
                showErr(document.getElementById('otpError'), data.message);
            }

            startCountdown(10 * 60);

        } catch (e) {
            showErr(errEl, e.message);
            btn.disabled    = false;
            btn.textContent = 'Create Account';
        }
    }

    async function doVerify() {
        const otp   = getOtpValue();
        const errEl = document.getElementById('otpError');
        const sucEl = document.getElementById('otpSuccess');
        const btn   = document.getElementById('otpBtn');

        errEl.style.display = 'none';
        sucEl.style.display = 'none';

        if (otp.length !== 6 || !/^\d{6}$/.test(otp)) {
            return showErr(errEl, 'Please enter the full 6-digit code.');
        }

        btn.disabled    = true;
        btn.textContent = 'Verifying…';

        try {
            const res  = await fetch('/Areas/Mobile/Api/Auth/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: _email, otp, password: _password })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Verification failed.');

            if (data.token) {
                document.cookie = 'MobileAuthToken=' + encodeURIComponent(data.token) +
                    ';path=/;max-age=2592000;SameSite=Lax';
            }
            sucEl.textContent = 'Verified! Redirecting…';
            sucEl.style.display = 'block';
            clearInterval(_timer);
            setTimeout(() => window.location.href = '/Mobile/Home', 900);

        } catch (e) {
            showErr(errEl, e.message);
            btn.disabled    = false;
            btn.textContent = 'Verify & Sign In';
        }
    }

    async function resendOtp() {
        const errEl = document.getElementById('otpError');
        const btn   = document.getElementById('resendBtn');
        errEl.style.display = 'none';

        btn.disabled    = true;
        btn.textContent = 'Sending…';

        try {
            const res  = await fetch('/Areas/Mobile/Api/Auth/resend-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: _email })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.message || 'Failed to resend.');

            for (let i = 0; i < 6; i++) document.getElementById('otp' + i).value = '';
            document.getElementById('otp0').focus();
            startCountdown(10 * 60);

            btn.textContent = 'Sent!';
            setTimeout(() => { btn.textContent = 'Resend OTP'; }, 30_000);

        } catch (e) {
            showErr(errEl, e.message);
            btn.disabled    = false;
            btn.textContent = 'Resend OTP';
        }
    }

    document.querySelectorAll('.otp-box').forEach((box, i) => {
        box.addEventListener('input', () => {
            const v = box.value.replace(/\D/g, '');
            box.value = v.slice(-1);
            if (v && i < 5) document.getElementById('otp' + (i + 1)).focus();
            if (getOtpValue().length === 6) doVerify();
        });

        box.addEventListener('keydown', e => {
            if (e.key === 'Backspace' && !box.value && i > 0) {
                document.getElementById('otp' + (i - 1)).focus();
            }
        });

        box.addEventListener('paste', e => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData)
                .getData('text').replace(/\D/g, '').slice(0, 6);
            [...pasted].forEach((ch, j) => {
                const el = document.getElementById('otp' + j);
                if (el) el.value = ch;
            });
            const last = Math.min(pasted.length, 5);
            document.getElementById('otp' + last).focus();
            if (pasted.length === 6) doVerify();
        });
    });

    function startCountdown(seconds) {
        clearInterval(_timer);
        const resendBtn = document.getElementById('resendBtn');
        resendBtn.disabled = true;

        _timer = setInterval(() => {
            seconds--;
            const m = String(Math.floor(seconds / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            document.getElementById('countdown').textContent = `${m}:${s}`;

            if (seconds <= 0) {
                clearInterval(_timer);
                document.getElementById('otpTimer').innerHTML =
                    '<span style="color:#fca5a5;">Code expired.</span> Request a new one below.';
                resendBtn.disabled = false;
            }
            if (seconds <= (10 * 60 - 60)) resendBtn.disabled = false;
        }, 1000);
    }

    function getOtpValue() {
        return [0,1,2,3,4,5].map(i => document.getElementById('otp'+i).value).join('');
    }

    function showErr(el, msg) {
        el.textContent   = msg;
        el.style.display = 'block';
    }

    // Trigger hidden Google popup
    function triggerGoogleSignInRegister() {
        if (window.google?.accounts?.id) {
            google.accounts.id.prompt();
        } else {
            const errEl = document.getElementById('regError');
            const details = getGoogleErrorDetailsRegister();
            showErr(errEl, details);
            console.log('Google Sign-In status:', details);
            // Try to initialize again
            initGoogleSignInRegister();
        }
    }

    let googleClientId = null;
    let googleScriptLoaded = false;
    let googleInitError = null;

    async function initGoogleSignInRegister() {
        try {
            googleInitError = null;

            // Already initialized
            if (window.google?.accounts?.id && googleClientId) {
                return;
            }

            // Fetch client ID if not already fetched
            if (!googleClientId) {
                const res = await fetch('/Areas/Mobile/Api/Auth/google-client-id');
                if (!res.ok) {
                    googleInitError = 'API Error: ' + res.status;
                    console.error('Failed to fetch Google Client ID:', res.status);
                    return;
                }

                const text = await res.text();
                if (text.trim().startsWith('<')) {
                    googleInitError = 'API returned HTML (not JSON)';
                    console.error('API returned HTML instead of JSON');
                    return;
                }

                const data = JSON.parse(text);
                googleClientId = data.clientId;

                if (!googleClientId) {
                    googleInitError = 'No Client ID in config';
                    console.error('No Google Client ID configured');
                    return;
                }
            }

            // Load Google script if not loaded
            if (!googleScriptLoaded) {
                await loadGoogleScript();
            }

            // Initialize Google Sign-In
            if (window.google?.accounts?.id) {
                google.accounts.id.initialize({
                    client_id: googleClientId,
                    callback: handleGoogleCredentialRegister,
                    auto_select: false,
                    cancel_on_tap_outside: true
                });
                google.accounts.id.renderButton(
                    document.getElementById('googleButtonHiddenRegister'),
                    { theme: 'filled_black', size: 'large' }
                );
                console.log('Google Sign-In initialized successfully');
            } else {
                googleInitError = 'Script loaded but accounts.id not available';
            }
        } catch (e) {
            googleInitError = 'Error: ' + e.message;
            console.error('Failed to initialize Google Sign-In:', e);
        }
    }

    function loadGoogleScript() {
        return new Promise((resolve, reject) => {
            if (window.google?.accounts?.id) {
                googleScriptLoaded = true;
                resolve();
                return;
            }

            const script = document.createElement('script');
            script.src = 'https://accounts.google.com/gsi/client';
            script.async = true;
            script.defer = true;
            script.onload = () => {
                googleScriptLoaded = true;
                console.log('Google script loaded');
                resolve();
            };
            script.onerror = () => {
                googleInitError = 'Failed to load Google script (network?)';
                console.error('Failed to load Google script');
                reject(new Error('Failed to load Google script'));
            };
            document.head.appendChild(script);

            setTimeout(() => {
                if (!googleScriptLoaded) {
                    googleInitError = 'Script load timeout (15s)';
                    reject(new Error('Google script load timeout'));
                }
            }, 15000);
        });
    }

    function getGoogleErrorDetailsRegister() {
        if (window.google?.accounts?.id) return 'Google SDK ready. Click again.';
        if (googleInitError) return googleInitError;
        if (!googleClientId) return 'Fetching Client ID from server...';
        if (!googleScriptLoaded) return 'Loading Google script...';
        return 'Unknown error. Check console.';
    }

    async function handleGoogleCredentialRegister(response) {
        const errEl = document.getElementById('regError');
        errEl.style.display = 'none';

        try {
            if (!response.credential) {
                throw new Error('No credential received from Google');
            }

            const res = await fetch('/Areas/Mobile/Api/Auth/google', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idToken: response.credential })
            });

            const data = await res.json();

            if (!res.ok) {
                throw new Error(data.message || 'Google sign-up failed.');
            }

            if (data.token) {
                document.cookie = 'MobileAuthToken=' + encodeURIComponent(data.token) +
                    ';path=/;max-age=2592000;SameSite=Lax';
            }
            window.location.href = '/Mobile/Home';
        } catch (e) {
            showErr(errEl, e.message);
        }
    }

    document.addEventListener('DOMContentLoaded', initGoogleSignInRegister);
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}