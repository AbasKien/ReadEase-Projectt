@model List<ReadEase.ViewModels.Author.ManageBookItem>
@{
    ViewData["Title"] = "Archived Books";
    Layout = "~/Areas/Mobile/Views/Shared/_MobileLayout.cshtml";
}

<style>
    body.maui-host .re-main { padding-top: 0 !important; }

    .arch-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.35rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--re-border);
    }

    .arch-title {
        font-family: 'Nunito', sans-serif;
        font-size: 1.4rem;
        font-weight: 900;
        color: var(--re-text);
    }

    .arch-subtitle {
        font-size: .75rem;
        color: var(--re-muted);
        font-weight: 600;
        margin-top: .25rem;
    }

    .arch-back {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        color: var(--re-muted);
        font-size: .75rem;
        font-weight: 800;
        padding: .45rem .9rem;
        border-radius: 99px;
        text-decoration: none !important;
        transition: all .15s;
    }

    .arch-back:hover {
        border-color: var(--re-orange);
        color: var(--re-orange);
    }

    .arch-count {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: rgba(156,163,175,.12);
        color: var(--re-muted);
        font-size: .7rem;
        font-weight: 800;
        padding: .35rem .85rem;
        border-radius: 99px;
        margin-bottom: 1rem;
    }

    .arch-card {
        background: var(--re-surface);
        border: 1px solid var(--re-border);
        border-radius: 16px;
        padding: .9rem;
        margin-bottom: .7rem;
        transition: border-color .15s;
    }

    .arch-card:hover {
        border-color: rgba(200,134,10,.25);
    }

    .arch-card-top {
        display: flex;
        gap: .85rem;
        margin-bottom: .85rem;
    }

    .arch-cover {
        width: 56px;
        aspect-ratio: 2/3;
        border-radius: 10px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0,0,0,.4);
    }

    .arch-cover-ph {
        width: 56px;
        aspect-ratio: 2/3;
        border-radius: 10px;
        background: linear-gradient(135deg, #6b7280, #9ca3af);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .arch-info {
        flex: 1;
        min-width: 0;
    }

    .arch-book-title {
        font-size: .92rem;
        font-weight: 800;
        color: var(--re-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: .2rem;
    }

    .arch-category {
        font-size: .68rem;
        color: var(--re-muted);
        font-weight: 600;
        margin-bottom: .4rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .arch-badges {
        display: flex;
        gap: .3rem;
        flex-wrap: wrap;
    }

    .arch-pill {
        font-size: .58rem;
        font-weight: 900;
        padding: .15rem .5rem;
        border-radius: 6px;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .arch-pill-archived {
        background: rgba(156,163,175,.12);
        color: #9ca3af;
    }

    .arch-pill-free {
        background: rgba(34,197,94,.12);
        color: #4ade80;
    }

    .arch-pill-pro {
        background: rgba(200,134,10,.12);
        color: var(--re-orange);
    }

    .arch-actions {
        display: flex;
        gap: .45rem;
    }

    .arch-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        padding: .58rem .5rem;
        border-radius: 10px;
        font-size: .75rem;
        font-weight: 800;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none !important;
        border: 1.5px solid var(--re-border);
        background: var(--re-surface-2);
        color: var(--re-text) !important;
        font-family: 'Nunito', sans-serif;
    }

    .arch-btn:hover {
        background: var(--re-surface);
        border-color: var(--re-orange);
    }

    .arch-btn.primary {
        background: linear-gradient(135deg, rgba(34,197,94,.15), rgba(34,197,94,.08));
        border-color: rgba(34,197,94,.3);
        color: #22c55e !important;
    }

    .arch-btn.primary:hover {
        background: linear-gradient(135deg, rgba(34,197,94,.25), rgba(34,197,94,.12));
    }

    .arch-btn.danger {
        background: rgba(239,68,68,.08);
        border-color: rgba(239,68,68,.2);
        color: #ef4444 !important;
    }

    .arch-btn.danger:hover {
        background: rgba(239,68,68,.15);
        border-color: rgba(239,68,68,.3);
    }

    .arch-empty {
        text-align: center;
        padding: 3rem 1rem;
    }

    .arch-empty-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
    }

    .arch-toast {
        position: fixed;
        bottom: 80px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: rgba(30,40,50,.97);
        border: 1px solid var(--re-border);
        border-radius: 99px;
        padding: .6rem 1.2rem;
        font-size: .82rem;
        font-weight: 700;
        color: var(--re-text);
        white-space: nowrap;
        opacity: 0;
        transition: all .25s;
        z-index: 500;
        pointer-events: none;
    }

    .arch-toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
</style>

<!-- Header -->
<div class="arch-header">
    <div>
        <div class="arch-title">Archived Books</div>
        <div class="arch-subtitle">Restore or permanently delete</div>
    </div>
    <a class="arch-back" href="/Mobile/Write">← My Books</a>
</div>

@if (Model.Any())
{
    <div class="arch-count">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        @Model.Count archived book@(Model.Count != 1 ? "s" : "")
    </div>
}

@if (!Model.Any())
{
    <div class="arch-empty">
        <div class="arch-empty-icon">📦</div>
        <div style="font-size:.95rem;font-weight:800;color:var(--re-text);margin-bottom:.35rem;">No archived books</div>
        <div style="font-size:.78rem;color:var(--re-muted);font-weight:600;margin-bottom:1.25rem;">Deleted books will appear here</div>
        <a class="arch-btn primary" href="/Mobile/Write" style="display:inline-flex;width:auto;padding:.65rem 1.25rem;">Go to My Books</a>
    </div>
}
else
{
    @foreach (var b in Model)
    {
        <div class="arch-card" id="arch-card-@b.Id">
            <div class="arch-card-top">
                @if (!string.IsNullOrEmpty(b.CoverImage))
                {
                    <img class="arch-cover" src="@b.CoverImage" alt="@b.Title" loading="lazy" />
                }
                else
                {
                    <div class="arch-cover-ph">📖</div>
                }
                <div class="arch-info">
                    <div class="arch-book-title">@b.Title</div>
                    <div class="arch-category">@b.Category · @b.ChapterNumber chapters</div>
                    <div class="arch-badges">
                        <span class="arch-pill arch-pill-archived">📦 Archived</span>
                        <span class="arch-pill @(b.IsFree ? "arch-pill-free" : "arch-pill-pro")">@(b.IsFree ? "Free" : "Pro")</span>
                    </div>
                </div>
            </div>
            <div class="arch-actions">
                <button class="arch-btn primary" onclick="restoreBook('@b.Id')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    Restore
                </button>
                <button class="arch-btn danger" onclick="confirmDelete('@b.Id', '@Html.Raw(b.Title.Replace("'", "\\'"))')">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" style="color:currentColor;flex-shrink:0;vertical-align:middle;"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    Delete
                </button>
            </div>
        </div>
    }
}

<!-- Toast -->
<div class="arch-toast" id="archToast"></div>

@section Scripts {
    <script>
        function archToast(msg) {
            const el = document.getElementById('archToast');
            el.textContent = msg;
            el.classList.add('show');
            setTimeout(() => el.classList.remove('show'), 2800);
        }

        async function restoreBook(bookId) {
            try {
                const res = await mobileApi('/Areas/Mobile/api/Books/restore/' + bookId, { method: 'POST' });
                if (!res.ok) throw new Error((await res.json()).message || 'Failed');
                document.getElementById('arch-card-' + bookId)?.remove();
                archToast('Book restored!');
                // If no more books, show empty state after delay
                setTimeout(() => {
                    const remaining = document.querySelectorAll('.arch-card');
                    if (remaining.length === 0) location.reload();
                }, 500);
            } catch(e) { archToast('Error: ' + e.message); }
        }

        function confirmDelete(bookId, title) {
            if (!confirm('Permanently delete "' + title + '"? This cannot be undone.')) return;
            deleteBook(bookId);
        }

        async function deleteBook(bookId) {
            try {
                const res = await mobileApi('/Areas/Mobile/api/Books/' + bookId, { method: 'DELETE' });
                if (!res.ok) throw new Error((await res.json()).message || 'Failed');
                document.getElementById('arch-card-' + bookId)?.remove();
                archToast('Book deleted permanently');
                // If no more books, show empty state after delay
                setTimeout(() => {
                    const remaining = document.querySelectorAll('.arch-card');
                    if (remaining.length === 0) location.reload();
                }, 500);
            } catch(e) { archToast('Error: ' + e.message); }
        }
    </script>
}
