@{
    ViewData["Title"] = "Forgot Password";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Nunito:wght@400;600;700;800;900&display=swap');

    :root {
        --re-orange: #C8860A;
        --re-orange-dark: #9E6808;
    }

    body {
        background: #FAF6EF;
        font-family: 'Nunito', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

    .fp-wrap {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: max(2rem, env(safe-area-inset-top, 2rem)) 1.35rem max(2rem, env(safe-area-inset-bottom, 2rem));
        position: relative;
        overflow: hidden;
        -webkit-overflow-scrolling: touch;
        overflow-y: auto;
    }

        .fp-wrap::before {
            content: '';
            position: fixed;
            top: -20%;
            left: 50%;
            transform: translateX(-50%);
            width: 340px;
            height: 340px;
            background: radial-gradient(circle, rgba(200,134,10,.12) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

        .fp-wrap::after {
            content: '';
            position: fixed;
            bottom: -10%;
            right: -10%;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(200,134,10,.06) 0%, transparent 65%);
            pointer-events: none;
            z-index: 0;
        }

    .fp-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
        text-decoration: none !important;
        margin-bottom: 2.25rem;
        position: relative;
        z-index: 1;
    }

    .fp-logo-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: transparent;
        border: 2px dashed #C8860A;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        box-shadow: 0 4px 16px rgba(200,134,10,.2);
    }

    .fp-logo-text {
        display: flex;
        align-items: baseline;
        gap: 0;
    }

    .fp-logo-read {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: #C8860A;
        letter-spacing: -.02em;
    }

    .fp-logo-ease {
        font-family: 'Playfair Display', serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: #C8860A;
        letter-spacing: -.02em;
    }

    .fp-card {
        width: 100%;
        max-width: 400px;
        background: #FFFCF7;
        border: 1px solid #E4D8C4;
        border-radius: 24px;
        padding: 2rem 1.5rem;
        box-shadow: 0 12px 40px rgba(44,26,14,.12), 0 4px 12px rgba(44,26,14,.08);
        position: relative;
        z-index: 1;
    }

    .fp-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(200,134,10,.15), rgba(200,134,10,.05));
        border: 2px solid rgba(200,134,10,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 18px rgba(200,134,10,.15);
        animation: fpPulse 3s ease-in-out infinite;
    }

    @@keyframes fpPulse {
        0%, 100% { box-shadow: 0 4px 18px rgba(200,134,10,.15); }
        50% { box-shadow: 0 4px 28px rgba(200,134,10,.3); }
    }

    .fp-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.55rem;
        font-weight: 700;
        color: #2C1A0E;
        text-align: center;
        margin-bottom: .3rem;
    }

    .fp-sub {
        font-size: .82rem;
        color: #A08060;
        font-weight: 600;
        text-align: center;
        margin-bottom: 1.75rem;
        line-height: 1.55;
    }

    .fp-err {
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.35);
        color: #dc2626;
        font-size: .82rem;
        font-weight: 700;
        padding: .7rem 1rem;
        border-radius: 12px;
        margin-bottom: 1.1rem;
        display: none;
        animation: errShake .35s ease;
    }

        .fp-err.show { display: block; }

    .fp-ok {
        background: rgba(34,197,94,.08);
        border: 1px solid rgba(34,197,94,.35);
        color: #16a34a;
        font-size: .82rem;
        font-weight: 700;
        padding: .7rem 1rem;
        border-radius: 12px;
        margin-bottom: 1.1rem;
        display: none;
    }

        .fp-ok.show { display: block; }

    @@keyframes errShake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-5px); }
        60% { transform: translateX(4px); }
    }

    .mob-field {
        margin-bottom: 1.1rem;
    }

        .mob-field label {
            display: block;
            font-size: .7rem;
            font-weight: 800;
            color: #A08060;
            margin-bottom: .4rem;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

    .mob-input {
        width: 100%;
        background: #F5EFE3;
        border: 1.5px solid #E4D8C4;
        border-radius: 12px;
        padding: .8rem 1rem;
        font-family: 'Nunito', sans-serif;
        font-size: .95rem;
        font-weight: 600;
        color: #2C1A0E;
        outline: none;
        transition: border-color .2s, box-shadow .2s, background .2s;
        -webkit-appearance: none;
    }

        .mob-input:focus {
            border-color: #C8860A;
            box-shadow: 0 0 0 3px rgba(200,134,10,.2);
            background: #FAF6EF;
        }

        .mob-input::placeholder {
            color: #A08060;
        }

    /* OTP Input */
    .otp-input {
        text-align: center;
        font-size: 1.5rem;
        letter-spacing: .5em;
        font-weight: 800;
        font-family: monospace;
        background: #F5EFE3 !important;
        border: 2px solid #C8860A !important;
        color: #C8860A !important;
        padding: .8rem 1rem .8rem 1.5rem !important;
    }

        .otp-input:focus {
            background: #FFFCF7 !important;
            box-shadow: 0 0 0 3px rgba(200,134,10,.2) !important;
        }

        .otp-input::placeholder {
            color: rgba(200,134,10,.4) !important;
        }

    .fp-submit {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        width: 100%;
        background: #C8860A;
        color: #fff;
        border: none;
        border-radius: 12px;
        padding: .9rem 1.35rem;
        font-family: 'Nunito', sans-serif;
        font-size: 1rem;
        font-weight: 900;
        cursor: pointer;
        transition: background .18s, box-shadow .18s, transform .15s;
        margin-top: .5rem;
        box-shadow: 0 5px 18px rgba(200,134,10,.35);
        letter-spacing: .01em;
    }

        .fp-submit:hover:not(:disabled) {
            background: #9E6808;
            box-shadow: 0 8px 24px rgba(200,134,10,.45);
            transform: translateY(-1px);
        }

        .fp-submit:active:not(:disabled) {
            transform: scale(.97);
        }

        .fp-submit:disabled {
            opacity: .7;
            cursor: not-allowed;
        }

    .fp-footer {
        text-align: center;
        font-size: .82rem;
        font-weight: 600;
        color: #A08060;
        margin-top: 1.5rem;
    }

        .fp-footer a {
            color: #C8860A !important;
            text-decoration: none !important;
            font-weight: 800;
            transition: color .15s;
        }

            .fp-footer a:hover {
                color: #9E6808 !important;
            }

    /* Success state */
    .fp-success {
        text-align: center;
        display: none;
        animation: fpFadeIn .4s ease both;
    }

        .fp-success.show { display: block; }

    @@keyframes fpFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: none; }
    }

    .fp-success-icon {
        font-size: 3.5rem;
        margin-bottom: .75rem;
        display: block;
        animation: fpBounce .5s cubic-bezier(.34,1.56,.64,1) both;
    }

    @@keyframes fpBounce {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .fp-success-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: #2C1A0E;
        margin-bottom: .5rem;
    }

    .fp-success-sub {
        font-size: .85rem;
        color: #A08060;
        font-weight: 600;
        line-height: 1.55;
    }

    /* Password strength */
    .strength-bar-wrap {
        display: flex;
        gap: .3rem;
        margin-top: .5rem;
    }

    .strength-seg {
        flex: 1;
        height: 4px;
        border-radius: 4px;
        background: #E4D8C4;
        transition: background .3s;
    }

    .strength-label {
        font-size: .72rem;
        font-weight: 700;
        margin-top: .3rem;
        color: #A08060;
    }

    #pwMatchMsg {
        font-size: .78rem;
        font-weight: 700;
        margin-top: .35rem;
    }

    .step { display: none; }
    .step.active { display: block; animation: fpFadeIn .3s ease; }
</style>

<div class="fp-wrap">
    <a href="/Mobile/Login" class="fp-logo">
        <div class="fp-logo-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="32" height="32" style="color:#C8860A;flex-shrink:0;vertical-align:middle;">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
        </div>
        <div class="fp-logo-text">
            <span class="fp-logo-read">Read</span><span class="fp-logo-ease">Ease</span>
        </div>
    </a>

    <div class="fp-card">
        <!-- Step 1: Email -->
        <div class="step active" id="step1">
            <div class="fp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" style="color:#C8860A;flex-shrink:0;vertical-align:middle;">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                    <polyline points="22,6 12,13 2,6"/>
                </svg>
            </div>
            <div class="fp-title">Forgot Password?</div>
            <div class="fp-sub">Enter your email and we'll send you<br>a 6-digit reset code.</div>

            <div class="fp-err" id="fpErr1"></div>

            <div class="mob-field">
                <label>Email</label>
                <input type="email" id="fpEmail" class="mob-input"
                       placeholder="your@email.com" autocomplete="email" />
            </div>

            <button class="fp-submit" id="fpBtn1" onclick="sendOtp()">Send Reset Code</button>
        </div>

        <!-- Step 2: OTP + New Password -->
        <div class="step" id="step2">
            <div class="fp-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="28" height="28" style="color:#C8860A;flex-shrink:0;vertical-align:middle;">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <div class="fp-title">Reset Password</div>
            <div class="fp-sub">Enter the 6-digit code from your email<br>and set your new password.</div>

            <div class="fp-err" id="fpErr2"></div>

            <div class="mob-field">
                <label>6-Digit Code</label>
                <input type="text" id="fpOtp" class="mob-input otp-input" maxlength="6"
                       placeholder="000000" autocomplete="one-time-code" inputmode="numeric" />
            </div>

            <div class="mob-field">
                <label>New Password</label>
                <input type="password" id="fpNewPass" class="mob-input"
                       placeholder="Min 6 characters" autocomplete="new-password" />
                <div class="strength-bar-wrap" id="strengthBar">
                    <div class="strength-seg" id="seg1"></div>
                    <div class="strength-seg" id="seg2"></div>
                    <div class="strength-seg" id="seg3"></div>
                    <div class="strength-seg" id="seg4"></div>
                </div>
                <div class="strength-label" id="strengthLabel"></div>
            </div>

            <div class="mob-field" style="margin-bottom:.25rem;">
                <label>Confirm Password</label>
                <input type="password" id="fpConfirmPass" class="mob-input"
                       placeholder="Repeat your password" autocomplete="new-password" />
            </div>
            <div id="pwMatchMsg"></div>

            <button class="fp-submit" id="fpBtn2" onclick="resetPassword()">Reset Password</button>

            <div class="fp-footer" style="margin-top: 1rem;">
                <a href="javascript:void(0)" onclick="backToStep1()">← Back to Email</a>
            </div>
        </div>

        <!-- Success state -->
        <div class="fp-success" id="successState">
            <span class="fp-success-icon"></span>
            <div class="fp-success-title">Password Reset!</div>
            <p class="fp-success-sub">
                Your password has been updated successfully.<br>
                You can now log in with your new password.
            </p>
            <a href="/Mobile/Login" class="fp-submit" style="text-decoration: none; margin-top: 1rem;">Go to Login</a>
        </div>

        <div class="fp-footer" id="footerLinks">
            <a href="/Mobile/Login">← Back to Login</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let resetEmail = '';

        const fpNewPass = document.getElementById('fpNewPass');
        const fpConfirmPass = document.getElementById('fpConfirmPass');
        const matchMsg = document.getElementById('pwMatchMsg');
        const segs = [document.getElementById('seg1'), document.getElementById('seg2'),
                      document.getElementById('seg3'), document.getElementById('seg4')];
        const lbl = document.getElementById('strengthLabel');
        const colors = ['#ef4444','#f97316','#eab308','#22c55e'];
        const labels = ['Weak','Fair','Good','Strong'];

        function getStrength(v) {
            let s = 0;
            if (v.length >= 6)  s++;
            if (v.length >= 10) s++;
            if (/[A-Z]/.test(v) && /[0-9]/.test(v)) s++;
            if (/[^A-Za-z0-9]/.test(v)) s++;
            return s;
        }

        fpNewPass.addEventListener('input', function () {
            const v = this.value;
            if (!v) { segs.forEach(s => s.style.background = ''); lbl.textContent = ''; return; }
            const strength = getStrength(v);
            segs.forEach((s, i) => {
                s.style.background = i < strength ? colors[strength - 1] : '#E4D8C4';
            });
            lbl.textContent = labels[strength - 1] || '';
            lbl.style.color = strength > 0 ? colors[strength - 1] : '#A08060';
            checkMatch();
        });

        function checkMatch() {
            if (!fpConfirmPass.value) { matchMsg.textContent = ''; fpConfirmPass.style.borderColor = ''; return; }
            const ok = fpNewPass.value === fpConfirmPass.value;
            matchMsg.style.color      = ok ? '#16a34a' : '#dc2626';
            matchMsg.textContent      = ok ? 'Passwords match' : 'Error: Passwords do not match';
            fpConfirmPass.style.borderColor  = ok ? 'rgba(34,197,94,.5)' : 'rgba(239,68,68,.5)';
        }

        fpConfirmPass.addEventListener('input', checkMatch);

        async function sendOtp() {
            const email = document.getElementById('fpEmail').value.trim();
            const btn   = document.getElementById('fpBtn1');
            const errEl = document.getElementById('fpErr1');

            errEl.classList.remove('show');

            if (!email) {
                errEl.textContent = 'Please enter your email address.';
                errEl.classList.add('show');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spin-sm"></span> Sending…';

            try {
                const res = await fetch('/Areas/Mobile/api/Auth/forgot-password-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const data = await res.json();

                if (!res.ok) {
                    errEl.textContent = data.message || 'Something went wrong. Please try again.';
                    errEl.classList.add('show');
                    btn.disabled = false;
                    btn.textContent = 'Send Reset Code';
                    return;
                }

                resetEmail = email;
                document.getElementById('step1').classList.remove('active');
                document.getElementById('step2').classList.add('active');
            } catch (e) {
                errEl.textContent = 'Network error. Please check your connection and try again.';
                errEl.classList.add('show');
                btn.disabled = false;
                btn.textContent = 'Send Reset Code';
            }
        }

        async function resetPassword() {
            const otp = document.getElementById('fpOtp').value.trim();
            const newPass = fpNewPass.value;
            const confirmPass = fpConfirmPass.value;
            const btn   = document.getElementById('fpBtn2');
            const errEl = document.getElementById('fpErr2');

            errEl.classList.remove('show');

            if (!otp || otp.length !== 6) {
                errEl.textContent = 'Please enter the 6-digit code.';
                errEl.classList.add('show');
                return;
            }

            if (!newPass || newPass.length < 6) {
                errEl.textContent = 'Password must be at least 6 characters.';
                errEl.classList.add('show');
                return;
            }

            if (newPass !== confirmPass) {
                errEl.textContent = 'Passwords do not match.';
                errEl.classList.add('show');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spin-sm"></span> Resetting…';

            try {
                const res = await fetch('/Areas/Mobile/api/Auth/reset-password-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: resetEmail, otp, newPassword: newPass })
                });

                const data = await res.json();

                if (!res.ok) {
                    errEl.textContent = data.message || 'Invalid or expired code.';
                    errEl.classList.add('show');
                    btn.disabled = false;
                    btn.textContent = 'Reset Password';
                    return;
                }

                // Show success
                document.getElementById('step2').classList.remove('active');
                document.getElementById('successState').classList.add('show');
                document.getElementById('footerLinks').style.display = 'none';
            } catch (e) {
                errEl.textContent = 'Network error. Please check your connection and try again.';
                errEl.classList.add('show');
                btn.disabled = false;
                btn.textContent = 'Reset Password';
            }
        }

        function backToStep1() {
            document.getElementById('step2').classList.remove('active');
            document.getElementById('step1').classList.add('active');
            document.getElementById('fpBtn1').disabled = false;
            document.getElementById('fpBtn1').textContent = 'Send Reset Code';
        }

        document.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                if (document.getElementById('step1').classList.contains('active')) sendOtp();
                else if (document.getElementById('step2').classList.contains('active')) resetPassword();
            }
        });
    </script>
}
