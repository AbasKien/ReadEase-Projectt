    .rv-comment-bubble { background: rgba(255,255,255,0.05); border-radius: 10px; padding: 0.4rem 0.6rem; font-size: 0.75rem; }
    .rv-comment-user { font-weight: 800; font-size: 0.72rem; color: var(--re-text, #e8e6f0); margin-bottom: 0.1rem; }
    .rv-comment-text { color: var(--re-text-muted, #9994a8); line-height: 1.4; }
    .rv-replying-pill { display: inline-block; background: rgba(242,101,34,0.15); color: #f26522; font-size: 0.62rem; font-weight: 700; border-radius: 8px; padding: 0.05rem 0.35rem; margin-bottom: 0.15rem; }
    .rv-comment-actions { display: flex; gap: 0.75rem; margin-top: 0.25rem; padding-left: 0.2rem; }
    .rv-comment-act { background: none; border: none; color: var(--re-text-muted, #9994a8); font-size: 0.68rem; font-weight: 700; cursor: pointer; padding: 0; }
    .rv-comment-act.liked { color: #ef4444; }
    .rv-comment-time { font-size: 0.62rem; color: var(--re-text-muted, #9994a8); margin-top: 0.2rem; }
    .rv-nested-replies { margin-left: 1.5rem; margin-top: 0.4rem; }
    .rv-comment-input-wrap { display: none; margin-top: 0.4rem; gap: 0.4rem; align-items: flex-start; }
    .rv-comment-input-wrap.open { display: flex; }
    .rv-comment-input { flex: 1; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 0.4rem 0.6rem; color: var(--re-text, #e8e6f0); font-size: 0.75rem; resize: none; min-height: 36px; font-family: inherit; }
    .rv-comment-send { background: #f26522; border: none; border-radius: 8px; color: var(--re-text); font-size: 0.75rem; font-weight: 700; padding: 0.35rem 0.7rem; cursor: pointer; white-space: nowrap; }
    .rv-author-reply-card { margin-top: 0.5rem; margin-left: 0.5rem; background: rgba(242,101,34,0.08); border-left: 3px solid #f26522; border-radius: 8px; padding: 0.5rem 0.65rem; font-size: 0.75rem; }
    .rv-author-reply-header { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.25rem; }
    .rv-author-badge { font-size: 0.6rem; font-weight: 800; background: #f26522; color: var(--re-text); border-radius: 6px; padding: 0.05rem 0.35rem; }
    .rv-author-reply-text { color: var(--re-text-muted, #9994a8); line-height: 1.4; }
    .rv-show-comments-btn { background: none; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: var(--re-text-muted, #9994a8); font-size: 0.72rem; font-weight: 700; padding: 0.3rem 0.7rem; cursor: pointer; margin-top: 0.4rem; }
    .rv-add-comment-btn { background: none; border: none; color: #f26522; font-size: 0.72rem; font-weight: 700; cursor: pointer; padding: 0; }
</style>

@section Scripts {
    <script>
        window.detailBookId = '@Model.Id';
        window.detailIsBookAuthor = @(Model.IsBookAuthor ? "true" : "false");

        // Call MAUI native code via the JS bridge (window.MauiBridge injected by CustomWebViewHandler).
        // This replaces the old hidden-iframe trick which silently fails on modern Android
        // because ShouldOverrideUrlLoading is NOT fired for custom-scheme iframes.
        function callMaui(scheme, retries = 10) {
            if (window.MauiBridge && typeof window.MauiBridge.postMessage === 'function') {
                // Reliable path: AndroidJavascriptInterface bridge
                window.MauiBridge.postMessage(scheme);
            } else if (retries > 0) {
                // Android: MauiBridge not ready yet, wait and retry
                console.log('[callMaui] MauiBridge not ready, retrying... (' + retries + ' left)');
                setTimeout(function() { callMaui(scheme, retries - 1); }, 100);
            } else {
                // Final fallback: try window.location (works on iOS WebKit, may fail on Android)
                console.warn('[callMaui] MauiBridge not available after retries, falling back to window.location');
                window.location.href = scheme;
            }
        }

        // Detect if running inside MAUI WebView
        function isMauiWebView() {
            // Most reliable: MAUI injects this after page load
            if (window.isMauiApp === true) return true;
            var ua = navigator.userAgent || '';
            // Check for Android WebView patterns (MAUI uses Android WebView)
            var isAndroidWv = /wv/.test(ua) ||
                (/Android/.test(ua) && !/Chrome\/[.\d]+/.test(ua)) ||
                (/Android/.test(ua) && /Version\//.test(ua));
            // Check for MAUI-injected cookie (set by WebViewHostPage)
            var hasMauiCookie = document.cookie.indexOf('MobileAuth=') !== -1;
            // Check for iOS WebView
            var isIosWv = !!window.webkit?.messageHandlers;
            return isAndroidWv || hasMauiCookie || isIosWv;
        }

        // Download book states
        const DOWNLOAD_ICONS = {
            default: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
            loading: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" style="animation: spin 1s linear infinite;"><circle cx="12" cy="12" r="10"/></svg>`,
            success: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M8 11l3 3 5-5"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
            error: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`
        };

        // Download book for offline reading
        // - MAUI WebView: callMaui() iframe triggers ShouldOverrideUrlLoading → Chrome redirect
        // - Web browser fallback: navigate to download endpoint directly
        function downloadBook(bookId) {
            const btn = document.getElementById('downloadBtn');
            if (!btn) return;
            
            // Check if already downloaded
            if (btn.classList.contains('downloaded')) {
                // Already downloaded - go to downloads page
                if (isMauiWebView()) {
                    window.location.href = '/Mobile/Downloads';
                } else {
                    window.location.href = '/Mobile/Downloads';
                }
                return;
            }

            btn.disabled = true;
            btn.innerHTML = DOWNLOAD_ICONS.loading;
            btn.style.background = 'rgba(168,85,247,.2)';
            
            // Save metadata immediately for Downloads page
            saveBookMetadata(bookId);
            
            if (isMauiWebView()) {
                callMaui('readease://download/book?id=' + encodeURIComponent(bookId));
                // MAUI will call setDownloadSuccess() via JS injection when complete
            } else {
                window.location.href = '/Mobile/DownloadBook/' + encodeURIComponent(bookId);
                // For web, show success after short delay
                setTimeout(() => setDownloadSuccess(), 1500);
            }
        }

        // Called by MAUI when download succeeds
        window.setDownloadSuccess = function() {
            const btn = document.getElementById('downloadBtn');
            if (!btn) return;
            btn.innerHTML = DOWNLOAD_ICONS.success;
            btn.style.background = 'rgba(34,197,94,.15)';
            btn.style.borderColor = 'rgba(34,197,94,.3)';
            btn.classList.add('downloaded');
            btn.disabled = false;
            btn.title = 'Downloaded! Click to view downloads';
            
            // Show toast
            if (window.showToast) {
                window.showToast('Downloaded successfully!');
            }
        };

        // Called by MAUI if download fails
        window.setDownloadError = function() {
            const btn = document.getElementById('downloadBtn');
            if (!btn) return;
            btn.innerHTML = DOWNLOAD_ICONS.default;
            btn.style.background = 'rgba(168,85,247,.12)';
            btn.style.borderColor = 'rgba(168,85,247,.25)';
            btn.disabled = false;
        };

        // Check on page load if this book is already downloaded
        function checkIfDownloaded() {
            try {
                const bookId = '@Model.Id';
                const downloads = JSON.parse(localStorage.getItem('downloadedBooks') || '[]');
                const isDownloaded = downloads.some(d => d.book.id === bookId);
                if (isDownloaded) {
                    const btn = document.getElementById('downloadBtn');
                    if (btn) {
                        btn.innerHTML = DOWNLOAD_ICONS.success;
                        btn.style.background = 'rgba(34,197,94,.15)';
                        btn.style.borderColor = 'rgba(34,197,94,.3)';
                        btn.classList.add('downloaded');
                        btn.title = 'Already downloaded! Click to view downloads';
                    }
                }
            } catch (e) {
                console.warn('Failed to check download status:', e);
            }
        }

        // Save book metadata to localStorage for the Downloads page listing
        function saveBookMetadata(bookId) {
            try {
                const titleEl = document.querySelector('.det-title');
                const authorEl = document.querySelector('.det-author span');
                const coverImg = document.querySelector('.det-thumb');

                const meta = {
                    book: {
                        id: bookId,
                        title: titleEl ? titleEl.textContent.trim() : 'Unknown',
                        author: authorEl ? authorEl.textContent.trim() : 'Unknown',
                        coverImage: coverImg ? coverImg.src : null
                    },
                    downloadedAt: new Date().toISOString()
                };

                const downloads = JSON.parse(localStorage.getItem('downloadedBooks') || '[]');
                const existingIndex = downloads.findIndex(b => b.book.id === bookId);
                if (existingIndex >= 0) {
                    downloads[existingIndex] = meta;
                } else {
                    downloads.push(meta);
                }
                localStorage.setItem('downloadedBooks', JSON.stringify(downloads));
            } catch (e) {
                console.warn('Failed to save book metadata:', e);
            }
        }

        // Download single chapter
        // - MAUI WebView: callMaui() iframe triggers ShouldOverrideUrlLoading → Chrome redirect
        // - Web browser fallback: navigate to download endpoint directly
        function downloadChapter(chapterId, bookId, btn) {
            if (!btn) btn = document.activeElement;
            btn.disabled = true;
            if (isMauiWebView()) {
                callMaui('readease://download/chapter?chapterId=' + encodeURIComponent(chapterId) + '&bookId=' + encodeURIComponent(bookId));
            } else {
                window.location.href = '/Mobile/DownloadChapter?chapterId=' + encodeURIComponent(chapterId) + '&bookId=' + encodeURIComponent(bookId);
            }
        }

