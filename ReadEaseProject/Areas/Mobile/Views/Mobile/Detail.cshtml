        @@media screen and (max-width:600px){html{font-size:16px}body{padding:1.5rem 1rem 5rem}.re-cover{padding:2rem 1.25rem 1.5rem;border-radius:14px;margin-bottom:2rem}.re-chapter{margin-bottom:3rem;padding-bottom:2rem}.re-chapter h2{font-size:1.35rem;margin-bottom:1.25rem}.re-body{line-height:1.85}.re-body p{text-indent:1.5em}}
        @@media (prefers-color-scheme:dark){body{background:#0f1922;color:rgba(255,255,255,.88)}.re-cover{background:linear-gradient(160deg,#0b1219 0%,#0f1922 55%,#141e28 100%)}.re-chapter{border-bottom-color:rgba(255,255,255,.06)}.re-chapter h2{color:#fff}.re-body{color:rgba(255,255,255,.82)}.re-divider::before,.re-divider::after{background:rgba(255,255,255,.15)}.re-footer{border-top-color:rgba(255,255,255,.06);color:rgba(255,255,255,.35)}}
