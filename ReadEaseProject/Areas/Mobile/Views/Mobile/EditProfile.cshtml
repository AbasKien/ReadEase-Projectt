@model ReadEase.Areas.Mobile.ViewModels.MobileEditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Areas/Mobile/Views/Shared/_MobileLayout.cshtml";
}

<style>

    .ep-avatar-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        margin-bottom: 1.5rem;
    }
    .ep-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--re-orange), #d97706);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--re-text);
        overflow: hidden;
        border: 3px solid var(--re-surface-2);
        box-shadow: 0 4px 15px rgba(0,0,0,.2);
    }
    .ep-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .ep-avatar-btn {
        padding: .5rem 1rem;
        background: var(--re-surface-2);
        border: 1px solid var(--re-border);
        border-radius: 20px;
        color: var(--re-text);
        font-size: .75rem;
        font-weight: 700;
        cursor: pointer;
    }
    .ep-avatar-btn input {
        display: none;
    }

    .ep-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .ep-field {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }
    .ep-label {
        font-size: .75rem;
        font-weight: 700;
        color: var(--re-muted);
        text-transform: uppercase;
        letter-spacing: .05em;
    }
    .ep-input {
        padding: .9rem 1rem;
        background: var(--re-surface-2);
        border: 1px solid var(--re-border);
        border-radius: 12px;
        color: var(--re-text);
        font-size: .9rem;
        font-family: inherit;
    }
    .ep-input:focus {
        outline: none;
        border-color: var(--re-orange);
    }
    .ep-input:disabled {
        opacity: .6;
        cursor: not-allowed;
    }
    .ep-hint {
        font-size: .7rem;
        color: var(--re-muted);
    }

    .ep-divider {
        height: 1px;
        background: var(--re-border);
        margin: .5rem 0;
    }

    .ep-section-title {
        font-size: .85rem;
        font-weight: 800;
        color: var(--re-text);
        margin-bottom: .5rem;
    }

    .ep-btn {
        padding: 1rem;
        background: var(--re-orange);
        border: none;
        border-radius: 12px;
        color: var(--re-text);
        font-size: .9rem;
        font-weight: 800;
        cursor: pointer;
        margin-top: .5rem;
    }
    .ep-btn-secondary {
        background: var(--re-surface-2);
        border: 1px solid var(--re-border);
    }

    .ep-error {
        color: #ef4444;
        font-size: .8rem;
        font-weight: 600;
    }
    .ep-success {
        color: #22a350;
        font-size: .8rem;
        font-weight: 600;
        padding: .75rem;
        background: rgba(34,163,80,.1);
        border-radius: 10px;
        margin-bottom: 1rem;
    }

    .ep-password-section {
        margin-top: 1.25rem;
        padding: 1.25rem 1rem;
        background: var(--re-surface-2);
        border: 1px solid var(--re-border);
        border-radius: 14px;
    }
    .ep-password-section .ep-section-title {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
        font-size: .85rem;
    }
    .ep-password-section .ep-section-title svg {
        color: var(--re-orange);
    }
    .ep-password-section .ep-field {
        margin-bottom: .75rem;
    }
    .ep-password-section .ep-field:last-of-type {
        margin-bottom: 0;
    }
    .ep-password-toggle {
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--re-muted);
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ep-field-password {
        position: relative;
    }
    .ep-field-password .ep-input {
        padding-right: 2.5rem;
    }
    .ep-error-banner {
        color: #ef4444;
        font-size: .8rem;
        font-weight: 600;
        padding: .75rem;
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.15);
        border-radius: 10px;
        margin-bottom: 1rem;
    }
</style>

<div class="mob-page-header">
    <a href="/Mobile/Profile" class="mob-back-btn">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
    <div class="mob-page-title">Edit Profile</div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="ep-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="ep-error-banner">@TempData["ErrorMessage"]</div>
}

<form class="ep-form" asp-action="EditProfile" asp-controller="Mobile" asp-area="Mobile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="ep-avatar-wrap">
        <div class="ep-avatar" id="avatarPreview">
            @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
            {
                <img src="@Model.ProfilePhoto" alt="Profile" id="avatarImg" />
            }
            else
            {
                <span id="avatarInitial">@(Model.Name?.FirstOrDefault() ?? 'U')</span>
            }
        </div>
        <label class="ep-avatar-btn">
            <input type="file" id="photoInput" name="ProfilePhotoFile" accept="image/*" onchange="previewPhoto(this)" />
            Change Photo
        </label>
    </div>
    <div asp-validation-summary="ModelOnly" class="ep-error"></div>

    <div class="ep-field">
        <label class="ep-label">Display Name</label>
        <input type="text" class="ep-input" asp-for="Name" placeholder="Your name" />
        <span asp-validation-for="Name" class="ep-error"></span>
    </div>

    <div class="ep-field">
        <label class="ep-label">Email</label>
        <input type="email" class="ep-input" asp-for="Email" disabled />
        <div class="ep-hint">
            @if (Model.IsEmailConfirmed)
            {
                <span style="color: #22a350;">✓ Verified</span>
            }
            else
            {
                <span>Not verified</span>
            }
        </div>
    </div>

    <div class="ep-password-section">
        <div class="ep-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            Change Password
        </div>
        <div class="ep-hint" style="margin-bottom:.75rem;">Leave blank if you don't want to change your password.</div>

        <div class="ep-field ep-field-password">
            <label class="ep-label">Current Password</label>
            <input type="password" class="ep-input" asp-for="CurrentPassword" placeholder="Enter current password" autocomplete="current-password" />
            <button type="button" class="ep-password-toggle" onclick="togglePassword('CurrentPassword', this)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>

        <div class="ep-field ep-field-password">
            <label class="ep-label">New Password</label>
            <input type="password" class="ep-input" asp-for="NewPassword" placeholder="Min 6 characters" autocomplete="new-password" />
            <button type="button" class="ep-password-toggle" onclick="togglePassword('NewPassword', this)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>

        <div class="ep-field ep-field-password">
            <label class="ep-label">Confirm New Password</label>
            <input type="password" class="ep-input" asp-for="ConfirmNewPassword" placeholder="Repeat new password" autocomplete="new-password" />
            <button type="button" class="ep-password-toggle" onclick="togglePassword('ConfirmNewPassword', this)">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmNewPassword" class="ep-error"></span>
    </div>

    <button type="submit" class="ep-btn">Save Changes</button>
    <a href="/Mobile/Profile" class="ep-btn ep-btn-secondary" style="text-align: center; text-decoration: none; display: block;">Cancel</a>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Preview selected photo before upload
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('avatarPreview');
                    const existingImg = document.getElementById('avatarImg');
                    const existingInitial = document.getElementById('avatarInitial');

                    if (existingImg) {
                        existingImg.src = e.target.result;
                    } else if (existingInitial) {
                        existingInitial.remove();
                        const img = document.createElement('img');
                        img.id = 'avatarImg';
                        img.src = e.target.result;
                        img.alt = 'Profile';
                        img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
                        preview.appendChild(img);
                    } else {
                        const img = document.createElement('img');
                        img.id = 'avatarImg';
                        img.src = e.target.result;
                        img.alt = 'Profile';
                        img.style.cssText = 'width:100%;height:100%;object-fit:cover;';
                        preview.innerHTML = '';
                        preview.appendChild(img);
                    }
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Password toggle
        function togglePassword(fieldName, btn) {
            const input = document.querySelector('[name="' + fieldName + '"]');
            if (input) {
                const type = input.type === 'password' ? 'text' : 'password';
                input.type = type;
                // Update icon
                btn.innerHTML = type === 'password'
                    ? '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>'
                    : '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
            }
        }
    </script>
}
